"""OE — Reverse Tree Visualization 0.2 — SEPARATE FILE
Colab-friendly. Does NOT modify Def 0.1.
- Saves to relative path oe-viz-0.2.png (no /mnt/data/)
- No tight_layout()
- First 3 levels only for readability. Full sample is 300 nodes.
"""
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
import networkx as nx

# --- Frozen Def 0.1 logic (read-only) ---
def nu2(x):
    k = 0
    while x % 2 == 0:
        x //= 2
        k += 1
    return k

def S(n):
    if n % 2 == 0:
        return n // (2 ** nu2(n))
    return (3 * n + 1) // (2 ** nu2(3 * n + 1))

def C(m):
    assert m % 2 == 1
    out = []
    for k in range(1, 60):
        if (m * (2 ** k)) % 3 != 1:
            continue
        n = (m * (2 ** k) - 1) // 3
        if n > 1 and n != m and n % 2 == 1:
            out.append(n)
    return out

def build_tree(max_nodes=300, max_depth=8):
    G = nx.DiGraph()
    G.add_node(1, depth=0)
    frontier = [1]
    visited = {1}
    for depth in range(max_depth):
        nxt = []
        for m in frontier:
            for n in C(m):
                if n in visited:
                    if not G.has_edge(n, m):
                        G.add_edge(n, m)
                    continue
                if len(visited) >= max_nodes:
                    break
                visited.add(n)
                G.add_node(n, depth=depth+1)
                G.add_edge(n, m)
                nxt.append(n)
        frontier = nxt
        if not frontier:
            break
    return G

G = build_tree()
print(f"Full sample: nodes={len(G.nodes())} edges={len(G.edges())}")

# --- Visualization: first 3 depths only, first few children per parent for readability ---
# Keep: 1, its first 5 children, and first 3 children of each of those
keep = {1}
for c in sorted(C(1))[:5]:
    keep.add(c)
    for cc in sorted(C(c))[:3]:
        keep.add(cc)
sub = G.subgraph(keep)

# Manual tree layout: parent centered above children
pos = {}
pos[1] = (0, 0)
children1 = sorted([n for n in keep if G.nodes[n].get("depth") == 1])
for i, c in enumerate(children1):
    pos[c] = ((i - len(children1)/2) * 4, -1.5)
    grandchildren = sorted([n for n in keep if G.has_edge(n, c)])
    for j, gc in enumerate(grandchildren):
        pos[gc] = (pos[c][0] + (j - len(grandchildren)/2) * 1.3, -3)

plt.figure(figsize=(14, 8), constrained_layout=True)
colors = ["gold" if n == 1 else "lightgreen" for n in sub.nodes()]
nx.draw(sub, pos, with_labels=True, node_size=900, node_color=colors,
        font_size=10, font_weight="bold", arrows=True, arrowsize=14, edge_color="gray")
plt.title("OE — Reverse Tree Visualization 0.2\nOdd nodes only | Edges child -> parent | Shown: first 3 levels, sample of children\nFull sample: 300 nodes, 8 levels, k<=59 | NOT the infinite tree", fontsize=11, fontweight="bold")
plt.figtext(0.5, 0.01, "The displayed leaves indicate absence of selected odd predecessors under the compressed inverse rule;\nthey do not indicate termination under the forward map.", ha="center", fontsize=9, style="italic")
plt.savefig("oe-viz-0.2-final.png", dpi=200)  # RELATIVE PATH - works in Colab
print("Saved: oe-viz-0.2.png")
print(f"Shown nodes: {sorted(sub.nodes())}")
