"""OE - Odd-only tree - FIXED
Nodes are ODD only. S(n) for odd n is always odd.
children(m) for odd m = {(m*2^k -1)/3 | odd >1}
No 2m child, no even parents.
"""
import matplotlib.pyplot as plt
import networkx as nx

def nu2(x: int) -> int:
    k = 0
    while x % 2 == 0:
        x //= 2
        k += 1
    return k

def S(n: int) -> int:
    # n is assumed odd in the odd-only tree, but keep general def
    if n % 2 == 0:
        return n // (2 ** nu2(n))
    return (3 * n + 1) // (2 ** nu2(3 * n + 1))

def children_of(m: int):
    # m MUST be odd. If m is even, it has no odd children.
    assert m % 2 == 1, "children_of only for odd m"
    out = []
    for k in range(1, 60):
        num = m * (2 ** k) - 1
        if num % 3 != 0:
            continue
        n = num // 3
        if n > 1 and n % 2 == 1 and n != m:
            out.append(n)
    return out

def build_tree(max_nodes=300, max_depth=8):
    G = nx.DiGraph()
    G.add_node(1, depth=0)
    frontier = [1]
    visited = {1}
    for depth in range(max_depth):
        nxt = []
        for m in frontier:
            for n in children_of(m):
                if n in visited:
                    if not G.has_edge(n, m):
                        G.add_edge(n, m)
                    continue
                if len(visited) >= max_nodes:
                    break
                visited.add(n)
                G.add_node(n, depth=depth+1)
                G.add_edge(n, m)
                nxt.append(n)
        frontier = nxt
        if not frontier:
            break
    return G

def verify_tree(G):
    ok = True
    for n, m in G.edges():
        if S(n) != m:
            print(f"⚠️ Inconsistent edge: {n} -> {m} , S({n})={S(n)}")
            ok = False
    if ok:
        print("✅ All edges consistent: S(n) = m")
    return ok

def path_to_1(n: int):
    path = [n]
    while n > 1:
        n = S(n)
        path.append(n)
    return path

G = build_tree()
print(f"Number of nodes: {len(G.nodes())}")
print(f"Nodes (sorted): {sorted(G.nodes())[:30]} ...")
verify_tree(G)
print()
print("children(1) =", sorted(children_of(1))[:10])
print("children(5) =", sorted(children_of(5))[:10])
print()
for x in [27, 41, 31, 47, 7, 3, 5, 13, 21]:
    print(f"S({x}) = {S(x)} | Path: {path_to_1(x)}")
