"""OE — Reverse Tree Visualization 0.1 — SEPARATE FILE
Rule: read the FROZEN Def 0.1 logic, do NOT modify it.
- Odd nodes only
- Edges child -> parent
- Root 1 highlighted
- Sample limits shown clearly
- This is NOT the infinite tree.
"""
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
import networkx as nx

# --- Frozen Def 0.1 logic copied verbatim (read-only) ---
def nu2(x):
    k = 0
    while x % 2 == 0:
        x //= 2
        k += 1
    return k

def S(n):
    if n % 2 == 0:
        return n // (2 ** nu2(n))
    return (3 * n + 1) // (2 ** nu2(3 * n + 1))

def C(m):
    assert m % 2 == 1
    out = []
    for k in range(1, 60):  # SAMPLE LIMIT: k<=59, see Audit Notes
        if (m * (2 ** k)) % 3 != 1:
            continue
        n = (m * (2 ** k) - 1) // 3
        if n > 1 and n != m and n % 2 == 1:
            out.append(n)
    return out

def build_tree(max_nodes=300, max_depth=8):
    G = nx.DiGraph()
    G.add_node(1, depth=0)
    frontier = [1]
    visited = {1}
    for depth in range(max_depth):
        nxt = []
        for m in frontier:
            for n in C(m):
                if n in visited:
                    if not G.has_edge(n, m):
                        G.add_edge(n, m)
                    continue
                if len(visited) >= max_nodes:
                    break
                visited.add(n)
                G.add_node(n, depth=depth+1)
                G.add_edge(n, m)
                nxt.append(n)
        frontier = nxt
        if not frontier:
            break
    return G

G = build_tree()
# Layout: by depth, sorted
by_depth = {}
for node, d in G.nodes(data=True):
    by_depth.setdefault(d.get("depth", 0), []).append(node)
pos = {}
for d, nodes in by_depth.items():
    nodes = sorted(nodes)
    for i, node in enumerate(nodes):
        pos[node] = (i - len(nodes)/2, -d)

plt.figure(figsize=(18, 11))
colors = ["gold" if n == 1 else "lightgreen" for n in G.nodes()]
# Draw only first 120 nodes for readability, full tree is 300 nodes
sub_nodes = sorted(G.nodes())[:120]
sub = G.subgraph(sub_nodes)
nx.draw(sub, pos, with_labels=True, node_size=550, node_color=["gold" if n==1 else "lightgreen" for n in sub.nodes()],
        font_size=7, font_weight="bold", arrows=True, arrowsize=10, edge_color="gray", alpha=0.95)
plt.title("OE — Reverse Tree Visualization 0.1\nOdd nodes only | Edges child -> parent | SAMPLE: 300 nodes, 8 levels, k<=59 | NOT the infinite tree", fontsize=12, fontweight="bold")
plt.tight_layout()
plt.savefig("/mnt/data/oe-viz-0.1.png", dpi=200)
print(f"Nodes in full sample: {len(G.nodes())} Edges: {len(G.edges())}")
print("Saved: oe-viz-0.1.png")
