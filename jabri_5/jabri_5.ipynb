# ================================================================
# Jabri_5 — v3 clean — يصلح ValueError + الرسم
# Z(x)= x^-5 ln(x) sin(2π/x) exp(-x/21) | 8 zeros
# ================================================================
import mpmath as mp
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

DPS = 80
mp.mp.dps = DPS
xp = 21.0

def Zx(t):
    x = mp.mpc('0.5', str(t))
    return mp.exp(-x/xp) * x**(-5) * mp.log(x) * mp.sin(2*mp.pi/x)

def find_brackets(step=0.005, t_start=0.001, t_end=60.0):
    mp.mp.dps = DPS - 20
    t_vals = np.arange(t_start, t_end, step)
    f_vals = [float(mp.im(Zx(t))) for t in t_vals]
    brackets = []
    for j in range(len(f_vals)-1):
        if f_vals[j]*f_vals[j+1] < 0:
            brackets.append((t_vals[j], t_vals[j+1]))
    return brackets

def refine_roots(brackets, dps=DPS):
    mp.mp.dps = dps
    roots = []
    for t_min, t_max in brackets:
        try:
            root = mp.findroot(lambda tt: mp.im(Zx(tt)), (t_min, t_max),
                               tol=mp.mpf(f'1e-{dps-15}'), maxsteps=1500)
            if abs(float(mp.im(Zx(root)))) < 1e-30:
                roots.append(float(root))
        except Exception:
            pass
    return sorted(set(roots))

# 1. الأصفار
brackets = find_brackets(step=0.005, t_end=60.0)
roots = refine_roots(brackets)
print(f"✅ Found {len(roots)} zeros:")
for i,r in enumerate(roots,1):
    print(f" R{i}: t = {r:.10f}")
print()

# 2. الثوابت (لا نحذف)
CONSTANTS = {
    'pi': np.pi, 'e': np.e, 'phi': (1+np.sqrt(5))/2,
    'alpha': 7.2973525693e-3, 'G': 6.67430e-11
}

# 3. C_calc — بدون del
rows = []
for i,g in enumerate(roots,1):
    mp.mp.dps = DPS
    h = mp.mpf('1e-15')
    t = mp.mpf(g)
    z = Zx(t)
    if abs(z) < mp.mpf('1e-100'):
        C_calc = mp.mpf('0')
    else:
        zppp = (Zx(t+2*h) - 2*Zx(t+h) + 2*Zx(t-h) - Zx(t-2*h)) / (2*h**3)
        C_calc = mp.mpf('0.5') * mp.mpf(g)**2 * mp.re(zppp / z)

    logC = mp.log10(mp.fabs(C_calc) + mp.mpf('1e-300'))
    diffs = {k: mp.fabs(logC - mp.log10(mp.fabs(mp.mpf(v)) + mp.mpf('1e-300')))
             for k,v in CONSTANTS.items()}
    matched = min(diffs, key=diffs.get)

    rows.append({
        '#': i,
        'gamma': float(g),
        'C_calc': float(C_calc),
        'matched': matched,
        'const_value': CONSTANTS[matched],
        'LogDiff': float(diffs[matched]),
        'rel_err_%': abs(float(C_calc)-CONSTANTS[matched])/CONSTANTS[matched]*100
    })

df = pd.DataFrame(rows)
print(df.to_string(index=False))
df.to_csv('Zx5_clean.csv', index=False, float_format='%.6e')
print("\n✅ CSV saved — LogDiff 17-28 = فشل صادق")

# 4. الرسم — بعد الجدول
mp.mp.dps = 30
t_full = np.linspace(0.001, 60, 12000)
f_full = [float(mp.im(Zx(t))) for t in t_full]
t_zoom = np.linspace(0.001, 2.5, 5000)
f_zoom = [float(mp.im(Zx(t))) for t in t_zoom]

fig, (ax1, ax2) = plt.subplots(1,2, figsize=(18,6))

ax1.plot(t_full, f_full, linewidth=0.7, color='royalblue')
ax1.set_yscale('symlog', linthresh=1e-25)
ax1.axhline(0,color='black',linewidth=1)
for r in roots:
    ax1.plot(r,0,'ro',markersize=6)
ax1.set_title('Full t∈[0,60] — 8 zeros', fontweight='bold')
ax1.set_xlabel('t'); ax1.set_ylabel('Im[Zx] symlog')
ax1.grid(True,alpha=0.3)

ax2.plot(t_zoom, f_zoom, linewidth=0.9, color='darkgreen')
ax2.axhline(0,color='black',linewidth=1)
ax2.axvline(1.0,color='red',linestyle='--')
for r in roots:
    if r<2.5:
        ax2.plot(r,0,'ro',markersize=8)
        ax2.text(r, max(f_zoom)*0.1, f"{r:.2f}", rotation=90, fontsize=8)
ax2.set_title('Zoom t∈(0,2.5) — first cluster (0,1)', fontweight='bold')
ax2.set_xlabel('t'); ax2.grid(True,alpha=0.3)

plt.tight_layout()
plt.savefig('Zx5_plot.png', dpi=150, bbox_inches='tight')
plt.show()
print("✅ Zx5_plot.png saved")