# ================================================================
# Jabri_5 — v5.0.0 clean — مطابق لـ jabri_5.tex
# Z(x)= x^-5 ln(x) sin(2π/x) exp(-x/21) | 8 zeros on critical line
# DOI: 10.5281/zenodo.23285748
# ================================================================
import mpmath as mp
import numpy as np
import matplotlib.pyplot as plt

DPS = 80
mp.mp.dps = DPS
xp = mp.mpf('21')

def Zx(t):
    x = mp.mpc('0.5', str(t))
    return mp.exp(-x/xp) * x**(-5) * mp.log(x) * mp.sin(2*mp.pi/x)

# البحث
def find_brackets(step=0.005, t_end=60.0):
    mp.mp.dps = DPS-20
    t_vals = np.arange(0.001, t_end, step)
    f_vals = [float(mp.im(Zx(t))) for t in t_vals]
    brackets = []
    for j in range(len(f_vals)-1):
        if f_vals[j]*f_vals[j+1] < 0:
            brackets.append((t_vals[j], t_vals[j+1]))
    return brackets

def refine_roots(brackets):
    mp.mp.dps = DPS
    roots = []
    for a,b in brackets:
        try:
            r = mp.findroot(lambda tt: mp.im(Zx(tt)), (a,b), tol=mp.mpf('1e-65'), maxsteps=1500)
            if abs(float(mp.im(Zx(r)))) < 1e-30:
                roots.append(float(r))
        except: pass
    return sorted(set([round(x,12) for x in roots]))

brackets = find_brackets()
roots = refine_roots(brackets)
print(f"Found {len(roots)} zeros:")
for i,r in enumerate(roots,1):
    print(f"R{i}: {r:.10f}")

# رسم مطابق لـ Fig.1 في tex
mp.mp.dps = 30
t_full = np.linspace(0.001,60,12000)
f_full = [float(mp.im(Zx(t))) for t in t_full]
t_zoom = np.linspace(0.001,2.5,5000)
f_zoom = [float(mp.im(Zx(t))) for t in t_zoom]

fig,(ax1,ax2)=plt.subplots(1,2,figsize=(18,6))
ax1.plot(t_full,f_full,linewidth=0.7); ax1.set_yscale('symlog',linthresh=1e-25)
ax1.axhline(0,color='k');
for r in roots: ax1.plot(r,0,'ro',ms=6)
ax1.set_title('Full t∈[0,60] — 8 zeros')
ax2.plot(t_zoom,f_zoom,linewidth=0.9,color='darkgreen'); ax2.axhline(0,color='k'); ax2.axvline(1,color='r',ls='--')
for r in roots:
    if r<2.5: ax2.plot(r,0,'ro',ms=8)
ax2.set_title('Zoom t∈(0,2.5)')
plt.savefig('jabri_5.png',dpi=150,bbox_inches='tight'); plt.show()