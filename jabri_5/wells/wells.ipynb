#   Constant Hunter — هل في هذه القيم ثوابت فيزيائية؟
#   نبحث بصدق. لا نخاف من النتيجة.
# ============================================================

!pip install mpmath --quiet 2>/dev/null

import mpmath as mp
import numpy as np
import pandas as pd

mp.mp.dps = 30
xp = mp.mpf('21')

def Z_critical(t):
    x = mp.mpc('0.5', str(t))
    return mp.exp(-x/xp) * x**(-5) * mp.log(x) * mp.sin(2*mp.pi/x)

GAMMAS = np.array([
    14.134725141734693, 21.022039638771555, 25.010857580145688,
    30.424876125859513, 32.935061587739189, 37.586178158825671,
    40.918719012147495, 43.327073280914999, 48.005150881167159,
    49.773832477672302, 52.970321477714461, 56.446247697063394,
    59.347044002602353, 60.831778524609809,
])

# ─── 1) القيم التي نبحث فيها عن ثوابت ───
Z_vals = np.array([float(abs(Z_critical(g))) for g in GAMMAS])

print("=" * 70)
print("   📌 القيم الأصلية |Z(0.5+i·γₙ)|")
print("=" * 70)
for i, v in enumerate(Z_vals, 1):
    print(f"   n={i:2d}  |Z| = {v:.6e}")

# ─── 2) الثوابت الفيزيائية والرياضية المعروفة ───
CONSTANTS = {
    'α (fine structure)':   7.2973525693e-3,
    'G (gravitational)':    6.67430e-11,
    'π (pi)':               3.14159265358979,
    'e (Euler)':            2.71828182845904,
    'φ (golden ratio)':     1.61803398874989,
    'ℏ (reduced Planck)':   1.054571817e-34,
    'c (speed of light)':   2.99792458e8,
    'mₑ (electron mass)':   9.1093837015e-31,
    'mₚ (proton mass)':     1.67262192369e-27,
    'k_B (Boltzmann)':      1.380649e-23,
    'N_A (Avogadro)':       6.02214076e23,
    'R_∞ (Rydberg)':        1.0973731568160e7,
    'μ₀ (vacuum perm)':     1.25663706212e-6,
    'ε₀ (vacuum permit)':   8.8541878128e-12,
    'Λ (cosmological)':     1.1056e-52,  # approximate
    'Λ_QCD (MeV)':          2.0e8,        # in eV approx
    'ln(2)':                np.log(2),
    'γ_E (Euler-Mascheroni)': 0.5772156649015329,
    'ζ(3) (Apéry)':         1.2020569031595943,
    'Catalan G':            0.9159655941772190,
}

# ─── 3) حاول إيجاد مطابقة ───
print("\n" + "=" * 70)
print("   🔍 بحث عن مطابقات (بخطأ < 1%)")
print("=" * 70)

matches_found = 0
for i, v in enumerate(Z_vals, 1):
    best_name = None
    best_err = float('inf')
    best_val = None
    for name, c in CONSTANTS.items():
        # خطأ نسبي
        err = abs(v - c) / max(abs(c), 1e-100)
        if err < best_err:
            best_err = err
            best_name = name
            best_val = c
    
    if best_err < 0.01:  # خطأ < 1%
        matches_found += 1
        print(f"   ✅ n={i:2d}  |Z|={v:.6e}  ≈  {best_name}={best_val:.6e}  (خطأ {best_err*100:.3f}%)")
    else:
        print(f"   ❌ n={i:2d}  |Z|={v:.6e}  ← أقرب: {best_name} (خطأ {best_err*100:.1f}%)")

print(f"\n📊 النتيجة: {matches_found}/{len(Z_vals)} مطابقة بخطأ < 1%")

# ─── 4) اختبار نسب ───
print("\n" + "=" * 70)
print("   🔍 اختبار النسب Z(n)/Z(n+1) — هل توجد ثوابت؟")
print("=" * 70)

ratios = Z_vals[:-1] / Z_vals[1:]
for i, r in enumerate(ratios, 1):
    print(f"   Z({i})/Z({i+1}) = {r:.6f}")

print("\n   متوسط النسب =", f"{ratios.mean():.6f}")

# ─── 5) اختبار: هل يمكن مطابقة أي رقم بأي ثابت؟ ───
print("\n" + "=" * 70)
print("   🎯 اختبار مرجعي: 14 رقماً عشوائياً")
print("=" * 70)

np.random.seed(123)
random_vals = np.random.uniform(1e-10, 1e-6, 14)

matches_random = 0
for v in random_vals:
    best_err = min(abs(v - c)/max(abs(c), 1e-100) for c in CONSTANTS.values())
    if best_err < 0.01:
        matches_random += 1

print(f"   مطابقات في 14 رقماً عشوائياً: {matches_random}/14")
print(f"   مطابقات في قيم Z: {matches_found}/14")
print()
if matches_random > 0:
    print("   ⚠️ ملاحظة: العشوائي أيضاً 'يطابق'!")
    print("   هذا يعني: المطابقة نفسها ليست دليلاً.")
else:
    print("   ✅ لا مطابقات في العشوائي — قيم Z مميزة")

# ─── 6) الجدول النهائي ───
print("\n" + "=" * 70)
print("   📋 الجدول النهائي")
print("=" * 70)

rows = []
for i, (g, v) in enumerate(zip(GAMMAS, Z_vals), 1):
    rows.append({
        'n': i,
        'γₙ': f'{g:.4f}',
        '|Z|': f'{v:.4e}',
        'log₁₀|Z|': f'{np.log10(v):.3f}',
        'Z(n)/Z(n+1)': f'{ratios[i-1]:.4f}' if i < len(Z_vals) else '-',
    })

df = pd.DataFrame(rows)
print(df.to_string(index=False))