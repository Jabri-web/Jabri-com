import numpy as np
import scipy.linalg as la
import matplotlib.pyplot as plt
from scipy.integrate import simpson

# 1. الدالة التحليلية g(u) والدالة المساعدة p(u)
def g_func(u):
    return (u/(2*np.pi))**5 * np.log(2*np.pi/u) * np.exp(-2*np.pi/(21*u))

def p_func(u):
    return 5/u - 1/(u*np.log(2*np.pi/u)) + 2*np.pi/(21*u**2)

# 2. إعدادات الشبكة
u_min, u_max, N = 0.001, 2 * np.pi - 0.05, 2000
u = np.linspace(u_min, u_max, N)
h = u[1] - u[0]

# 3. بناء المصفوفة L = Q^T Q مع تطبيق شرط Dirichlet
p_vals = p_func(u)
D = np.zeros((N, N))
for i in range(1, N-1):
    D[i, i-1] = -1 / (2*h)
    D[i, i+1] =  1 / (2*h)
D[0,0] = -1/h; D[0,1] = 1/h
D[-1,-2] = -1/h; D[-1,-1] = 1/h

Q = -D + np.diag(p_vals)
# تطبيق شرط Dirichlet (حذف الصفوف والأعمدة الطرفية)
L = (Q.T @ Q)[1:-1, 1:-1]

# 4. حساب القيم الذاتية والدوال الذاتية
eigvals, eigvecs = la.eigh(L)
psi0 = np.zeros(N)
psi0[1:-1] = eigvecs[:, 0]  # الحالة الأرضية

# 5. تصحيح الإشارة: نضمن أن الحالة الأرضية موجبة (كما في نظرية Sturm-Liouville)
if np.sum(psi0) < 0:
    psi0 = -psi0

# 6. التطبيع الدقيق باستخدام Simpson
norm_psi = np.sqrt(simpson(psi0**2, x=u))
psi0 = psi0 / norm_psi

g = g_func(u)
norm_g = np.sqrt(simpson(g**2, x=u))
g = g / norm_g

# 7. حساب نسبة التداخل (Overlap)
overlap = simpson(psi0 * g, x=u)

# 8. طباعة النتائج
print(f"Ground State Energy (λ_0) = {eigvals[0]:.8e}")
print(f"Overlap with analytical g(u) = {overlap:.8f}")
print(f"Positivity check: min(psi0) = {np.min(psi0):.8e}, max(psi0) = {np.max(psi0):.8e}")

# 9. الرسم البياني النهائي
plt.figure(figsize=(10, 6))
plt.plot(u, psi0, 'b-', linewidth=2, label=r'Numerical $\psi_0$ (Dirichlet)')
plt.plot(u, g, 'r--', linewidth=2, label=r'Analytical $g(u)$')
plt.title(f"Ground State Match: $\\lambda_0$ = {eigvals[0]:.2e}, Overlap = {overlap:.4f}", fontsize=14)
plt.xlabel('u')
plt.ylabel('ψ(u)')
plt.legend()
plt.grid(True)
plt.show()