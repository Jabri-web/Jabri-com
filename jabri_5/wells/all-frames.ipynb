
import sys
import numpy as np
from scipy.integrate import quad

XP = 21.0
PI2 = 2.0 * np.pi

EXPECTED_A12 = 0.6220748484804
EXPECTED_A13 = -0.4832666943981
EXPECTED_R = 0.6035155247873

EXPECTED_TABLE = {
    20: 0.6033930653528,
    40: 0.6035132002964,
    80: 0.6035154874052,
    200: 0.6035155246329,
    400: 0.6035155247852,
}


def g(u, xp=XP):
    if u <= 0.0 or u >= PI2:
        return 0.0
    return (
        (u / PI2)**5
        * np.log(PI2 / u)
        * np.exp(-PI2 / (xp * u))
    )


def Y(n, u):
    return np.sin(n * u / 2.0)


def D(u):
    return np.cos(u / 2.0)


def simpson(f, a, b, N):
    if N < 2:
        raise ValueError("N must be at least 2")
    if N % 2:
        N += 1

    h = (b - a) / N
    total = f(a) + f(b)

    total += 4.0 * sum(
        f(a + i * h) for i in range(1, N, 2)
    )
    total += 2.0 * sum(
        f(a + i * h) for i in range(2, N, 2)
    )

    return total * h / 3.0


def matrix_elements(integrate, xp=XP):
    norms = [
        integrate(lambda u: (g(u, xp) * Y(n, u))**2)
        for n in (1, 2, 3)
    ]

    if any(not np.isfinite(v) or v <= 0 for v in norms):
        raise ArithmeticError("Invalid normalization integral")

    def amplitude(m, n):
        return integrate(
            lambda u: (
                g(u, xp) * Y(m, u) / np.sqrt(norms[m - 1])
            ) * D(u) * (
                g(u, xp) * Y(n, u) / np.sqrt(norms[n - 1])
            )
        )

    a12 = amplitude(1, 2)
    a13 = amplitude(1, 3)

    if not np.isfinite(a12) or not np.isfinite(a13) or a12 == 0:
        raise ArithmeticError("Invalid matrix element")

    return a12, a13, (a13 / a12)**2


def adaptive_integral(f):
    value, error = quad(
        f, 0.0, PI2, limit=300,
        epsabs=1e-12, epsrel=1e-12
    )
    if not np.isfinite(value) or not np.isfinite(error):
        raise ArithmeticError("Adaptive quadrature failed")
    return value


def simpson_integral(f, N):
    return simpson(f, 0.0, PI2, N)


def main():
    # Independent adaptive-quadrature reference
    a12, a13, r_ref = matrix_elements(adaptive_integral)

    # Reference-value checks
    assert abs(a12 - EXPECTED_A12) < 5e-11, (
        f"A12 mismatch: {a12:.13f}"
    )
    assert abs(a13 - EXPECTED_A13) < 5e-11, (
        f"A13 mismatch: {a13:.13f}"
    )
    assert abs(r_ref - EXPECTED_R) < 5e-11, (
        f"R reference mismatch: {r_ref:.13f}"
    )

    print("Adaptive quadrature:")
    print(f"A12 = {a12:.13f}")
    print(f"A13 = {a13:.13f}")
    print(f"R   = {r_ref:.13f}")
    print()

    # Simpson table and convergence checks
    previous_error = float("inf")

    print(" N       R (Simpson)       |R - R_ref|")
    for N, expected in EXPECTED_TABLE.items():
        _, _, r = matrix_elements(
            lambda f, n=N: simpson_integral(f, n)
        )
        error = abs(r - r_ref)

        assert abs(r - expected) < 5e-11, (
            f"Simpson table mismatch at N={N}: {r:.13f}"
        )
        assert error < previous_error, (
            f"Convergence check failed at N={N}"
        )

        print(f"{N:3d}   {r:.13f}   {error:.4e}")
        previous_error = error

    assert abs(
        matrix_elements(
            lambda f: simpson_integral(f, 200)
        )[2] - r_ref
    ) < 2e-10

    print()
    print("verified: numerical results in all-frames-tex.tex")


if __name__ == "__main__":
    try:
        main()
    except Exception as exc:
        print(f"NOT VERIFIED: {exc}", file=sys.stderr)
        sys.exit(1)
