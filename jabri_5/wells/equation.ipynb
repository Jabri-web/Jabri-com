!pip install matplotlib numpy --quiet 2>/dev/null

import numpy as np
import matplotlib.pyplot as plt
from matplotlib.patches import FancyBboxPatch
from matplotlib.gridspec import GridSpec
import matplotlib as mpl

mpl.rcParams['font.family'] = 'DejaVu Sans'

xp = 21.0

# ════════════════════════════════════════════════════════════
#   الصورة 1 — Zx_Equations.png (معادلات نظيفة فقط)
# ════════════════════════════════════════════════════════════

fig, ax = plt.subplots(figsize=(11, 7), dpi=200)
ax.set_xlim(0, 11); ax.set_ylim(0, 7); ax.axis('off')
fig.patch.set_facecolor('white')

eqs = [
    (6.1, r"$x_p \;=\; 21$",
          r"(Yemeni Constant)"),
    (5.0, r"$Z(x) \;=\; x^{-5}\,\ln(x)\,\sin\!\left(\frac{2\pi}{x}\right)\,e^{-x/x_p}$",
          ""),
    (3.9, r"$A(x) \;=\; \left(\frac{x}{x_p}\right)^{2}\,e^{-x/x_p}$",
          ""),
    (2.8, r"$C(x) \;=\; 1 \;-\; Z(x) \;-\; A(x)$",
          ""),
    (1.6, r"$Z_t \;=\; Z + C + A \;=\; 1$",
          ""),
]
for y, eq, note in eqs:
    ax.text(0, y, eq, fontsize=22, ha='left', va='center', color='#111')
    if note:
        ax.text(3.3, y, note, fontsize=13, ha='left', va='center',
                color='#666', style='italic')

for x0, txt in [(8.2, "A. Al-Jabri"), (9.4, "عبدالله الجبري")]:
    ax.add_patch(FancyBboxPatch((x0, 2.4), 0.85, 3.6,
                 boxstyle="round,pad=0.1", linewidth=0,
                 facecolor='#1e6b1e'))
    ax.text(x0 + 0.42, 4.2, txt,
            fontsize=15 if 'A.' in txt else 14,
            rotation=90, ha='center', va='center',
            color='#7fff7f',
            fontweight='bold' if 'A.' in txt else 'normal')

ax.text(5.5, 0.5, "Z + C + A = 1   •   From Sana'a to the Cosmos",
        fontsize=12, ha='center', color='#b5977a', fontweight='bold')

plt.tight_layout()
plt.savefig('Zx_Equations.png', dpi=200, bbox_inches='tight',
            facecolor='white')
plt.close()
print("✅ Zx_Equations.png")

# ════════════════════════════════════════════════════════════
#   الصورة 2 — Zx_Eq_figure.png
#   المعادلات فوق + الرسم تحت — في صورة واحدة
# ════════════════════════════════════════════════════════════

fig = plt.figure(figsize=(12, 13), dpi=200)
fig.patch.set_facecolor('white')

gs = GridSpec(2, 1, height_ratios=[2.6, 4.0], hspace=0.12,
              left=0.06, right=0.97, top=0.97, bottom=0.05)

# ─── اللوحة العليا: المعادلات ───
ax_eq = fig.add_subplot(gs[0])
ax_eq.set_xlim(0, 11); ax_eq.set_ylim(0, 7); ax_eq.axis('off')

eqs2 = [
    (6.1, r"$x_p \;=\; 21$",                                              r"(Yemeni Constant)"),
    (5.0, r"$Z(x) \;=\; x^{-5}\,\ln(x)\,\sin\!\left(\frac{2\pi}{x}\right)\,e^{-x/x_p}$", ""),
    (3.9, r"$A(x) \;=\; \left(\frac{x}{x_p}\right)^{2}\,e^{-x/x_p}$",     ""),
    (2.8, r"$C(x) \;=\; 1 \;-\; Z(x) \;-\; A(x)$",                        ""),
    (1.6, r"$Z_t \;=\; Z + C + A \;=\; 1$",                               ""),
]
for y, eq, note in eqs2:
    ax_eq.text(0, y, eq, fontsize=22, ha='left', va='center', color='#111')
    if note:
        ax_eq.text(3.3, y, note, fontsize=13, ha='left', va='center',
                   color='#666', style='italic')

for x0, txt in [(8.2, "A. Al-Jabri"), (9.4, "عبدالله الجبري")]:
    ax_eq.add_patch(FancyBboxPatch((x0, 2.4), 0.85, 3.6,
                    boxstyle="round,pad=0.1", linewidth=0,
                    facecolor='#1e6b1e'))
    ax_eq.text(x0 + 0.42, 4.2, txt,
               fontsize=15 if 'A.' in txt else 14,
               rotation=90, ha='center', va='center',
               color='#7fff7f',
               fontweight='bold' if 'A.' in txt else 'normal')

# ─── اللوحة السفلى: الرسم ───
ax_plot = fig.add_subplot(gs[1])

x = np.linspace(0.5, 30, 5000)
Z = x**(-5.0) * np.log(x) * np.sin(2*np.pi/x) * np.exp(-x/xp)
A = (x/xp)**2 * np.exp(-x/xp)
C = 1.0 - Z - A

ax_plot.plot(x, Z, color='#1f4fd9', linewidth=2.2, label=r'$Z(x)$')
ax_plot.plot(x, A, color='#0f9b3f', linewidth=2.2, label=r'$A(x)$')
ax_plot.plot(x, C, color='#d92a2a', linewidth=2.2, label=r'$C(x)$')
ax_plot.axhline(1.0, color='#333', linestyle='--', linewidth=1.6,
                label=r'$Z + C + A = 1$')

ax_plot.set_xlabel(r'$x$', fontsize=15)
ax_plot.set_ylabel('Value', fontsize=15)
ax_plot.set_title(r'Behavior of Al-Jabri Functions  (v5.0.1,  $x_p = 21$)',
                  fontsize=15, pad=12)
ax_plot.legend(fontsize=12, loc='upper right', framealpha=0.95)
ax_plot.grid(True, alpha=0.3, linestyle=':')
ax_plot.set_xlim(0.5, 30)
ax_plot.set_ylim(-1.6, 1.9)
ax_plot.axhline(0, color='#888', linewidth=0.7)

# خطوط الأصفار الحقيقية Z=0 عند x = 2/n
for n in [1, 2, 3, 4, 5]:
    xv = 2.0 / n
    if 0.5 <= xv <= 30:
        ax_plot.axvline(xv, color='#bbb', linestyle=':', linewidth=0.7,
                        alpha=0.5)

plt.savefig('Zx_Eq_figure.png', dpi=200, bbox_inches='tight',
            facecolor='white')
plt.show()
print("✅ Zx_Eq_figure.png")
print()
print("=" * 60)
print("  تم توليد الصورتين — نفس الأسماء")
print("=" * 60)