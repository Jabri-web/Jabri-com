import numpy as np
from scipy.integrate import simpson

def g_func(u):
    return (u/(2*np.pi))**5 * np.log(2*np.pi/u) * np.exp(-2*np.pi/(21*u))

def p_func(u):
    return 5/u - 1/(u*np.log(2*np.pi/u)) + 2*np.pi/(21*u**2)

def test_first_order_identity(N):
    u_min = 0.001
    u_max = 2*np.pi - 0.001

    u = np.linspace(u_min, u_max, N)
    h = u[1] - u[0]
    g = g_func(u)
    p = p_func(u)

    # مشتقة عددية مستقلة للدالة g (باستخدام np.gradient بدقة من الرتبة الثانية)
    dg = np.gradient(g, u, edge_order=2)

    # الباقي في العلاقة التحليلية g' = p*g
    residual = dg - p * g

    norm_g = np.sqrt(simpson(g**2, x=u))
    norm_residual = np.sqrt(simpson(residual**2, x=u))

    relative_residual = norm_residual / norm_g

    print(f"N = {N:<6} | h = {h:.2e} | ||g' - p*g||_L2 = {norm_residual:.4e} | Relative Error = {relative_residual:.4e}")

print("=== اختبار صحة الهوية من الرتبة الأولى (g' = p*g) ===")
print("التحقق من أن الباقي يقترب من الصفر مع زيادة كثافة الشبكة")
print("-" * 85)

for N in [1000, 2000, 4000, 8000, 16000]:
    test_first_order_identity(N)