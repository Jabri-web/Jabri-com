import mpmath as mp
from mpmath import mpf

mp.mp.dps = 50  # دقة عالية

# ============================================================
# 0. الإعدادات
# ============================================================
XP_DEFAULT = 21
N_DEFAULT = 5
XMAX_DEFAULT = 30
TARGET_DEFAULT = mpf('0.0072973525')
XMIN = mpf('1.05')

# ثوابت وزن الإطار 5
L5 = 2 * mp.pi
A5 = 4 * mp.pi / 21

# ============================================================
# 1. المحرك التحليلي لـ Z(x)
# ============================================================
def get_terms(x, xp, n):
    x = mpf(x)
    if x <= 1 or xp <= 0:
        return None
    L = mp.log(x)
    if L == 0:
        return None
    q = 2 * mp.pi / x
    Fenv = x**(-n) * L * mp.e**(-x/xp)
    h = -n/x + 1/(x*L) - 1/xp
    hp = n/(x*x) - 1/(x*x*L) - 1/(x*x*L*L)
    qp = -2*mp.pi/(x*x)
    qpp = 4*mp.pi/(x*x*x)
    return dict(Fenv=Fenv, h=h, hp=hp, q=q, qp=qp, qpp=qpp, L=L)

def Zf(x, xp=XP_DEFAULT, n=N_DEFAULT):
    t = get_terms(x, xp, n)
    if not t:
        return mp.nan
    return t['Fenv'] * mp.sin(t['q'])

def dZ_analytic(x, xp=XP_DEFAULT, n=N_DEFAULT):
    t = get_terms(x, xp, n)
    if not t:
        return mp.nan
    return t['Fenv'] * (t['h']*mp.sin(t['q']) + t['qp']*mp.cos(t['q']))

def d2Z_analytic(x, xp=XP_DEFAULT, n=N_DEFAULT):
    t = get_terms(x, xp, n)
    if not t:
        return mp.nan
    return t['Fenv'] * (
        (t['h']*t['h'] + t['hp'] - t['qp']*t['qp']) * mp.sin(t['q'])
        + (2*t['h']*t['qp'] + t['qpp']) * mp.cos(t['q'])
    )

def d4Z_numeric(x, xp=XP_DEFAULT, n=N_DEFAULT, h=mpf('1e-3')):
    f = lambda xx: d2Z_analytic(xx, xp, n)
    return (-f(x + 2*h) + 16*f(x + h) - 30*f(x) + 16*f(x - h) - f(x - 2*h)) / (12 * h**4)

# ============================================================
# 2. A، R، والهوية
# ============================================================
def Af(x, xp=XP_DEFAULT):
    x = mpf(x)
    return (x/xp)**2 * mp.e**(-x/xp)

def Rf(x, xp=XP_DEFAULT, n=N_DEFAULT):
    z = Zf(x, xp, n)
    if not mp.isfinite(z):
        return mp.nan
    return 1 - z - Af(x, xp)

# ============================================================
# 3. التكامل ∫Z — Simpson، N زوجي إجباري
# ============================================================
def integralZ(x, xp=XP_DEFAULT, n=N_DEFAULT, a=XMIN, N=1000):
    x = mpf(x)
    a = mpf(a)
    if x <= a:
        return mpf(0)
    if N % 2 != 0:
        N += 1
    h = (x - a) / N
    s = Zf(a, xp, n) + Zf(x, xp, n)
    for i in range(1, N):
        s += (2 if i % 2 == 0 else 4) * Zf(a + i*h, xp, n)
    return (h/3) * s

# ============================================================
# 4. تصنيف النقاط
# ============================================================
def sample_max_zp(xp, n, xmax, Nsamples=1000):
    m = mpf(0)
    for i in range(Nsamples + 1):
        x = XMIN + (xmax - XMIN) * i / Nsamples
        zp = dZ_analytic(x, xp, n)
        if mp.isfinite(zp):
            m = max(m, abs(zp))
    return m

def sample_max_zpp(xp, n, xmax, Nsamples=1000):
    m = mpf(0)
    for i in range(Nsamples + 1):
        x = XMIN + (xmax - XMIN) * i / Nsamples
        zpp = d2Z_analytic(x, xp, n)
        if mp.isfinite(zpp):
            m = max(m, abs(zpp))
    return m

def classify(x, xp, n, max_zp, max_zpp, eps_rel=mpf('1e-8')):
    zp = dZ_analytic(x, xp, n)
    zpp = d2Z_analytic(x, xp, n)
    z = Zf(x, xp, n)
    if not (mp.isfinite(zp) and mp.isfinite(zpp)):
        return ("غير معرّفة", "")
    at_crit = abs(zp) < eps_rel * max(max_zp, mpf('1e-30'))
    at_infl = abs(zpp) < eps_rel * max(abs(z), mpf('1e-30'))
    if at_crit:
        if zpp < -eps_rel: return ("قمة محلية", "peak")
        if zpp >  eps_rel: return ("قاع محلي", "valley")
        return ("نقطة سرج", "inflect")
    if at_infl:
        return ("انعطاف", "inflect")
    return ("عادية", "")

# ============================================================
# 5. باحث الجذور
# ============================================================
def find_roots(kind, xp, n, xmax, step=mpf('0.005')):
    f = dZ_analytic if kind == 'zp' else d2Z_analytic
    sols = []
    prev_x = XMIN
    prev = f(prev_x, xp, n)
    x = prev_x + step
    while x <= xmax:
        v = f(x, xp, n)
        if not (mp.isfinite(v) and mp.isfinite(prev)):
            prev_x, prev = x, v
            x += step
            continue
        if prev * v < 0:
            a, b, fa = prev_x, x, prev
            for _ in range(60):
                m = (a + b) / 2
                fm = f(m, xp, n)
                if fa * fm <= 0:
                    b = m
                else:
                    a, fa = m, fm
            sols.append((a + b) / 2)
        prev_x, prev = x, v
        x += step
    return sols

# ============================================================
# 6. B_- و B_+ (وزن الإطار 5)
# ============================================================
def w5(u):
    u = mpf(u)
    if u <= 0 or u >= L5:
        return mpf(0)
    ell = mp.log(L5/u)
    return (u/L5)**10 * ell*ell * mp.e**(-A5/u)

def M5(x, N=400):
    x = mpf(x)
    if x <= 0: return mpf(0)
    if N % 2 != 0: N += 1
    h = x / N
    s = w5(0) + w5(x)
    for i in range(1, N):
        s += (2 if i % 2 == 0 else 4) * w5(i*h)
    return (h/3) * s

def R5_minus(x, m, N=400):
    x = mpf(x); m = mpf(m)
    if x >= m: return mpf(0)
    if N % 2 != 0: N += 1
    h = (m - x) / N
    s = 1/w5(x) + 1/w5(m)
    for i in range(1, N):
        s += (2 if i % 2 == 0 else 4) * (1/w5(x + i*h))
    return (h/3) * s

def R5_plus(x, m, N=400):
    x = mpf(x); m = mpf(m)
    if x <= m: return mpf(0)
    if N % 2 != 0: N += 1
    h = (x - m) / N
    s = 1/w5(m) + 1/w5(x)
    for i in range(1, N):
        s += (2 if i % 2 == 0 else 4) * (1/w5(m + i*h))
    return (h/3) * s

def find_m5(lo=mpf('4.935'), hi=mpf('4.95'), N=400, iters=80):
    ML = M5(L5, N)
    target = ML / 2
    for _ in range(iters):
        mid = (lo + hi) / 2
        if M5(mid, N) < target:
            lo = mid
        else:
            hi = mid
    return (lo + hi) / 2

# ============================================================
# 7. التقارير المطبوعة
# ============================================================
def header(title):
    print("\n" + "=" * 64)
    print(title)
    print("=" * 64)

def report_identity(x, xp, n):
    z = Zf(x, xp, n)
    a = Af(x, xp)
    r = Rf(x, xp, n)
    s = z + a + r
    print(f"x = {float(x):.2f}:")
    print(f"  Z = {mp.nstr(z, 8)}")
    print(f"  A = {mp.nstr(a, 8)}")
    print(f"  R = {mp.nstr(r, 8)}")
    print(f"  Z + A + R = {mp.nstr(s, 8)}")
    print(f"  |Z+A+R-1| = {mp.nstr(abs(s-1) if False else abs(s-1), 3)}") # مصحح
    print(f"  ملاحظة: R := 1 - Z - A (تعريف). المجموع 1 دائماً.")

def report_reference_table(xp, n, xmax, max_zp, max_zpp):
    xs = [1.5, 2, 2.5, 3, 3.5, 4, 4.5, 5, 5.5, 6, 7, 8, 9, 10, 12, 14, 16, 18, 20, 22, 25, 28, 30]
    xs = [x for x in xs if x <= float(xmax)]
    print("\n" + "-"*110)
    print(f"{'x':>6} | {'Z(x)':>14} | {'Z_prime':>14} | {'Z_double_prime':>14} | {'Int_Z':>14} | {'Class':>18}")
    print("-"*110)
    for xv in xs:
        x = mpf(xv)
        z = Zf(x, xp, n)
        zp = dZ_analytic(x, xp, n)
        zpp = d2Z_analytic(x, xp, n)
        F = integralZ(x, xp, n)
        cls, _ = classify(x, xp, n, max_zp, max_zpp)
        print(f"{xv:>6.2f} | {float(z):>14.3e} | {float(zp):>14.3e} | {float(zpp):>14.3e} | {float(F):>14.3e} | {cls:>18}")

def report_target_table(xp, n, xmax, target):
    xs = [mpf('1.05') + (mpf(xmax) - mpf('1.05')) * i / 500 for i in range(501)]
    rows = []
    for x in xs:
        zpp = d2Z_analytic(x, xp, n)
        if not mp.isfinite(zpp):
            continue
        err = abs(zpp - target) / abs(target)
        rows.append((x, zpp, err))
    rows.sort(key=lambda t: t[2])
    print(f"\n{'x':>6} | {'Z_double_prime':>16} | {'Error':>14}")
    for x, zpp, err in rows[:15]:
        print(f"{float(x):>6.4f} | {float(zpp):>16.4e} | {float(err*100):>13.3f}%")
    if rows:
        xb, zb, eb = rows[0]
        print(f"\nBest point (Z'' only): x ≈ {float(xb):.4f} | Z'' = {float(zb):.4e} | Error = {float(eb*100):.3f}%")

def report_critical(xp, n, xmax, max_zp, max_zpp):
    r1 = find_roots('zp', xp, n, xmax)
    r2 = find_roots('zpp', xp, n, xmax)
    all_roots = [('Z_prime = 0', r) for r in r1] + [('Z_double_prime = 0', r) for r in r2]
    all_roots.sort(key=lambda t: t[1])
    print(f"\n{'Type':>18} | {'x':>10} | {'Z(x)':>14} | {'Class':>18}")
    if not all_roots:
        print("No roots found.")
        return
    for kind, x in all_roots:
        z = Zf(x, xp, n); 
        cls, _ = classify(x, xp, n, max_zp, max_zpp)
        print(f"{kind:>18} | {float(x):>10.4f} | {float(z):>14.3e} | {cls:>18}")
    print(f"\nNumber of roots: Z' = {len(r1)}, Z'' = {len(r2)}.")

def report_definitional_tests(xp, n, xTest=mpf('4.2'), h=mpf('1e-5')):
    z = Zf(xTest, xp, n)
    zp = dZ_analytic(xTest, xp, n)
    zpp = d2Z_analytic(xTest, xp, n)
    zp_num = (Zf(xTest+h, xp, n) - Zf(xTest-h, xp, n)) / (2*h)
    zpp_num = (dZ_analytic(xTest+h, xp, n) - dZ_analytic(xTest-h, xp, n)) / (2*h)
    Fp_num = (integralZ(xTest+h, xp, n) - integralZ(xTest-h, xp, n)) / (2*h)
    print(f"\nAt x = {float(xTest)}:")
    print(f"  |C - Z'|     = {float(abs(zp - zp_num)):.3e}  [definition]")
    print(f"  |P - C'|     = {float(abs(zpp - zpp_num)):.3e}  [definition]")
    print(f"  |F'_num - Z| = {float(abs(Fp_num - z)):.3e}  [definition]")

def report_muckenhoupt():
    m = find_m5()
    ML = M5(L5)
    print(f"\nm (median of w) ≈ {mp.nstr(m, 15)}") # زيادة الدقة هنا
    print(f"M(L) ≈ {mp.nstr(ML, 15)}")
    print(f"Note v3.1: m in [4.935, 4.95] interval certificate.")
    print(f"\n{'x':>6} | {'M(x)':>14} | {'B_-(x)':>16} | {'B_+(x)':>16}")
    
    Nsamp = 22
    Bm_max = mpf(-mp.inf); xm_max = mpf(mp.nan) # مصحح
    Bp_max = mpf(-mp.inf); xp_max = mpf(mp.nan) # مصحح
    for i in range(Nsamp + 1):
        x = mpf('0.5') + mpf('5.5') * i / Nsamp
        M = M5(x, N=400)
        if x <= m:
            Rm = R5_minus(x, m, N=400)
            Bm = M * Rm
            Bp = None
        else:
            Rp = R5_plus(x, m, N=400)
            Bp = (ML - M) * Rp
            Bm = None
        if Bm is not None and Bm > Bm_max:
            Bm_max, xm_max = Bm, x
        if Bp is not None and Bp > Bp_max:
            Bp_max, xp_max = Bp, x
        bm_s = f"{float(Bm):.6f}" if Bm is not None else "---"
        bp_s = f"{float(Bp):.6f}" if Bp is not None else "---"
        print(f"{float(x):>6.2f} | {float(M):>14.6f} | {bm_s:>16} | {bp_s:>16}")
    print(f"\nB_- max (sample) = {float(Bm_max):.6f} at x = {float(xm_max):.2f}")
    print(f"B_+ max (sample) = {float(Bp_max):.6f} at x = {float(xp_max):.2f}")
    print(f"Reference: B_-^max ≈ 0.308029, B_+^max ≈ 0.192466")
    print("\nWARNING: B_- and B_+ are numerical estimates.")

# ============================================================
# 8. التشغيل الرئيسي
# ============================================================
if __name__ == "__main__":
    print(f"mpmath {mp.__version__} . mp.dps = {mp.mp.dps}")
    print("Z Simulator - Python Version")

    xp = XP_DEFAULT
    n = N_DEFAULT
    xmax = XMAX_DEFAULT
    target = TARGET_DEFAULT

    header("1. Identity Z + A + R = 1")
    for xv in [2.0, 4.2, 10.0, 20.0]:
        report_identity(mpf(xv), xp, n)

    header("2. Sampled max")
    max_zp = sample_max_zp(xp, n, xmax)
    max_zpp = sample_max_zpp(xp, n, xmax)
    max_z = max(abs(Zf(XMIN + (xmax-XMIN)*i/1000, xp, n)) for i in range(1001))
    max_F = max(abs(integralZ(XMIN + (xmax-XMIN)*i/1000, xp, n)) for i in range(1001))
    print(f"  sampled max |Z|    = {float(max_z):.6e}")
    print(f"  sampled max |Z'|   = {float(max_zp):.6e}")
    print(f"  sampled max |Z''|  = {float(max_zpp):.6e}")
    print(f"  sampled max |Int Z| = {float(max_F):.6e}")

    header("3. Reference Table")
    report_reference_table(xp, n, xmax, max_zp, max_zpp)

    header("4. Critical Points")
    report_critical(xp, n, xmax, max_zp, max_zpp)

    header("5. Distance to Target")
    print(f"target = {float(target)}")
    report_target_table(xp, n, xmax, target)

    header("6. Definitional Tests")
    report_definitional_tests(xp, n)

    header("7. B_- and B_+ (Muckenhoupt Weights)")
    report_muckenhoupt()

    header("8. Final Notes")
    print("Z(x) < 0 on (1.05, 2), Z(x) > 0 on (2, XMAX].")
    
    print("\n" + "=" * 64)
    print("Execution Finished.")
    print("=" * 64)
    
    
    
