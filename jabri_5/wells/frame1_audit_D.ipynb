#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
Audit D — إعادة إنتاج مستقلة للتحقق العددي في Frame 1 (v7.1)
الغرض: التحقق من A(100) وحد الذيل، وجدول C(t) في §7.
يستخدم Python 3.9+ مع NumPy وSciPy فقط.
"""
import sys
import platform
import numpy as np
from scipy.integrate import quad

# ═══ بيانات البيئة (تُوثَّق في review.html) ═══
print("=" * 72)
print("Audit D — إعادة إنتاج مستقلة | Frame 1 v7.1")
print("=" * 72)
print(f"Python : {platform.python_version()}")
print(f"NumPy  : {np.__version__}")
try:
    import scipy
    print(f"SciPy  : {scipy.__version__}")
except ImportError:
    print("❌ SciPy غير مثبت — أوقف التنفيذ")
    sys.exit(1)
print(f"Platform: {platform.system()} {platform.machine()}")
print()

# ═══ D.1 — A(100) وحد الذيل ═══
print("─" * 72)
print("D.1 — A(100) وحد الذيل")
print("─" * 72)

def Z_real(t, xp=21.0):
    if t <= 1: return 0.0
    return (t**-5) * np.log(t) * np.sin(2*np.pi/t) * np.exp(-t/xp)

A_100, err_A100 = quad(Z_real, 1, 100, limit=500,
                       epsabs=1e-15, epsrel=1e-12)
X = 100.0
tail = 42*np.pi * X**-6 * np.log(X) * np.exp(-X/21.0)

EXPECTED_A100 = -0.0246463895708
print(f"A(100)         = {A_100:.13f}")
print(f"quad err       = {err_A100:.3e}")
print(f"Tail bound     = {tail:.3e}")
print(f"A+err+tail < 0 ? {A_100 + err_A100 + tail < 0}")
print(f"القيمة المتوقعة في frame1.html §8: {EXPECTED_A100}")
print(f"الفرق عن المتوقع                : {abs(A_100 - EXPECTED_A100):.3e}")
match_A = abs(A_100 - EXPECTED_A100) < 1e-10
print(f"مطابقة A(100)    : {'✅' if match_A else '❌'}")
print()

# ═══ D.2 — جدول C(t) ═══
print("─" * 72)
print("D.2 — جدول C(t) — §7 من frame1.html")
print("─" * 72)

def Z_cplx(s, xp=21.0):
    return (s**-5) * np.log(s) * np.sin(2*np.pi/s) * np.exp(-s/xp)

K21 = 2*np.pi*np.exp(-1/42)
print(f"K(21) = 2π e^(-1/42) = {K21:.9f}")
print(f"القيمة المتوقعة في frame1.html: 6.135353")
print()

# القيم المتوقعة من frame1.html §7 (لمقارنة الاستنساخ)
expected = {
    1e2: {"C": 6.484090, "rel": 5.68e-2},
    1e3: {"C": 6.291918, "rel": 2.55e-2},
    1e4: {"C": 6.223935, "rel": 1.44e-2},
    1e5: {"C": 6.192194, "rel": 9.26e-3},
}

hdr = f"{'t':>8} {'|Z|':>16} {'C(t)':>12} {'|C-K|':>10} {'rel':>10} {'ΔC':>11} {'✓'}"
print(hdr)
print("-" * len(hdr))

all_match = True
for t in [1e2, 1e3, 1e4, 1e5]:
    z = abs(Z_cplx(0.5 + 1j*t))
    C = z * t**6 / np.log(t)
    err = abs(C - K21)
    rel = err / K21
    delta = C - expected[t]["C"]
    match = abs(delta) < 1e-5
    all_match = all_match and match
    flag = "✅" if match else "❌"
    print(f"{t:>8.0e} {z:>16.6e} {C:>12.6f} {err:>10.6f} {rel:>10.2e} {delta:>+11.2e} {flag}")

print()
print(f"مطابقة الجدول كاملًا مع frame1.html v7.1: {'✅' if all_match else '❌'}")
print()

# ═══ فحص إضافي — استمرار التقارب ═══
print("─" * 72)
print("فحص إضافي — استمرار التقارب خارج نطاق الجدول")
print("─" * 72)
for exp in [6, 7, 8]:
    t = 10.0**exp
    z = abs(Z_cplx(0.5 + 1j*t))
    C = z * t**6 / np.log(t)
    rel = abs(C - K21) / K21
    print(f"t=1e{exp}: C(t)={C:.6f},  rel={rel:.3e}")
print("← rel يتناقص بمعدل ~1/(ln t)^2 (راجع §7)")
print()

# ═══ الحكم النهائي ═══
print("=" * 72)
if match_A and all_match:
    print("✅ الحكم: PASS — كل النتائج مطابقة لـ frame1.html v7.1")
else:
    print("❌ الحكم: FAIL — بعض النتائج لا تطابق frame1.html v7.1")
    print("   — لا تُوقّع على إعادة الإنتاج قبل فحص الفروق أعلاه.")
print("=" * 72)