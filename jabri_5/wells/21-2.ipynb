import math
import numpy as np
import matplotlib.pyplot as plt

# --- Core Model ---
def zx_v04(t, xp, a):
    """
    Zx Framework v0.4 - Bounded Interaction Model
    Z(t) = exp(-t/xp)
    C(t) = a * Z * (1-Z)
    A(t) = (1-Z) * (1-aZ)
    """
    if xp <= 0:
        raise ValueError("xp must be positive")
    if np.any(np.asarray(t) < 0):
        raise ValueError("t must be non-negative")

    Z = np.exp(-np.asarray(t, dtype=float) / xp)
    C = a * Z * (1.0 - Z)
    A = (1.0 - Z) * (1.0 - a * Z)
    return Z, C, A


# ============================================================
# TEST 1: BASIC IMPLEMENTATION & IDENTITY CHECK
# ============================================================
print("\n" + "="*60)
print("TEST 1: BASIC IMPLEMENTATION & IDENTITY CHECK")
print("="*60)

xp, a = 21, 0.5
t = np.linspace(0, 5 * 2 * np.pi * xp, 10001)
Z, C, A = zx_v04(t, xp, a)

identity_error = np.max(np.abs(A - (1 - Z - C)))
print("Identity error:", identity_error)
print("Z range:", Z.min(), Z.max())
print("C range:", C.min(), C.max())
print("A range:", A.min(), A.max())

assert identity_error < 1e-12
assert np.all(Z >= 0)
assert np.all(Z <= 1)
print("BASIC IMPLEMENTATION TEST: PASS")


# ============================================================
# TEST 2: RANGE COMPLIANCE SWEEP
# ============================================================
print("\n" + "="*60)
print("TEST 2: RANGE COMPLIANCE SWEEP")
print("="*60)

XP_VALUES = np.arange(1, 101, 1)
A_VALUES = np.linspace(0, 1.5, 301)
TOL = 1e-12
CYCLES = 5

results = []
for amp in A_VALUES:
    for xp in XP_VALUES:
        t_end = CYCLES * 2 * np.pi * xp
        t = np.linspace(0, t_end, 10001)
        Z, C, A = zx_v04(t, xp, amp)
        min_A = np.min(A)
        max_A = np.max(A)
        bounded = (min_A >= -TOL and max_A <= 1 + TOL)
        results.append({"a": amp, "xp": xp, "bounded": bounded})

passed = sum(r["bounded"] for r in results)
failed = len(results) - passed
print("Total tests:", len(results))
print("Bounded:", passed)
print("Out of bounds:", failed)
assert failed > 0
print("SWEEP COMPLETED")


# ============================================================
# TEST 3: SHARP BOUND TEST
# ============================================================
print("\n" + "="*60)
print("TEST 3: SHARP BOUND TEST")
print("="*60)

xp = 21
A_TEST = [0.999, 1.000, 1.001, 1.010, 1.200]
t = np.linspace(0, 5 * 2 * np.pi * xp, 200001)

for amp in A_TEST:
    Z, C, A = zx_v04(t, xp, amp)
    min_A = np.min(A)
    max_A = np.max(A)
    status = "BOUNDED" if (min_A >= -TOL and max_A <= 1 + TOL) else "OUT OF BOUNDS"
    print(f"a={amp:.3f} | {status:15s} | min(A)={min_A:.8f} | max(A)={max_A:.8f}")
print("SHARP BOUND TEST: COMPLETED")


# ============================================================
# TEST 4: EXPONENTIAL STABILITY AUDIT
# ============================================================
print("\n" + "="*60)
print("TEST 4: EXPONENTIAL STABILITY AUDIT")
print("="*60)

xp = 21
Z0 = 1.0
t = np.linspace(0, 10 * xp, 10001)
Z_exact = Z0 * np.exp(-t / xp)
V = 0.5 * Z_exact**2
V_dot = -(Z_exact**2) / xp

monotonic_decay = np.all(np.diff(Z_exact) <= 0)
lyapunov_decreasing = np.all(V_dot < 0)
decay_rate = 1 / xp

print("Decay rate =", decay_rate)
print("Z(0) =", Z_exact[0])
print("Z(10*xp) =", Z_exact[-1])
print("Monotonic decay:", monotonic_decay)
print("Lyapunov decreasing:", lyapunov_decreasing)

assert monotonic_decay
assert lyapunov_decreasing
print("SCALAR ODE STABILITY TEST: PASS")


