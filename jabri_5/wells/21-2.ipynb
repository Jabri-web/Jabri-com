# ============================================================
# TEST 7: RANDOMIZED PROPERTY TEST
# ============================================================
print("\n" + "="*60)
print("TEST 7: RANDOMIZED PROPERTY TEST")
print("="*60)

rng = np.random.default_rng(20261101)
N = 500000
Z_random = rng.uniform(0, 1, N)
a_random = rng.uniform(0, 1, N)

C_random = a_random * Z_random * (1 - Z_random)
A_random = (1 - Z_random) * (1 - a_random * Z_random)
A_identity = 1 - Z_random - C_random

identity_error = np.max(np.abs(A_random - A_identity))
min_A = np.min(A_random)
max_A = np.max(A_random)

print("Number of samples:", N)
print("Maximum identity error:", identity_error)
print("Minimum A:", min_A)
print("Maximum A:", max_A)

assert identity_error < 1e-12
assert min_A >= -TOL
assert max_A <= 1 + TOL
print("RANDOMIZED TEST: PASS")


