# ============================================================
# TEST 9: VISUALIZATION (4 PLOTS)
# ============================================================
print("\n" + "="*60)
print("TEST 9: VISUALIZATION")
print("="*60)

xp, a = 21, 0.5
t = np.linspace(0, 5 * xp, 2000)
Z = np.exp(-t / xp)
C = a * Z * (1 - Z)
A = (1 - Z) * (1 - a * Z)

# Figure 1
plt.figure(figsize=(8, 5))
plt.plot(t, Z, label='Z(t)', linewidth=2)
plt.plot(t, C, label='C(t)', linewidth=2)
plt.plot(t, A, label='A(t)', linewidth=2)
plt.axvline(xp * np.log(2), color='gray', linestyle='--', label='t_peak = xp ln(2)')
plt.title(f'Zx v0.4: Time Evolution (xp={xp}, a={a})')
plt.xlabel('t'); plt.ylabel('Value'); plt.legend(); plt.grid(True)
plt.tight_layout(); plt.show()

# Figure 2
plt.figure(figsize=(6, 6))
plt.plot(C, A, linewidth=2, color='purple')
plt.scatter([0], [0], color='green', label='Start (t=0)')
plt.scatter([0], [1], color='red', label='End (t→∞)')
plt.title('Phase Portrait: A vs C')
plt.xlabel('C'); plt.ylabel('A'); plt.legend(); plt.grid(True)
plt.tight_layout(); plt.show()

# Figure 3
plt.figure(figsize=(8, 5))
for amp in [0.999, 1.000, 1.001]:
    A_amp = (1 - Z) * (1 - amp * Z)
    plt.plot(t, A_amp, label=f'a={amp}')
plt.axhline(0, color='black', linestyle=':', linewidth=1)
plt.title('Sharp Threshold: A(t) for a near 1')
plt.xlabel('t'); plt.ylabel('A(t)'); plt.legend(); plt.grid(True)
plt.tight_layout(); plt.show()

# Figure 4
plt.figure(figsize=(8, 5))
for xp_val in [5, 21, 100]:
    Z_xp = np.exp(-t / xp_val)
    A_xp = (1 - Z_xp) * (1 - a * Z_xp)
    plt.plot(t / xp_val, A_xp, label=f'xp={xp_val}')
plt.title(f'Scale Invariance: A vs t/xp (a={a})')
plt.xlabel('t / xp'); plt.ylabel('A'); plt.legend(); plt.grid(True)
plt.tight_layout(); plt.show()

print("ALL TESTS COMPLETED SUCCESSFULLY.")