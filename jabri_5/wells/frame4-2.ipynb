import numpy as np
import scipy.linalg as la
import matplotlib.pyplot as plt

# 1. إعدادات الشبكة مع قطع الطرفين لتجنب التفردات
N = 2000
u_min = 0.05
u_max = 2 * np.pi - 0.05
u = np.linspace(u_min, u_max, N)
h = u[1] - u[0]

# 2. الدالة p(u)
def p_func(u):
return 5/u - 1/(u*np.log(2*np.pi/u)) + 2*np.pi/(21*u**2)

p_vals = p_func(u)

# 3. بناء مصفوفة التفكيك Q = -D + W
# D هي مصفوفة الفروق المركزية (بدون القطر الرئيسي)
D = np.zeros((N, N))
for i in range(1, N-1):
D[i, i-1] = -1 / (2*h)
D[i, i+1] = 1 / (2*h)

W = np.diag(p_vals)
Q = -D + W

# 4. المؤثر L = Q^T Q (طريقة SUSY المستقرة)
L_susy = Q.T @ Q

# 5. تطبيق شرط ديريكليه (حذف الصف والعمود الأخير والأول إذا لزم)
# بما أننا قطعنا المجال، نطبق الشرط على النقطة الأخيرة
L_dirichlet = L_susy[:-1, :-1]

# 6. حساب الطيف
eigenvalues, eigenvectors = la.eigh(L_dirichlet)

# 7. استخراج الحالة الأرضية (State 0)
psi_0 = eigenvectors[:, 0]
# إعادة إضافة الصفر عند الحدود للرسم
psi_0_plot = np.append(psi_0, 0)
u_plot = np.append(u, u_max + h) # إضافة نقطة وهمية للحد

# التطبيع
psi_0_plot = psi_0_plot / np.sqrt(np.trapz(psi_0_plot**2, u_plot))

# الدالة التحليلية g(u) للمقارنة
def g_func(u):
return (u/(2*np.pi))**5 * np.log(2*np.pi/u) * np.exp(-2*np.pi/(21*u))
g_vals = g_func(u_plot[:-1])
g_vals = g_vals / np.sqrt(np.trapz(g_vals**2, u_plot[:-1])) # تطبيع

# 8. الرسم البياني (المطلوب لـ frame4.html)
plt.figure(figsize=(10, 6))
plt.plot(u_plot[:-1], psi_0_plot[:-1], 'b-', linewidth=2, label=r'Numerical $\psi_0$ (SUSY)')
plt.plot(u_plot[:-1], g_vals, 'r--', linewidth=2, label=r'Analytical $g(u)$')
plt.title('Ground State of L via SUSY Factorization (Dirichlet at 2π)', fontsize=14)
plt.xlabel('u')
plt.ylabel('ψ(u)')
plt.legend()
plt.grid(True)
plt.show()

print(f"Ground State Energy (λ_0) = {eigenvalues[0]:.8e}")