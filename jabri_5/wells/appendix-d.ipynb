import mpmath as mp
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import warnings
warnings.filterwarnings('ignore')

mp.mp.dps = 30
xp = mp.mpf('21')

print("=" * 70)
print(" appendix-d.ipynb — Asymptotic Coefficient of Z")
print("=" * 70)
print()

# ============================================================
# الدالة على الخط الحرج
# ============================================================
def Z_critical(t):
"""Z(0.5 + i·t) = exp(-x/21) · x^(-5) · ln(x) · sin(2π/x)"""
x = mp.mpc('0.5', str(t))
return mp.exp(-x/xp) * x**(-5) * mp.log(x) * mp.sin(2*mp.pi/x)

# ============================================================
# النطاق الكبير لإظهار السلوك المقارب
# ============================================================
t_large = np.logspace(2, 5, 100)
print(f"⏳ حساب |Z(0.5+it)| على {len(t_large)} نقطة...")

Z_large = np.array([float(abs(Z_critical(t))) for t in t_large])
print("✅ تم")
print()

# ============================================================
# التحليل على log-log
# ============================================================
log_t = np.log10(t_large)
log_Z = np.log10(Z_large)

mask = log_t > 3.5
slope, intercept = np.polyfit(log_t[mask], log_Z[mask], 1)

print("=" * 70)
print(" 📌 التحليل")
print("=" * 70)
print(f" النطاق: t ∈ [{t_large[0]:.0f}, {t_large[-1]:.0f}]")
print(f" الميل المقاس على log-log: {slope:.4f}")
print(f" الميل النظري: -6.0000")
print(f" الفرق: {abs(slope - (-6)):.4f}")
print()

# ============================================================
# استخراج الثابت C
# ============================================================
C_values = np.array([float(abs(Z_critical(t))) * t**6 / np.log(t) for t in t_large])
theoretical = 2 * np.pi * np.exp(-0.5/21)

print("=" * 70)
print(" 📌 الثابت المستخرج")
print("=" * 70)
print(f" C المقاس (t > 1000): {C_values[log_t > 3].mean():.6f}")
print(f" C النظري: 2π·e^(-0.5/21)")
print(f" = {theoretical:.6f}")
rel_err = abs(C_values[log_t > 3].mean() - theoretical) / theoretical * 100
print(f" الخطأ النسبي: {rel_err:.4f}%")
print()

# ============================================================
# Table D1 — الجدول
# ============================================================
print("=" * 70)
print(" Table D1 — Asymptotic Coefficient")
print("=" * 70)
print()

rows = []
for i in [0, 25, 50, 75, 99]:
rows.append({
't': f'{t_large[i]:.1f}',
'|Z(0.5+it)|': f'{Z_large[i]:.4e}',
'C = |Z|·t^6/ln(t)': f'{C_values[i]:.6f}'
})

df = pd.DataFrame(rows)
print(df.to_string(index=False))
print()

# ============================================================
# Table D2 — ملخص
# ============================================================
print("=" * 70)
print(" Table D2 — Summary")
print("=" * 70)
print()

summary_rows = [
{'Quantity': 'Slope (measured)', 'Value': f'{slope:.4f}'},
{'Quantity': 'Slope (theoretical)', 'Value': '-6.0000'},
{'Quantity': 'Slope difference', 'Value': f'{abs(slope + 6):.4f}'},
{'Quantity': 'C (measured, t > 1000)', 'Value': f'{C_values[log_t > 3].mean():.6f}'},
{'Quantity': 'C (theoretical)', 'Value': f'{theoretical:.6f}'},
{'Quantity': 'Relative error', 'Value': f'{rel_err:.4f}%'},
{'Quantity': 'Formula', 'Value': '|Z| ≈ C·ln(t)/t^6, C = 2π·e^(-1/42)'},
]

df2 = pd.DataFrame(summary_rows)
print(df2.to_string(index=False))
print()

# ============================================================
# التصدير إلى CSV
# ============================================================
df_full = pd.DataFrame({
't': t_large,
'Z_modulus': Z_large,
'C_t': C_values,
'log10_t': log_t,
'log10_Z': log_Z,
})
df_full.to_csv('appendix-d_full.csv', index=False, float_format='%.6e')

df_summary = pd.DataFrame(summary_rows)
df_summary.to_csv('appendix-d_summary.csv', index=False)

print("✅ CSV files saved:")
print(" - appendix-d_full.csv (100 rows)")
print(" - appendix-d_summary.csv (7 rows)")
print()

# ============================================================
# الرسم — 2 لوحات
# ============================================================
fig, axes = plt.subplots(1, 2, figsize=(14, 5))
fig.suptitle('Appendix D — Asymptotic Coefficient of Z',
fontsize=13, fontweight='bold')

# (1) المقارنة المقاربة
ax = axes[0]
ax.loglog(t_large, Z_large, 'b-', linewidth=2, label='|Z(0.5+it)|')
ax.loglog(t_large, theoretical * np.log(t_large) / t_large**6,
'r--', linewidth=1.5,
label=f'C·ln(t)/t⁶ (C={theoretical:.4f})')
ax.set_xlabel('t (log scale)')
ax.set_ylabel('|Z| (log scale)')
ax.set_title('Asymptotic match')
ax.legend()
ax.grid(alpha=0.3, which='both')

# (2) تقارب C
ax = axes[1]
ax.plot(t_large, C_values, 'g-', linewidth=2)
ax.axhline(theoretical, color='r', linestyle='--',
label=f'2π·e^(-0.5/21) = {theoretical:.6f}')
ax.set_xscale('log')
ax.set_xlabel('t (log scale)')
ax.set_ylabel('C = |Z|·t⁶/ln(t)')
ax.set_title('Convergence of C')
ax.legend()
ax.grid(alpha=0.3)

plt.tight_layout()
plt.savefig('jabri_appendix_D.png', dpi=150, bbox_inches='tight')
plt.show()

print("✅ Figure saved: jabri_appendix_D.png")
print()

# ============================================================
# الخلاصة
# ============================================================
print("=" * 70)
print(" 📖 الخلاصة")
print("=" * 70)
print(f"""
