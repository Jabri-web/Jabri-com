from fractions import Fraction as F
from math import factorial

# --- دوال الإحاطة (نفس الدوال السابقة) ---
def atan_inv_bounds(q, N):
x = F(1, q)
s = sum(((-1)**k) * x**(2*k+1) / (2*k+1) for k in range(N+1))
nxt = ((-1)**(N+1)) * x**(2*N+3) / (2*N+3)
return min(s, s+nxt), max(s, s+nxt)

def e_bounds(N=30):
s = sum((F(1, factorial(k)) for k in range(N+1)), F(0))
first = F(1, factorial(N+1))
rem = first / (1 - F(1, N+2))
return s, s+rem

def log_bounds(x, N=30):
z = (x-1)/(x+1)
s = 2*sum((z**(2*k+1)/F(2*k+1) for k in range(N+1)), F(0))
rem = 2*z**(2*N+3) / (F(2*N+3)*(1-z*z))
return s, s+rem

def exp_bounds(x, N=30):
s = sum((x**k/F(factorial(k)) for k in range(N+1)), F(0))
first = x**(N+1)/F(factorial(N+1))
rem = first/(1-x/F(N+2))
return s, s+rem

def decimal_ceil(q, digits=18):
scale = 10**digits
z = q*scale
k = -((-z.numerator)//z.denominator)
return f"{k//scale}.{k%scale:0{digits}d}"

# --- إعداد الثوابت الأساسية ---
a5_lo, a5_hi = atan_inv_bounds(5, 30)
