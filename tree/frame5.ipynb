import mpmath as mp
import time

mp.mp.dps = 30

L = mp.mpf('6.283185307179586476925286766559')
a = mp.mpf('0.598398600683770162417096337587')

def w(u):
    if u <= 0 or u >= L: return mp.mpf('0')
    q = mp.log(L/u)
    if q <= 0: return mp.mpf('0')
    lw = 10*mp.log(u/L) + 2*mp.log(q) - a/u
    return mp.mpf('0') if lw < -700 else mp.exp(lw)

def inv_w(u):
    lw = 10*mp.log(u/L) + 2*mp.log(mp.log(L/u)) - a/u if 0 < u < L else -700
    return mp.mpf('0') if -lw < -700 else mp.exp(-lw)

# دالة لحساب التكامل مع حدود خطأ صارمة
def quad_bounds(func, a_b, b_b):
    val, err = mp.quad(func, [a_b, b_b], error=True)
    return val - 10*err - mp.mpf('1e-25'), val + 10*err + mp.mpf('1e-25')

print("1. حساب الكتلة والوسيط...")
M_total = mp.quad(w, [0, L])
lo, hi = mp.mpf('0.01'), L - mp.mpf('0.01')
for _ in range(60):
    mid = (lo+hi)/2
    if mp.quad(w, [0, mid]) < M_total/2: lo = mid
    else: hi = mid
m = (lo+hi)/2
print(f"M = {mp.nstr(M_total,10)} m = {mp.nstr(m,10)}")

print("\n2. التحقق الفتري من إشارة B_-'(x) على [0, 0.5]...")
# نتحقق على 50 فترة فرعية
N = 50
start, end = mp.mpf('0.01'), mp.mpf('0.5')
step = (end - start) / N
all_positive = True

for i in range(N):
    x1 = start + i*step
    x2 = start + (i+1)*step
    
    # M(x2) هو الحد الأعلى لـ M(x) على [x1, x2]
    M_ub, _ = quad_bounds(w, mp.mpf('0'), x2)
    
    # R(x2) هو الحد الأدنى لـ R(x) على [x1, x2] (لأن R متناقصة)
    R_lb, _ = quad_bounds(inv_w, x2, m)
    
    # w(x1) هو الحد الأدنى لـ w(x) على [x1, x2] (لأن w متزايدة على [0, 0.5])
    w_min = w(x1)
    
    # الحد الأدنى للمشتقة على الفترة
    deriv_lower_bound = w_min**2 * R_lb - M_ub
    
    if deriv_lower_bound <= 0:
        all_positive = False
        print(f"فشل عند [{mp.nstr(x1,4)}, {mp.nstr(x2,4)}]: deriv_lb = {mp.nstr(deriv_lower_bound, 6)}")

if all_positive:
    print("✅ نجح: B_-'(x) > 0 على كامل [0, 0.5] (مثبت فترياً).")
else:
    print("❌ فشل التحقق على بعض الفترات. قد تحتاج إلى تقسيم أدق.")

print("\n3. التحقق الفتري من إشارة B_+'(x) على [L-0.5, L]...")
# B_+'(x) = M_+(x)/w(x) - w(x)R_+(x) حيث M_+(x) = ∫_x^L w و R_+(x) = ∫_m^x 1/w
# نريد إثبات أن B_+'(x) < 0، أي M_+(x) - w(x)^2 R_+(x) < 0
start, end = L - mp.mpf('0.5'), L - mp.mpf('0.01')
step = (end - start) / N
all_negative = True

for i in range(N):
    x1 = start + i*step
    x2 = start + (i+1)*step
    
    # M_+(x1) هو الحد الأعلى لـ M_+(x) على [x1, x2] (لأن M_+ متناقصة)
    _, M_plus_ub = quad_bounds(w, x1, L)
    
    # R_+(x1) هو الحد الأدنى لـ R_+(x) على [x1, x2] (لأن R_+ متزايدة)
    R_plus_lb, _ = quad_bounds(inv_w, m, x1)
    
    # w(x2) هو الحد الأدنى لـ w(x) على [x1, x2] (لأن w متناقصة على [L-0.5, L])
    w_min = w(x2)
    
    # الحد الأعلى للمشتقة على الفترة
    deriv_upper_bound = M_plus_ub - w_min**2 * R_plus_lb
    
    if deriv_upper_bound >= 0:
        all_negative = False
        print(f"فشل عند [{mp.nstr(x1,4)}, {mp.nstr(x2,4)}]: deriv_ub = {mp.nstr(deriv_upper_bound, 6)}")

if all_negative:
    print("✅ نجح: B_+'(x) < 0 على كامل [L-0.5, L] (مثبت فترياً).")
else:
    print("❌ فشل التحقق على بعض الفترات.")

print("\n4. حساب الشهادة بناءً على النجاح...")
if all_positive and all_negative:
    print("بما أن الإشارات مثبتة، فإن B_- متزايدة على [0.01, 0.5] و B_+ متناقصة على [L-0.5, L].")
    # الآن يمكننا استخدام B_-(0.5) و B_+(L-0.5) كحدود عليا
    M_ub_05, _ = quad_bounds(w, mp.mpf('0'), mp.mpf('0.5'))
    R_lb_05, _ = quad_bounds(inv_w, mp.mpf('0.5'), m)
    B_minus_ub = M_ub_05 * R_lb_05

    _, M_plus_ub_L05 = quad_bounds(w, L - mp.mpf('0.5'), L)
    R_plus_lb_L05, _ = quad_bounds(inv_w, m, L - mp.mpf('0.5'))
    B_plus_ub = M_plus_ub_L05 * R_plus_lb_L05

    B_ub = max(B_minus_ub, B_plus_ub)
    lambda_certified = 1 / (4 * B_ub)
    
    print("\n" + "="*60)
    print("الشهادة الرياضية المضمونة (CERTIFIED BOUNDS)")
    print("="*60)
    print(f"B_- (الحد الأعلى المضمون) = {mp.nstr(B_minus_ub, 10)}")
    print(f"B_+ (الحد الأعلى المضمون) = {mp.nstr(B_plus_ub, 10)}")
    print("-" * 60)
    print(f"B_upper = {mp.nstr(B_ub, 10)}")
    print(f"lambda_1 >= 1 / (4 * B_upper) = {mp.nstr(lambda_certified, 10)}")
    print("="*60)
else:
    print("لم يتم إثبات الشهادة بسبب فشل التحقق الفتري.")
    
    
