import mpmath as mp
import time

# إعداد الدقة
mp.mp.dps = 30

L = mp.mpf('6.283185307179586476925286766559')
a = mp.mpf('0.598398600683770162417096337587') # 4*pi/21

# ---------------------------------------------------------
# 1. العالم العددي (لحساب الوسيط m)
# ---------------------------------------------------------
def log_w_num(u):
    if u <= 0 or u >= L: return mp.ninf
    q = mp.log(L/u)
    if q <= 0: return mp.ninf
    return 10*mp.log(u/L) + 2*mp.log(q) - a/u

def w_num(u):
    lw = log_w_num(u)
    if lw < -700: return mp.mpf('0')
    return mp.exp(lw)

print("1. حساب الكتلة والوسيط...")
M = mp.quad(w_num, [0, L])
lo, hi = mp.mpf('0.01'), L - mp.mpf('0.01')
for _ in range(60):
    mid = (lo+hi)/2
    if mp.quad(w_num, [0, mid]) < M/2: lo = mid
    else: hi = mid
m_num = (lo+hi)/2
print(f"M = {mp.nstr(M,10)} m = {mp.nstr(m_num,10)}")

# ---------------------------------------------------------
# 2. العالم الفتري (للشهادة الصارمة)
# ---------------------------------------------------------
L_iv = mp.iv.mpf([L, L])
a_iv = mp.iv.mpf([a, a])
m_iv = mp.iv.mpf([m_num, m_num])

def log_w_iv(u_iv):
    q_iv = mp.iv.log(L_iv / u_iv)
    return 10*mp.iv.log(u_iv / L_iv) + 2*mp.iv.log(q_iv) - a_iv / u_iv

def w_iv(u_iv):
    if u_iv.b <= 0 or u_iv.a >= L:
        return mp.iv.mpf([0, 0])
    return mp.iv.exp(log_w_iv(u_iv))

def inv_w_iv(u_iv):
    if u_iv.b <= 0 or u_iv.a >= L:
        return mp.iv.mpf([0, 0])
    return mp.iv.exp(-log_w_iv(u_iv))

def get_global_max_certified(func_type, start, end, num_intervals=100):
    max_ub = mp.mpf('0')
    best_interval = None
    
    # توزيع غير منتظم
    if func_type == 'minus':
        intervals = [start + (end-start) * (i/num_intervals)**2 for i in range(num_intervals+1)]
    else:
        intervals = [start + (end-start) * (1 - (1 - i/num_intervals)**2) for i in range(num_intervals+1)]
        intervals[0] = start
    
    for i in range(num_intervals):
        x1 = intervals[i]
        x2 = intervals[i+1]
        
        x1_iv = mp.iv.mpf([x1, x1])
        x2_iv = mp.iv.mpf([x2, x2])
        
        try:
            if func_type == 'minus':
                I1 = mp.iv.quad(w_iv, [mp.iv.mpf([0,0]), x2_iv], maxdegree=5)
                I2 = mp.iv.quad(inv_w_iv, [x1_iv, m_iv], maxdegree=5)
            else:
                I1 = mp.iv.quad(w_iv, [x1_iv, L_iv], maxdegree=5)
                I2 = mp.iv.quad(inv_w_iv, [m_iv, x2_iv], maxdegree=5)
            
            ub = I1.b * I2.b
            
            if ub > max_ub and mp.isfinite(ub):
                max_ub = ub
                best_interval = (x1, x2)
                
        except Exception as e:
            # تجاهل الأخطاء عند الأطراف البعيدة جداً
            pass
            
    return max_ub, best_interval

print("\n2. حساب الشهادة (Certified Bounds) بالفترات...")
print("قد يستغرق دقيقة أو دقيقتين...")
start_time = time.time()

# تقليص المجال لتجنب انفجار 1/w عند الصفر و L
# القمة B- عند 4.1، والقمة B+ عند 5.4، لذا مجال [0.1, L-0.1] آمن تماماً
start_minus = mp.mpf('0.1')
end_minus = m_num - mp.mpf('0.1')
start_plus = m_num + mp.mpf('0.1')
end_plus = L - mp.mpf('0.1')

B_minus_ub, int_minus = get_global_max_certified('minus', start_minus, end_minus, num_intervals=100)
B_plus_ub, int_plus = get_global_max_certified('plus', start_plus, end_plus, num_intervals=100)

B_ub = max(B_minus_ub, B_plus_ub)
lambda_certified = 1 / (4 * B_ub)

print("\n" + "="*60)
print("الشهادة الرياضية المضمونة (CERTIFIED BOUNDS)")
print("="*60)
print(f"الحد الأعلى المضمون لـ B_- : {mp.nstr(B_minus_ub, 10)}")
if int_minus:
    print(f"  (عند الفترة {mp.nstr(int_minus[0],4)} إلى {mp.nstr(int_minus[1],4)})")
else:
    print("  (لم يتم العثور على قمة في المجال المحدد - خطأ)")

print(f"الحد الأعلى المضمون لـ B_+ : {mp.nstr(B_plus_ub, 10)}")
if int_plus:
    print(f"  (عند الفترة {mp.nstr(int_plus[0],4)} إلى {mp.nstr(int_plus[1],4)})")
else:
    print("  (لم يتم العثور على قمة في المجال المحدد - خطأ)")

print("-" * 60)
print(f"B_upper (شهادة) = {mp.nstr(B_ub, 10)}")
print(f"lambda_1 (شهادة) >= 1 / (4 * B_upper) = {mp.nstr(lambda_certified, 10)}")
print("="*60)
print(f"الوقت المستغرق: {time.time() - start_time:.2f} ثانية")



