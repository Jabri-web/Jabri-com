from fractions import Fraction as F
from math import factorial

# --------------------------------------------------
# 1. Rigorous interval for pi: Machin formula
# pi = 16 atan(1/5) - 4 atan(1/239)
# Alternating-series enclosure
# --------------------------------------------------

def atan_inv_bounds(q, N):
    x = F(1, q)
    s = sum(
        ((-1)**k) * x**(2*k+1) / (2*k+1)
        for k in range(N+1)
    )
    nxt = ((-1)**(N+1)) * x**(2*N+3) / (2*N+3)
    return min(s, s+nxt), max(s, s+nxt)

a5_lo, a5_hi = atan_inv_bounds(5, 30)
a239_lo, a239_hi = atan_inv_bounds(239, 10)

pi_lo = 16*a5_lo - 4*a239_hi
pi_hi = 16*a5_hi - 4*a239_lo

# --------------------------------------------------
# 2. Rigorous interval for e
# e = sum(1/n!)
# Geometric bound for the remaining positive tail
# --------------------------------------------------

def e_bounds(N=30):
    s = sum((F(1, factorial(k)) for k in range(N+1)), F(0))
    first = F(1, factorial(N+1))
    rem = first / (1 - F(1, N+2))
    return s, s+rem

e_lo, e_hi = e_bounds(30)

# --------------------------------------------------
# 3. Exact interval arithmetic for u0 and a
# --------------------------------------------------

mH = F("4.94223829")

u0_lo = 2*pi_lo/e_hi
u0_hi = 2*pi_hi/e_lo

a_lo = 4*pi_lo/21
a_hi = 4*pi_hi/21

L_lo = 2*pi_lo
L_hi = 2*pi_hi

# --------------------------------------------------
# 4. Rigorous logarithm enclosure
# log(x) = 2 sum z^(2k+1)/(2k+1)
# z = (x-1)/(x+1)
# Remainder:
# 2*z^(2N+3)/((2N+3)*(1-z^2))
# --------------------------------------------------

def log_bounds(x, N=30):
    z = (x-1)/(x+1)
    assert 0 < z < 1

    s = 2*sum(
        (z**(2*k+1)/F(2*k+1) for k in range(N+1)),
        F(0)
    )

    rem = (
        2*z**(2*N+3) /
        (F(2*N+3)*(1-z*z))
    )
    return s, s+rem

x_lo = L_lo/mH
x_hi = L_hi/mH

ell_lo = log_bounds(x_lo, 30)[0]
ell_hi = log_bounds(x_hi, 30)[1]

# --------------------------------------------------
# 5. Rigorous exponential enclosure
# exp(x) Taylor series with geometric tail bound
# --------------------------------------------------

def exp_bounds(x, N=30):
    s = sum(
        (x**k/F(factorial(k)) for k in range(N+1)),
        F(0)
    )

    first = x**(N+1)/F(factorial(N+1))
    rem = first/(1-x/F(N+2))

    return s, s+rem

y_lo = 2*e_lo/21
y_hi = 2*e_hi/21

exp_lo = exp_bounds(y_lo, 30)[0]
exp_hi = exp_bounds(y_hi, 30)[1]

# --------------------------------------------------
# 6. P(t), decreasing for t > 0
# --------------------------------------------------

def P(t):
    return 56/t**2 - 30/t**3 + 6/t**4

# Since P is decreasing:
P_lo = P(ell_hi)
P_hi = P(ell_lo)

# --------------------------------------------------
# 7. C0 upper and lower enclosure
# C0 = (mH-u0)*exp(2e/21)*u0^(-8)*P(ell)
# All factors are positive.
# --------------------------------------------------

C0_lo = (
    (mH-u0_hi) * exp_lo *
    (1/u0_hi**8) * P_lo
)

C0_hi = (
    (mH-u0_lo) * exp_hi *
    (1/u0_lo**8) * P_hi
)

# --------------------------------------------------
# 8. CB2 = u0^7 * C0 / a^2
# --------------------------------------------------

CB2_lo = (u0_lo**7/a_hi**2)*C0_lo
CB2_hi = (u0_hi**7/a_lo**2)*C0_hi

# --------------------------------------------------
# 9. Outward decimal display from exact fractions
# Lower endpoint rounded down, upper rounded up
# --------------------------------------------------

def decimal_floor(q, digits=18):
    scale = 10**digits
    z = q*scale
    k = z.numerator // z.denominator
    return f"{k//scale}.{k%scale:0{digits}d}"

def decimal_ceil(q, digits=18):
    scale = 10**digits
    z = q*scale
    k = -((-z.numerator)//z.denominator)
    return f"{k//scale}.{k%scale:0{digits}d}"

def show_interval(name, lo, hi):
    print(
        name, "in [",
        decimal_floor(lo), ", ",
        decimal_ceil(hi), "]"
    )

