t2_lo, t2_hi = t_lo*t_lo, t_hi*t_hi

CA_star_lo = 208 + (F(13,1024))*t2_lo + 1612*t2_lo + F(208,4096)
CA_star_hi = 208 + (F(13,1024))*t2_hi + 1612*t2_hi + F(208,4096)
