///_________نسخه خفيغة
from fractions import Fraction as F
from math import factorial

N = 15  # خفيف، والباقي لا يزال ~1e-16

def log_bounds_pos(x):
    z = (x-1)/(x+1)
    s = 2*sum((z**(2*k+1)/F(2*k+1) for k in range(N+1)), F(0))
    rem = 2*z**(2*N+3) / (F(2*N+3)*(1-z*z))
    return s, s+rem

def log_bounds(x):
    if x == 1:
        return F(0), F(0)
    if x > 1:
        return log_bounds_pos(x)
    lo, hi = log_bounds_pos(1/x)
    return -hi, -lo

def exp_bounds_pos(x):
    s = sum((x**k/F(factorial(k)) for k in range(N+1)), F(0))
    first = x**(N+1)/F(factorial(N+1))
    rem = first/(1-x/F(N+2))
    return s, s+rem

def exp_bounds(x):
    if x >= 0:
        return exp_bounds_pos(x)
    lo, hi = exp_bounds_pos(-x)
    return 1/hi, 1/lo

def atan_inv_bounds(q, NN):
    x = F(1, q)
    s = sum(((-1)**k) * x**(2*k+1) / (2*k+1) for k in range(NN+1))
    nxt = ((-1)**(NN+1)) * x**(2*NN+3) / (2*NN+3)
    return min(s, s+nxt), max(s, s+nxt)

def e_bounds():
    s = sum((F(1, factorial(k)) for k in range(N+1)), F(0))
    first = F(1, factorial(N+1))
    rem = first / (1 - F(1, N+2))
    return s, s+rem

def decimal_ceil(q, digits=12):
    scale = 10**digits
    z = q*scale
    k = -((-z.numerator)//z.denominator)
    return f"{k//scale}.{k%scale:0{digits}d}"

def decimal_floor(q, digits=12):
    scale = 10**digits
    z = q*scale
    k = z.numerator // z.denominator
    return f"{k//scale}.{k%scale:0{digits}d}"

# ثوابت مرة واحدة
a5_lo, a5_hi = atan_inv_bounds(5, 15)
a239_lo, a239_hi = atan_inv_bounds(239, 8)
pi_lo = 16*a5_lo - 4*a239_hi
pi_hi = 16*a5_hi - 4*a239_lo
e_lo, e_hi = e_bounds()
L_lo, L_hi = 2*pi_lo, 2*pi_hi
a_lo, a_hi = 4*pi_lo/21, 4*pi_hi/21
mL = F("4.94023829")
mH = F("4.94223829")
delta_m = F(1,10)

# 1. رتابة
ell_mH_lo = log_bounds(L_lo/mH)[0]
bracket_lo = 10 - 2/ell_mH_lo
deriv_lo = bracket_lo / mH
print(f"(log w)'_lo = {decimal_floor(deriv_lo, 12)}")
print(f"w increasing ? {deriv_lo > 0}")

# 2. w bounds
def log_w_bounds(u_lo, u_hi):
    t1_lo = log_bounds(u_lo/L_hi)[0]
    t1_hi = log_bounds(u_hi/L_lo)[1]
    ell_lo = log_bounds(L_lo/u_hi)[0]
    ell_hi = log_bounds(L_hi/u_lo)[1]
    t2_lo = log_bounds(ell_lo)[0]
    t2_hi = log_bounds(ell_hi)[1]
    return (10*t1_lo + 2*t2_lo - a_hi/u_lo,
            10*t1_hi + 2*t2_hi - a_lo/u_hi)

def w_bounds(u_lo, u_hi):
    lw_lo, lw_hi = log_w_bounds(u_lo, u_hi)
    return exp_bounds(lw_lo)[0], exp_bounds(lw_hi)[1]

w4_lo, w4_hi = w_bounds(F(4), F(4))
mu_J_lo = F(1,2) * w4_lo
print(f"w(4) in [{decimal_floor(w4_lo, 12)}, {decimal_ceil(w4_hi, 12)}]")
print(f"mu_J_lo = {decimal_floor(mu_J_lo, 12)}")

w_mminus_hi = w_bounds(mH-delta_m, mH-delta_m)[1]
w_m_lo = w_bounds(mL, mL)[0]
term_hi = (w_mminus_hi**2 / w_m_lo) * delta_m
print(f"w(mH-delta)_hi = {decimal_ceil(w_mminus_hi, 12)}")
print(f"w(mL)_lo = {decimal_floor(w_m_lo, 12)}")
print(f"sup term_hi = {decimal_ceil(term_hi, 12)}")
print(f"sup < inf ? {term_hi < mu_J_lo}")
print(f"h < 0 on [m-0.1, m] ? {term_hi < mu_J_lo}")
print(f"ratio = {decimal_ceil(term_hi/mu_J_lo, 12)}")

