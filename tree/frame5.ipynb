from fractions import Fraction as F
from math import factorial

# --------------------------------------------------
# دوال الإحاطة (Fraction)
# --------------------------------------------------
def atan_inv_bounds(q, N):
    x = F(1, q)
    s = sum(((-1)**k) * x**(2*k+1) / (2*k+1) for k in range(N+1))
    nxt = ((-1)**(N+1)) * x**(2*N+3) / (2*N+3)
    return min(s, s+nxt), max(s, s+nxt)

def e_bounds(N=30):
    s = sum((F(1, factorial(k)) for k in range(N+1)), F(0))
    first = F(1, factorial(N+1))
    rem = first / (1 - F(1, N+2))
    return s, s+rem

def log_bounds(x, N=30):
    z = (x-1)/(x+1)
    assert 0 < z < 1
    s = 2*sum((z**(2*k+1)/F(2*k+1) for k in range(N+1)), F(0))
    rem = 2*z**(2*N+3) / (F(2*N+3)*(1-z*z))
    return s, s+rem

def exp_bounds(x, N=30):
    s = sum((x**k/F(factorial(k)) for k in range(N+1)), F(0))
    first = x**(N+1)/F(factorial(N+1))
    rem = first/(1-x/F(N+2))
    return s, s+rem

def decimal_ceil(q, digits=18):
    scale = 10**digits
    z = q*scale
    k = -((-z.numerator)//z.denominator)
    return f"{k//scale}.{k%scale:0{digits}d}"

def decimal_floor(q, digits=18):
    scale = 10**digits
    z = q*scale
    k = z.numerator // z.denominator
    return f"{k//scale}.{k%scale:0{digits}d}"

# --------------------------------------------------
# الثوابت الأساسية
# --------------------------------------------------
a5_lo, a5_hi = atan_inv_bounds(5, 30)
a239_lo, a239_hi = atan_inv_bounds(239, 10)
pi_lo = 16*a5_lo - 4*a239_hi
pi_hi = 16*a5_hi - 4*a239_lo
e_lo, e_hi = e_bounds(30)

L_lo, L_hi = 2*pi_lo, 2*pi_hi
a_lo, a_hi = 4*pi_lo/21, 4*pi_hi/21
u0_lo, u0_hi = 2*pi_lo/e_hi, 2*pi_hi/e_lo

mL = F("4.94023829")
mH = F("4.94223829")

# --------------------------------------------------
# 1. C_A من C_A^* المصحح
# C_A^* = 208 + 13/2^10 (1+ln2)^2 + 1612 (1+ln2)^2 + 208/2^12
# --------------------------------------------------
ln2_lo, ln2_hi = log_bounds(F(2), 30)
t_lo, t_hi = 1+ln2_lo, 1+ln2_hi
t2_lo, t2_hi = t_lo*t_lo, t_hi*t_hi

CA_star_lo = 208 + F(13,1024)*t2_lo + 1612*t2_lo + F(208,4096)
CA_star_hi = 208 + F(13,1024)*t2_hi + 1612*t2_hi + F(208,4096)
CA_hi = CA_star_hi / (a_lo**3)

# --------------------------------------------------
# 2. C_{B,1} = 37044 / (pi^2 e^2)
# --------------------------------------------------
CB1_hi = F(37044) / (pi_lo**2 * e_lo**2)

# --------------------------------------------------
# 3. C_{B,2} من الإحاطة الأصلية (C0)
# C0 = (mH-u0)*exp(2e/21)*u0^-8*P(ell)
# P(t) = 56/t^2 - 30/t^3 + 6/t^4, متناقصة
# --------------------------------------------------
x_lo, x_hi = L_lo/mH, L_hi/mH
ell_lo = log_bounds(x_lo, 30)[0]
ell_hi = log_bounds(x_hi, 30)[1]
y_lo, y_hi = 2*e_lo/21, 2*e_hi/21
exp_lo = exp_bounds(y_lo, 30)[0]
exp_hi = exp_bounds(y_hi, 30)[1]

def P(t):
    return 56/t**2 - 30/t**3 + 6/t**4

P_lo = P(ell_hi)
P_hi = P(ell_lo)

C0_lo = (mH-u0_hi)*exp_lo*(1/u0_hi**8)*P_lo
C0_hi = (mH-u0_lo)*exp_hi*(1/u0_lo**8)*P_hi

CB2_lo = (u0_lo**7/a_hi**2)*C0_lo
CB2_hi = (u0_hi**7/a_lo**2)*C0_hi

# --------------------------------------------------
# 4. C_{B,3} من epsilon_m بحاصل ضرب الأعظميات المنفصلة
# |eps_m| <= term1_hi + term2_hi
# term1: mL^-8 * ell(mH)_lo^-2 * exp(a_hi/mL)_hi / a_lo
# term2: mL^-7 * ell(mH)_lo^-2 * (2/ell_H_lo - 8) * exp_hi / a_lo^2
# --------------------------------------------------
xH_lo = L_lo/mH
ell_H_lo = log_bounds(xH_lo, 30)[0]
exp_eps_hi = exp_bounds(a_hi/mL, 30)[1]

term1_hi = (mL**-8) * (ell_H_lo**-2) * exp_eps_hi / a_lo
term2_hi = (mL**-7) * (ell_H_lo**-2) * (2/ell_H_lo - 8) * exp_eps_hi / (a_lo**2)
eps_m_hi = term1_hi + term2_hi
CB3_hi = (u0_hi**7) * eps_m_hi

# --------------------------------------------------
# 5. التجميع
# --------------------------------------------------
C_total_hi = CA_hi + CB1_hi + CB2_hi + CB3_hi

print("=== الشهادة الفترية النهائية (Fraction) ===")
print(f"C_A^* in [{decimal_floor(CA_star_lo, 18)}, {decimal_ceil(CA_star_hi, 18)}]")
print(f"C_A hi = {decimal_ceil(CA_hi, 18)}")
print(f"C_B1 hi = {decimal_ceil(CB1_hi, 18)}")
print(f"C_B2 in [{decimal_floor(CB2_lo, 18)}, {decimal_ceil(CB2_hi, 18)}]")
print(f"C_B3 hi = {decimal_ceil(CB3_hi, 18)}")
print(f"C_total hi = {decimal_ceil(C_total_hi, 18)}")

# --------------------------------------------------
# 6. delta_0_max بالاتجاه الصحيح
# نحتاج مقاماً أعلى لضمان delta_0 آمن:
# delta_0_safe = 2 / (C_total_hi * L_hi^10 * a_hi^2)
# --------------------------------------------------
delta_0_safe = F(2) / (C_total_hi * (L_hi**10) * (a_hi**2))
print(f"\ndelta_0_safe (L_hi, a_hi) = {decimal_ceil(delta_0_safe, 18)}")
print(f"approx = {float(delta_0_safe):.6e}")

# --------------------------------------------------
# 7. اختبار الشرط النهائي لإشارة h
# ratio = C_total_hi * L_hi^10 * a_hi^2 / 4 * delta_0 <= 1/2
# --------------------------------------------------
delta_0_test = F(227, 10**14)  # 2.27e-12
ratio = C_total_hi * (L_hi**10) * (a_hi**2) / F(4) * delta_0_test
print(f"\nTest delta_0 = 2.27e-12:")
print(f"ratio = {decimal_ceil(ratio, 18)}")
print(f"ratio < 1/2 ? {ratio < F(1,2)}")
print(f"h(x) > 0 on (0, 2.27e-12] ? {ratio < F(1,2)}")


