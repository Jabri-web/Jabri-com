import numpy as np
from scipy.linalg import eigh
from numpy.polynomial.legendre import leggauss  # <-- التصحيح هنا

L = 2.0 * np.pi
a = 4.0 * np.pi / 21.0
analytical_lower_bound = 0.811611  # تقدير عددي، ليس حداً مضموناً بعد

def weight(u):
    u = np.clip(np.asarray(u), 1e-15, L - 1e-15)
    return (u / L)**10 * np.log(L / u)**2 * np.exp(-a / u)

def assemble(eps, n_elements=1000, quad_order=8):
    left, right = eps, L - eps
    nodes = np.linspace(left, right, n_elements + 1)
    Q = np.zeros((n_elements + 1, n_elements + 1))
    M = np.zeros_like(Q)
    b = np.zeros(n_elements + 1)
    z, wz = leggauss(quad_order)  # <-- التصحيح هنا

    for e in range(n_elements):
        x0, x1 = nodes[e], nodes[e+1]
        he = x1 - x0
        xq = 0.5*(x0+x1) + 0.5*he*z
        wq = 0.5*he*wz*weight(xq)
        N0 = (x1 - xq)/he; N1 = (xq - x0)/he
        dN = np.array([-1.0/he, 1.0/he])
        N = np.vstack([N0, N1])
        Me = np.zeros((2,2)); Qe = np.zeros((2,2)); be = np.zeros(2)
        for i in range(2):
            for j in range(2):
                Me[i,j] = np.sum(wq * N[i] * N[j])
                Qe[i,j] = np.sum(wq * dN[i] * dN[j])
            be[i] = np.sum(wq * N[i])
        ids = [e, e+1]
        M[np.ix_(ids, ids)] += Me
        Q[np.ix_(ids, ids)] += Qe
        b[ids] += be
    return nodes, Q, M, b

def constrained_eigenvalue(Q, M, b):
    n = len(b)
    k = np.argmax(np.abs(b))
    keep = np.array([i for i in range(n) if i != k])
    T = np.zeros((n, n-1))
    T[keep, np.arange(n-1)] = 1.0
    T[k, :] = -b[keep] / b[k]
    Qr = T.T @ Q @ T
    Mr = T.T @ M @ T
    val = eigh(Qr, Mr, subset_by_index=[0,0], check_finite=False)[0][0]
    return val

for eps in [1e-3, 1e-4, 1e-5]:
    nodes, Q, M, b = assemble(eps, n_elements=1000, quad_order=8)
    lam = constrained_eigenvalue(Q, M, b)
    status = "PASS ✅" if lam >= analytical_lower_bound else "FAIL ❌"
    print(f"eps = {eps:.1e} | lambda_1 = {lam:.8f} | {status}")
    
    
