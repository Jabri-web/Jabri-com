    import mpmath as mp

# دقة عالية لضمان عدم انهيار الفترات
mp.iv.dps = 50

# الثوابت كفواصل
L = 2 * mp.iv.pi
a = 4 * mp.iv.pi / 21
m = mp.iv.mpf(['4.94023829', '4.94223829'])

# دالة الوزن كفاصل
def w_iv(x):
    if x.a <= 0:
        return mp.iv.mpf([0, 0])
    ell = mp.iv.log(L / x)
    return mp.iv.exp(10 * mp.iv.log(x / L) + 2 * mp.iv.log(ell) - a / x)

# M(x) = \int_0^x w(u) du
def M_iv(x):
    # لتجنب التكامل من الصفر (حيث w(u) صغيرة جداً)، نبدأ من eps
    eps = mp.mpf('1e-10')
    if x.b <= eps:
        # في هذه الحالة التكامل كله صغير جداً، نحده
        return mp.iv.mpf([0, eps * w_iv(mp.iv.mpf([eps, eps])).b])
    
    # التكامل من eps إلى x
    I_eps = mp.iv.quad(lambda u: w_iv(u), [eps, x])
    # الحد الأعلى للتكامل من 0 إلى eps هو eps * max(w(u))
    bound = eps * w_iv(mp.iv.mpf([eps, eps])).b
    return I_eps + mp.iv.mpf([0, bound])

# R(x) = \int_x^m 1/w(u) du
def R_iv(x):
    return mp.iv.quad(lambda u: 1 / w_iv(u), [x, m])

# h(x) = w(x)^2 R(x) - M(x)
def h_iv(x):
    return w_iv(x)**2 * R_iv(x) - M_iv(x)

# h'(x) = 2w(x)(w'(x) R(x) - 1)
def h_prime_iv(x):
    ell = mp.iv.log(L / x)
    lw_prime = 10 / x - 2 / (x * ell) + a / (x**2)
    w_prime = w_iv(x) * lw_prime
    return 2 * w_iv(x) * (w_prime * R_iv(x) - 1)

# خوارزمية Interval Newton
def interval_newton(X0, max_iter=20):
    print(f"Starting Interval Newton on X0 = [{mp.nstr(X0.a, 10)}, {mp.nstr(X0.b, 10)}]")
    X = X0
    for i in range(max_iter):
        mid = (X.a + X.b) / 2
        mid_pt = mp.iv.mpf([mid, mid])
        
        # حساب h عند نقطة المنتصف، و h' على الفترة كاملة
        h_mid = h_iv(mid_pt)
        hp_X = h_prime_iv(X)
        
        # التحقق من أن المشتقة لا تحتوي على الصفر (شرط أساسي)
        if hp_X.a <= 0 <= hp_X.b:
            print(f"  Iter {i+1}: Derivative interval contains 0. Cannot proceed safely.")
            return None
        
        # خطوة نيوتن: N(X) = mid - h(mid) / h'(X)
        N = mid_pt - h_mid / hp_X
        
        # التقاطع مع الفترة الأصلية
        new_X = mp.iv.mpf([max(X.a, N.a), min(X.b, N.b)])
        
        # التحقق من عدم وجود جذر (تقاطع فارغ)
        if new_X.a > new_X.b:
            print(f"  Iter {i+1}: Empty intersection. No root in this interval.")
            return None
            
        print(f"  Iter {i+1}: X = [{mp.nstr(new_X.a, 15)}, {mp.nstr(new_X.b, 15)}], width = {mp.nstr(new_X.b - new_X.a, 5)}")
        
        # شرط الوحدانية: إذا كان N(X) بداخل X، يوجد جذر وحيد
        if N.a > X.a and N.b < X.b:
            print(f"\n✅ Uniqueness condition met at iter {i+1}. Unique root isolated!")
            return new_X
            
        # شرط التوقف عند الدقة الكافية
        if new_X.b - new_X.a < mp.mpf('1e-25'):
            print(f"\n✅ Root isolated to high precision (width < 1e-25)!")
            return new_X
            
        X = new_X
        
    print("\n⚠️ Max iterations reached without satisfying uniqueness condition.")
    return X

# المجال الأولي (حول القمة المتوقعة لـ B_-)
X0 = mp.iv.mpf(['4.1050', '4.1056'])

print("Starting Interval Newton...")
root_enclosure = interval_newton(X0)

if root_enclosure is not None:
    print("\n=========================================")
    print("Final enclosure for x_*:")
    print(f"x_* ∈ [{mp.nstr(root_enclosure.a, 30)}, {mp.nstr(root_enclosure.b, 30)}]")
    print("=========================================")
    print(f"\nVerifying h(x_*) contains 0:")
    h_val = h_iv(root_enclosure)
    print(f"h(x_*) ∈ [{mp.nstr(h_val.a, 10)}, {mp.nstr(h_val.b, 10)}]")
    if h_val.a <= 0 <= h_val.b:
        print("✅ h(x_*) interval contains 0. Consistent with root.")
        
        
