
import numpy as np
from scipy.linalg import eigh
from scipy.integrate import roots_legendre

# --------------------------------------------------
# Weight
# --------------------------------------------------

L = 2.0 * np.pi
a = 4.0 * np.pi / 21.0

def weight(u):
    u = np.asarray(u)
    return (
        (u / L)**10
        * np.log(L / u)**2
        * np.exp(-a / u)
    )

# --------------------------------------------------
# Assemble P1 finite-element matrices
# --------------------------------------------------

def assemble(eps, n_elements=1000, quad_order=8):

    left = eps
    right = L - eps

    nodes = np.linspace(left, right, n_elements + 1)
    h = np.diff(nodes)

    Q = np.zeros((n_elements + 1, n_elements + 1))
    M = np.zeros_like(Q)
    b = np.zeros(n_elements + 1)

    # Gauss-Legendre quadrature
    z, wz = roots_legendre(quad_order)

    for e in range(n_elements):

        x0 = nodes[e]
        x1 = nodes[e + 1]
        he = x1 - x0

        xq = 0.5 * (x0 + x1) + 0.5 * he * z
        wq = 0.5 * he * wz * weight(xq)

        # P1 basis functions
        N0 = (x1 - xq) / he
        N1 = (xq - x0) / he

        # Derivatives
        dN = np.array([-1.0 / he, 1.0 / he])

        Me = np.zeros((2, 2))
        Qe = np.zeros((2, 2))
        be = np.zeros(2)

        N = np.vstack([N0, N1])

        for i in range(2):
            for j in range(2):
                Me[i, j] = np.sum(wq * N[i] * N[j])
                Qe[i, j] = np.sum(wq * dN[i] * dN[j])

            be[i] = np.sum(wq * N[i])

        ids = [e, e + 1]

        M[np.ix_(ids, ids)] += Me
        Q[np.ix_(ids, ids)] += Qe
        b[ids] += be

    return nodes, Q, M, b

# --------------------------------------------------
# Enforce weighted mean zero
# Eliminate one degree of freedom
# --------------------------------------------------

def constrained_eigenvalue(Q, M, b):

    n = len(b)

    # Eliminate the degree of freedom with largest b
    k = np.argmax(np.abs(b))

    keep = np.array([i for i in range(n) if i != k])

    # x_k = - sum_{i != k} b_i x_i / b_k
    T = np.zeros((n, n - 1))

    T[keep, np.arange(n - 1)] = 1.0
    T[k, :] = -b[keep] / b[k]

    Qr = T.T @ Q @ T
    Mr = T.T @ M @ T

    # Smallest generalized eigenvalue on mean-zero subspace
    vals = eigh(Qr, Mr, subset_by_index=[0, 0],
                check_finite=False)[0]

    return vals[0]

# --------------------------------------------------
# Run experiment
# --------------------------------------------------

eps_values = [1e-3, 1e-4, 1e-5]

for eps in eps_values:

    nodes, Q, M, b = assemble(
        eps,
        n_elements=500,
        quad_order=8
    )

    lam = constrained_eigenvalue(Q, M, b)

    print(f"eps = {eps:.1e}, lambda = {lam:.10f}")



