import mpmath as mp
import time

# 1. إعداد الدقة العالية
mp.mp.dps = 30

L = mp.mpf('6.283185307179586476925286766559')
a = mp.mpf('0.598398600683770162417096337587') # 4*pi/21

# 2. تعريف الدالة اللوغاريتمية (للتعامل مع الأعداد الصغيرة جداً)
def log_w(u):
    if u <= 0 or u >= L: return mp.ninf
    q = mp.log(L / u)
    if q <= 0: return mp.ninf
    return 10 * mp.log(u / L) + 2 * mp.log(q) - a / u

def w_iv(u):
    # تحويل الدالة لتعمل مع الفترات
    if u.a <= 0 or u.b >= L:
        return mp.iv.mpf([0, 0]) # نرجع صفراً في الأطراف لتجنب الأخطاء
    lw = log_w(u)
    if not mp.isfinite(lw): return mp.iv.mpf([0, 0])
    return mp.iv.exp(lw)

# 3. دالة التكامل بالفترات
def integral_iv(func, a_bound, b_bound):
    # نقسم التكامل داخلياً لضمان الدقة
    return mp.iv.quad(func, [a_bound, b_bound], maxdegree=8)

# 4. البحث عن الوسيط m
# نحسبه بدقة عالية باستخدام mpmath العادي (لأنه مجرد رقم وليس فترة)
def w_num(u):
    lw = log_w(u)
    if lw < -700: return mp.mpf('0')
    return mp.exp(lw)

M = mp.quad(w_num, [0, L])
m = mp.findroot(lambda x: mp.quad(w_num, [0, x]) - M/2, (1, L-1))

print(f"الكتلة الكلية M = {mp.nstr(M, 15)}")
print(f"الوسيط m = {mp.nstr(m, 15)}")

# 5. إثبات القيمة العظمى العالمية (Branch and Bound)
def get_global_max(func_type, start, end, num_intervals=1000):
    max_upper_bound = mp.iv.mpf(0)
    best_x_lower = start
    
    step = (end - start) / num_intervals
    
    for i in range(num_intervals):
        x1 = start + i * step
        x2 = start + (i + 1) * step
        
        # نحسب التكاملات بالفترات
        if func_type == 'minus':
            M1 = integral_iv(w_iv, 0, x1)
            M2 = integral_iv(w_iv, 0, x2)
            R1 = integral_iv(lambda u: 1/w_iv(u), x1, m)
            R2 = integral_iv(lambda u: 1/w_iv(u), x2, m)
        else:
            M1 = integral_iv(w_iv, x1, L)
            M2 = integral_iv(w_iv, x2, L)
            R1 = integral_iv(lambda u: 1/w_iv(u), m, x1)
            R2 = integral_iv(lambda u: 1/w_iv(u), m, x2)
            
        # الحد الأعلى المضمون على هذه الفترة هو M(x2) * R(x1)
        # (لأن M متزايد و R متناقص)
        try:
            ub = M2.b * R1.b # نأخذ الحد الأعلى للفترتين
            if ub > max_upper_bound:
                max_upper_bound = ub
                best_x_lower = x1
        except:
            pass
            
    return max_upper_bound, best_x_lower

print("\nجاري حساب الشهادة المضمونة (Certified Bound)...")
print("قد يستغرق هذا بضع دقائق...")

start_time = time.time()

# حساب B_- المضمون
B_minus_upper, x_minus = get_global_max('minus', mp.mpf('0.01'), m - mp.mpf('0.01'), num_intervals=500)
# حساب B_+ المضمون
B_plus_upper, x_plus = get_global_max('plus', m + mp.mpf('0.01'), L - mp.mpf('0.01'), num_intervals=500)

B_upper = max(B_minus_upper, B_plus_upper)
lambda_lower_certified = 1 / (4 * B_upper)

print("\n" + "="*60)
print("الشهادة الرياضية المضمونة (CERTIFIED BOUNDS)")
print("="*60)
print(f"الحد الأعلى المضمون لـ B_- : {mp.nstr(B_minus_upper, 15)}")
print(f"الحد الأعلى المضمون لـ B_+ : {mp.nstr(B_plus_upper, 15)}")
print("-" * 60)
print(f"الحد الأعلى المضمون لـ B   : {mp.nstr(B_upper, 15)}")
print(f"الحد الأدنى المضمون للفجوة (lambda_1):")
print(f"lambda_1 >= 1 / (4 * B_upper) = {mp.nstr(lambda_lower_certified, 15)}")
print("="*60)
print(f"الوقت المستغرق: {time.time() - start_time:.2f} ثانية")

