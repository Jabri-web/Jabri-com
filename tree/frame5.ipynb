import mpmath as mp

mp.mp.dps = 50
mp.iv.dps = 50

L_iv = 2 * mp.iv.pi
a_iv = 4 * mp.iv.pi / 21
m_val = mp.mpf('4.94123829')
m_iv = mp.iv.mpf([m_val, m_val])

def w_iv(u):
    if u.b <= 0: return mp.iv.mpf([0,0])
    safe_u = mp.iv.mpf([max(u.a, mp.mpf('1e-20')), u.b])
    ell = mp.iv.log(L_iv / safe_u)
    return mp.iv.exp(10*mp.iv.log(safe_u / L_iv) + 2*mp.iv.log(ell) - a_iv/safe_u)

# 1. الجذر المحصور من Phase 1 (ناتج المشاكس)
x_lo = mp.mpf('4.10529621059752482830989245342123869188243404')
x_hi = mp.mpf('4.10529621059752482830989245342123916519897717')

# 2. بناء المجاميع العلوية والسفلية بدقة N
N = 5000

def get_M_bounds(x_val, N=5000):
    # M(x) = \int_0^x w(u) du.  (w متزايدة على [0, 4.105])
    du = x_val / N
    M_lo = mp.mpf('0')
    M_hi = mp.mpf('0')
    for i in range(N):
        u_i = i * du
        u_i1 = (i+1) * du
        # الحد الأدنى لـ w(u_i) والحد الأعلى لـ w(u_i1)
        w_i_lo = w_iv(mp.iv.mpf([u_i, u_i])).a
        w_i1_hi = w_iv(mp.iv.mpf([u_i1, u_i1])).b
        M_lo += w_i_lo * du
        M_hi += w_i1_hi * du
    return M_lo, M_hi

def get_R_bounds(x_val, N=5000):
    # R(x) = \int_x^m 1/w(u) du. (1/w متناقصة على [4.105, m])
    du = (m_val - x_val) / N
    R_lo = mp.mpf('0')
    R_hi = mp.mpf('0')
    for i in range(N):
        u_i = x_val + i * du
        u_i1 = x_val + (i+1) * du
        # الحد الأدنى لـ 1/w على [u_i, u_i1] هو 1/w(u_i1). الأعلى هو 1/w(u_i)
        w_i_lo = w_iv(mp.iv.mpf([u_i, u_i])).a
        w_i1_hi = w_iv(mp.iv.mpf([u_i1, u_i1])).b
        R_lo += (1 / w_i1_hi) * du
        R_hi += (1 / w_i_lo) * du
    return R_lo, R_hi

print("Building monotonic bounds for M and R...")
# M متزايدة: [M(x_lo), M(x_hi)]
M_lo_lo, M_lo_hi = get_M_bounds(x_lo)
M_hi_lo, M_hi_hi = get_M_bounds(x_hi)

# R متناقصة: [R(x_hi), R(x_lo)]
R_lo_lo, R_lo_hi = get_R_bounds(x_hi)
R_hi_lo, R_hi_hi = get_R_bounds(x_lo)

M_final_lo = M_lo_lo
M_final_hi = M_hi_hi
R_final_lo = R_lo_lo
R_final_hi = R_hi_hi

# 3. إحاطة B_-(x_*)
B_final_lo = M_final_lo * R_final_lo
B_final_hi = M_final_hi * R_final_hi

print(f"\nM(x_*) ∈ [{mp.nstr(M_final_lo, 15)}, {mp.nstr(M_final_hi, 15)}]")
print(f"R(x_*) ∈ [{mp.nstr(R_final_lo, 15)}, {mp.nstr(R_final_hi, 15)}]")
print(f"B_-(x_*) ∈ [{mp.nstr(B_final_lo, 20)}, {mp.nstr(B_final_hi, 20)}]")

# 4. إثبات الوجود (تغير الإشارة)
w_x_lo_iv = w_iv(mp.iv.mpf([x_lo, x_lo]))
w_x_hi_iv = w_iv(mp.iv.mpf([x_hi, x_hi]))

# h(x) = w(x)^2 R(x) - M(x)
# h(x_lo) الحد الأدنى
h_lo_lower = (w_x_lo_iv.a**2) * R_hi_lo - M_lo_hi
# h(x_hi) الحد الأعلى
h_hi_upper = (w_x_hi_iv.b**2) * R_lo_hi - M_hi_lo

print(f"\nh(x_lo) ≥ {mp.nstr(h_lo_lower, 10)} (must be > 0)")
print(f"h(x_hi) ≤ {mp.nstr(h_hi_upper, 10)} (must be < 0)")

if h_lo_lower > 0 and h_hi_upper < 0:
    print("✅ PROVEN: h(x_lo) > 0 and h(x_hi) < 0 => root EXISTS in X*")

# 5. إثبات الوحدانية (h' < 0)
X_iv = mp.iv.mpf([x_lo, x_hi])
ell_X = mp.iv.log(L_iv / X_iv)
lw_prime = 10/X_iv - 2/(X_iv*ell_X) + a_iv/(X_iv**2)
w_X_iv = w_iv(X_iv)
w_prime_X_iv = w_X_iv * lw_prime

# الحد الأعلى لـ h' = 2w(w'R - 1)
# نستخدم الحد الأعلى لـ w، الحد الأعلى لـ w'، والحد الأعلى لـ R (وهو R_hi_hi)
h_prime_upper = 2 * w_X_iv.b * (w_prime_X_iv.b * R_hi_hi - 1)

print(f"\nh'(X*) ≤ {mp.nstr(h_prime_upper, 10)}")
if h_prime_upper < 0:
    print("✅ PROVEN: h' < 0 on X* => root is UNIQUE")
    
