import mpmath as mp
mp.mp.dps = 50
mp.iv.dps = 50  # نستخدمها بشكل صريح الآن

L_iv = 2 * mp.iv.pi
a_iv = 4 * mp.iv.pi / 21
m_iv = mp.iv.mpf(['4.94123828', '4.94123830'])

def w_iv(u):
    if u.b <= 0: return mp.iv.mpf([0,0])
    safe_u = mp.iv.mpf([max(u.a, mp.mpf('1e-20')), u.b])
    ell = mp.iv.log(L_iv / safe_u)
    return mp.iv.exp(10*mp.iv.log(safe_u / L_iv) + 2*mp.iv.log(ell) - a_iv/safe_u)

# المجال الضيق للجذر (الناتج من Phase 1 للمشاكس)
X_star = mp.iv.mpf(['4.10529621059752482830989245342123869188243404',
                    '4.10529621059752482830989245342123916519897717'])

# 1. إحاطة M(X) = \int_0^X w(u) du
# نجزئ التكامل إلى [0, eps] و [eps, X] لتجنب التفرد
eps = mp.mpf('1e-6')
eps_iv = mp.iv.mpf([eps, eps])

# التكامل من 0 إلى eps محاط بـ [0, eps * w(eps)]
w_eps_hi = w_iv(eps_iv).b
M_lo_part1 = mp.mpf('0')
M_hi_part1 = eps * w_eps_hi

# التكامل من eps إلى X (هنا iv.quad آمن وسريع لأن الدالة ناعمة)
M_part2 = mp.iv.quad(w_iv, [eps_iv, X_star])

M_star_lo = M_lo_part1 + M_part2.a
M_star_hi = M_hi_part1 + M_part2.b

# 2. إحاطة R(X) = \int_X^m 1/w(u) du
# لا يوجد تفرد هنا (X > 4)، لذا iv.quad آمن
R_star = mp.iv.quad(lambda u: 1 / w_iv(u), [X_star, m_iv])

# 3. إحاطة B_-(X) = M(X) * R(X)
# نضرب الحد الأدنى في الحد الأدنى، والأعلى في الأعلى (كلها موجبة)
B_minus_lo = M_star_lo * R_star.a
B_minus_hi = M_star_hi * R_star.b

print("=========================================")
print("Rigorous Interval Enclosures:")
print(f"M(x_*) ∈ [{mp.nstr(M_star_lo, 15)}, {mp.nstr(M_star_hi, 15)}]")
print(f"R(x_*) ∈ [{mp.nstr(R_star.a, 15)}, {mp.nstr(R_star.b, 15)}]")
print(f"B_-(x_*) ∈ [{mp.nstr(B_minus_lo, 15)}, {mp.nstr(B_minus_hi, 15)}]")
print("=========================================")

# 4. التحقق من الوحدانية (h' < 0)
# h' = 2w(w'R - 1)
ell_X = mp.iv.log(L_iv / X_star)
lw_prime = 10/X_star - 2/(X_star*ell_X) + a_iv/(X_star**2)
w_prime = w_iv(X_star) * lw_prime
h_prime_X = 2 * w_iv(X_star) * (w_prime * R_star - 1)

print(f"h'(x_*) ∈ [{mp.nstr(h_prime_X.a, 10)}, {mp.nstr(h_prime_X.b, 10)}]")
if h_prime_X.b < 0:
    print("✅ PROVEN: h' < 0 on X* => root is UNIQUE")

# 5. التحقق من وجود الجذر (h(X) يحتوي 0)
h_X_lo = (w_iv(X_star).a**2) * R_star.a - M_star_hi
h_X_hi = (w_iv(X_star).b**2) * R_star.b - M_star_lo
print(f"\nh(x_*) ∈ [{mp.nstr(h_X_lo, 5)}, {mp.nstr(h_X_hi, 5)}]")
if h_X_lo <= 0 <= h_X_hi:
    print("✅ PROVEN: 0 ∈ h(X*) => root EXISTS in X*")
    
