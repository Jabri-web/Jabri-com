import mpmath as mp
import time

mp.mp.dps = 30

L = mp.mpf('6.283185307179586476925286766559')
a = mp.mpf('0.598398600683770162417096337587')

L_iv = mp.iv.mpf([L, L])
a_iv = mp.iv.mpf([a, a])

print("1. حساب الوسيط m ...")
def w_num(u):
    if u <= 0 or u >= L: return mp.mpf('0')
    return mp.exp(10*mp.log(u/L) + 2*mp.log(mp.log(L/u)) - a/u)

M = mp.quad(w_num, [0, L])
lo, hi = mp.mpf('0.01'), L - mp.mpf('0.01')
for _ in range(60):
    mid = (lo+hi)/2
    if mp.quad(w_num, [0, mid]) < M/2: lo = mid
    else: hi = mid
m = (lo+hi)/2
m_iv = mp.iv.mpf([m, m])
print(f"m = {mp.nstr(m, 10)}")

# دالة الوزن بالفترات
def w_iv(u_iv):
    u_iv = mp.iv.mpf(u_iv)
    q_iv = mp.iv.log(L_iv / u_iv)
    return mp.iv.exp(10 * mp.iv.log(u_iv / L_iv) + 2 * mp.iv.log(q_iv) - a_iv / u_iv)

# دالة المقلوب بالفترات (للاستخدام في B_+)
def inv_w_iv(u_iv):
    u_iv = mp.iv.mpf(u_iv)
    q_iv = mp.iv.log(L_iv / u_iv)
    return mp.iv.exp(-10 * mp.iv.log(u_iv / L_iv) - 2 * mp.iv.log(q_iv) + a_iv / u_iv)

# دالة التعويض v = a/u للاستخدام في B_-
# \int_x^m 1/w(u) du = \int_{a/m}^{a/x} g(v) dv
def g_iv(v_iv):
    v_iv = mp.iv.mpf(v_iv)
    log_arg = L_iv * v_iv / a_iv
    return (L_iv**10 / a_iv**9) * (v_iv**8) * (1.0 / mp.iv.log(log_arg)**2) * mp.iv.exp(v_iv)

def get_certified_max(start, end, N, is_minus):
    max_ub = mp.mpf('0')
    
    # شبكة هندسية لتغطية الأطراف
    r = (end/start)**(mp.mpf('1')/N)
    intervals = [start * r**i for i in range(N+1)]
    
    for i in range(N):
        x1 = intervals[i]
        x2 = intervals[i+1]
        
        x1_iv = mp.iv.mpf([x1, x1])
        x2_iv = mp.iv.mpf([x2, x2])
        
        try:
            if is_minus:
                # M(x2) = \int_0^{x2} w(u) du
                M_iv = mp.iv.quad(w_iv, [mp.iv.mpf([0,0]), x2_iv], maxdegree=5)
                # R(x1) = \int_{a/m}^{a/x1} g(v) dv
                R_iv = mp.iv.quad(g_iv, [a_iv/m_iv, a_iv/x1_iv], maxdegree=5)
            else:
                # M(x1) = \int_{x1}^L w(u) du
                M_iv = mp.iv.quad(w_iv, [x1_iv, L_iv], maxdegree=5)
                # R(x2) = \int_m^{x2} 1/w(u) du
                R_iv = mp.iv.quad(inv_w_iv, [m_iv, x2_iv], maxdegree=5)
                
            ub = M_iv.b * R_iv.b
            
            if ub > max_ub and mp.isfinite(ub):
                max_ub = ub
        except Exception as e:
            pass
            
    return max_ub

print("\n2. حساب الشهادة الرياضية بالفترات (مع تعويض v=a/u)...")
start_time = time.time()

N = 100 # عدد الفترات
start_minus = mp.mpf('0.01')
end_minus = m
