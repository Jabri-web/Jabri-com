import mpmath as mp
import time

# 1. إعداد الدقة
mp.mp.dps = 30  # 30 كافية جداً وتسرع الحسابات
L = 2 * mp.pi
a = 4 * mp.pi / 21

# 2. الدوال الأساسية
def log_w(u):
    if u <= 0 or u >= L: return mp.ninf
    q = mp.log(L / u)
    if q <= 0: return mp.ninf
    return 10 * mp.log(u / L) + 2 * mp.log(q) - a / u

def w(u):
    lw = log_w(u)
    if lw < -700: return mp.mpf('0')
    return mp.exp(lw)

# 3. إيجاد الكتلة والوسيط بـ Bisection
print("جاري حساب الكتلة الكلية...")
M = mp.quad(w, [0, L])

print("جاري إيجاد الوسيط (Bisection)...")
lo, hi = mp.mpf('0.01'), L - mp.mpf('0.01')
for _ in range(60):
    mid = (lo + hi) / 2
    if mp.quad(w, [0, mid]) < M / 2:
        lo = mid
    else:
        hi = mid
m = (lo + hi) / 2
print(f"الكتلة M = {mp.nstr(M, 10)}")
print(f"الوسيط m = {mp.nstr(m, 10)}\n")

# 4. دوال B
def B_minus(x):
    lx = log_w(x)
    I1 = mp.quad(lambda u: mp.exp(log_w(u) - lx), [0, x])
    I2 = mp.quad(lambda u: mp.exp(lx - log_w(u)), [x, m])
    return I1 * I2

def B_plus(x):
    lx = log_w(x)
    I1 = mp.quad(lambda u: mp.exp(log_w(u) - lx), [x, L])
    I2 = mp.quad(lambda u: mp.exp(lx - log_w(u)), [m, x])
    return I1 * I2

# 5. البحث الشبكي اللوغاريتمي
print("=== مسح B_- (شبكة لوغاريتمية) ===")
best_x_minus, best_v_minus = None, mp.mpf('-1')
start_val = mp.mpf('0.01')
for k in range(30): # 30 نقطة كافية للمسح الأولي
    x = mp.exp(mp.log(start_val) + (mp.log(m) - mp.log(start_val)) * k / 29)
    v = B_minus(x)
    print(f"x = {mp.nstr(x, 6):12} | B_- = {mp.nstr(v, 8)}")
    if v > best_v_minus:
        best_v_minus, best_x_minus = v, x

print("\n=== مسح B_+ (شبكة لوغاريتمية) ===")
best_x_plus, best_v_plus = None, mp.mpf('-1')
start_val_plus = m + mp.mpf('0.01')
end_val_plus = L - mp.mpf('0.01')
for k in range(30):
    x = mp.exp(mp.log(start_val_plus) + (mp.log(end_val_plus) - mp.log(start_val_plus)) * k / 29)
    v = B_plus(x)
    print(f"x = {mp.nstr(x, 6):12} | B_+ = {mp.nstr(v, 8)}")
    if v > best_v_plus:
        best_v_plus, best_x_plus = v, x

# 6. الصقل المحلي (Ternary Search) - مضمون
def ternary_search(func, left, right, iterations=30):
    for _ in range(iterations):
        m1 = left + (right - left) / 3
        m2 = right - (right - left) / 3
        if func(m1) < func(m2):
            left = m1
        else:
            right = m2
    return (left + right) / 2, func((left + right) / 2)

print("\nجاري صقل القمم محلياً...")
# نحدد نطاق الصقل حول أفضل نقطة وجدناها (بهامش ±10%)
x_minus_ref, v_minus_ref = ternary_search(B_minus, best_x_minus * mp.mpf('0.9'), best_x_minus * mp.mpf('1.1'))
x_plus_ref, v_plus_ref = ternary_search(B_plus, best_x_plus * mp.mpf('0.9'), best_x_plus * mp.mpf('1.1'))

print("\n" + "="*55)
print("النتائج النهائية (تقدير عددي أولي)")
print("="*55)
print(f"B_- (بعد الصقل): {mp.nstr(v_minus_ref, 15)} عند x = {mp.nstr(x_minus_ref, 10)}")
print(f"B_+ (بعد الصقل): {mp.nstr(v_plus_ref, 15)} عند x = {mp.nstr(x_plus_ref, 10)}")

B_est = max(v_minus_ref, v_plus_ref)
lambda_lower = 1 / (4 * B_est)

print("-" * 55)
print(f"B_est = max(B_-, B_+) = {mp.nstr(B_est, 15)}")
print(f"التقدير العددي للحد الأدنى للفجوة:")
print(f"lambda_1 >= 1/(4 * B_est) = {mp.nstr(lambda_lower, 15)}")
print("="*55)
print("ملاحظة: هذا تقدير عددي (Estimate) وليس شهادة مضمونة (Certified)")
print("حتى الآن، لم يتم حساب حدود الخطأ الصارمة للتكاملات.")


