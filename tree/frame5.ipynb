start_plus = m
end_plus = L - mp.mpf('0.01')
B_plus_ub = get_certified_max(start_plus, end_plus, N, is_minus=False)

B_ub = max(B_minus_ub, B_plus_ub)
lambda_certified = 1 / (4 * B_ub)

print("\n" + "="*60)
