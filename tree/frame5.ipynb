import mpmath as mp
import time

mp.mp.dps = 30

L = mp.mpf('6.283185307179586476925286766559')
a = mp.mpf('0.598398600683770162417096337587')

def log_w(u):
    if u <= 0 or u >= L: return mp.ninf
    q = mp.log(L/u)
    if q <= 0: return mp.ninf
    return 10*mp.log(u/L) + 2*mp.log(q) - a/u

def w(u):
    lw = log_w(u)
    return mp.mpf('0') if lw < -700 else mp.exp(lw)

def inv_w(u):
    lw = log_w(u)
    return mp.mpf('0') if -lw < -700 else mp.exp(-lw)

print("1. حساب الكتلة والوسيط...")
M = mp.quad(w, [0, L])
lo, hi = mp.mpf('0.01'), L - mp.mpf('0.01')
for _ in range(60):
    mid = (lo+hi)/2
    if mp.quad(w, [0, mid]) < M/2: lo = mid
    else: hi = mid
m = (lo+hi)/2
print(f"M = {mp.nstr(M,10)} m = {mp.nstr(m,10)}")

# دالة لحساب الحد الأعلى لأي تكامل
def quad_ub(func, a_b, b_b):
    val, err = mp.quad(func, [a_b, b_b], error=True)
    # نضيف 10 أضعاف الخطأ + هامش أمان صغير جداً
    return val + 10*err + mp.mpf('1e-25')

# دالة للبحث عن القيمة العظمى المضمونة
def get_certified_max(start, end, N, is_minus):
    max_ub = mp.mpf('0')
    step = (end - start) / N
    
    for i in range(N):
        x1 = start + i * step
        x2 = start + (i + 1) * step
        
        if is_minus:
            I1 = quad_ub(w, mp.mpf('0'), x2)
            I2 = quad_ub(inv_w, x1, m)
        else:
            I1 = quad_ub(w, x1, L)
            I2 = quad_ub(inv_w, m, x2)
            
        ub = I1 * I2
        if ub > max_ub:
            max_ub = ub
            
    return max_ub

print("2. حساب الشهادة الرياضية (بدون iv)...")
