import numpy as np
import scipy.sparse as sp
import scipy.sparse.linalg as spla
import matplotlib.pyplot as plt
import pandas as pd
import time

L = 2 * np.pi
a = 4 * np.pi / 21

def w(u):
    u = np.clip(u, 1e-12, L - 1e-12)
    return (u/L)**10 * np.log(L/u)**2 * np.exp(-a/u)

def compute_lambda_and_vectors(N, eps=0.15):
    t = np.linspace(0, 1, N+2)[1:-1]
    x = eps + (L - 2*eps) * t
    x = np.sort(x)
    x_ext = np.concatenate([[eps], x, [L-eps]])

    M = sp.lil_matrix((N, N))
    K = sp.lil_matrix((N, N))

    for i in range(N+1):
        h_e = x_ext[i+1] - x_ext[i]
        x_mid = (x_ext[i] + x_ext[i+1]) / 2
        w_mid = w(x_mid)
        if w_mid < 1e-300: w_mid = 1e-300
        
        for a_idx, b_idx, cm, ck in [
            (i-1, i-1, 1/3, 1), (i-1, i, 1/6, -1),
            (i, i-1, 1/6, -1), (i, i, 1/3, 1)]:
            if 0 <= a_idx < N and 0 <= b_idx < N:
                M[a_idx, b_idx] += w_mid * h_e * cm
                K[a_idx, b_idx] += w_mid / h_e * ck

    M = M.tocsr(); K = K.tocsr()
    K_reg = K + 1e-12 * sp.eye(N, format='csr')

    np.random.seed(42)
    v0 = np.random.rand(N)
    
    vals, vecs = spla.eigsh(K_reg, k=4, M=M, sigma=1e-3, which='LM', v0=v0)
    
    idx = np.argsort(vals)
    return vals[idx], vecs[:, idx], x

# ==========================================
# 1. جمع البيانات (CSV)
# ==========================================
results = []
print("جاري جمع البيانات...")

# اختبار الحساسية (Sensitivity)
for eps in [0.10, 0.15, 0.20, 0.25]:
    vals, vecs, _, _ = compute_lambda_and_vectors(400, eps)
    psi = vecs[:, 1]
    # فحص رالي
    # (نعيد بناء K و M هنا لو أردنا الدقة المطلقة، لكن القيمة الذاتية نفسها كافية)
    results.append({
        'Test': 'Sensitivity',
        'Parameter': f'eps={eps:.2f}',
        'Ground_State': vals[0],
        'Lambda_1 (Excited)': vals[1]
    })

# اختبار التقارب الشبكي (Grid Convergence)
for N in [200, 400, 800]:
    vals, _, _ = compute_lambda_and_vectors(N, 0.15)
    results.append({
        'Test': 'Grid_Convergence',
        'Parameter': f'N={N}',
        'Ground_State': vals[0],
        'Lambda_1 (Excited)': vals[1]
    })

df = pd.DataFrame(results)
df.to_csv('frame5-1.csv', index=False)
print("✅ تم حفظ البيانات في frame5-1.csv")

# ==========================================
# 2. الرسم البياني (PNG)
# ==========================================
print("جاري رسم الدوال الذاتية...")
vals, vecs, x = compute_lambda_and_vectors(800, 0.15)

fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(10, 8), sharex=True)

# اللوحة العلوية: الحالة الأرضية (Ground State)
ax1.plot(x, vecs[:, 0], 'g--', lw=2, label=f'Ground State (\u03bb = {vals[0]:.4f})')
ax1.set_title("Frame 5: Eigenfunctions of the Weighted Operator", fontsize=14)
ax1.set_ylabel("\u03c8(u)", fontsize=12)
ax1.grid(True, alpha=0.3)
ax1.legend()

# اللوحة السفلية: الحالة المثارة (First Excited State)
ax2.plot(x, vecs[:, 1], 'b-', lw=2.5, label=f'First Excited State (\u03bb = {vals[1]:.4f})')
ax2.axhline(0, color='red', linestyle=':', alpha=0.7)
ax2.set_xlabel("u", fontsize=12)
ax2.set_ylabel("\u03c8(u)", fontsize=12)
ax2.grid(True, alpha=0.3)
ax2.legend()

plt.tight_layout()
plt.savefig('frame5-1.png', dpi=300, bbox_inches='tight')
print("✅ تم حفظ الصورة في frame5-1.png")
plt.show()