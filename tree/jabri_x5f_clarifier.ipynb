# 7) 21 — عامل واحد، وليس سر 999999
# ============================================================

def check_21():
    print("=" * 60)
    print("7) ملاحظة 21 — استكشافية فقط")
    print(f"  999999 = 21 × {999999//21}  (صحيح: {999999 == 21*47619})")
    print(f"  تحليل 999999 الكامل: 3³ × 7 × 11 × 13 × 37 = {3**3*7*11*13*37}")
    print(f"  mod 21 : 1015={1015%21} ، 369={369%21} ، 124={124%21} ، 875={875%21}")
    print("  ✓ التوافق mod 21 صحيح حسابياً، لكنه ليس برهان سببية")
    print("  ✓ mod 9 أقوى بنيوياً لأن 10 ≡ 1 (mod 9)، ولا يوجد رابط بنيوي مماثل لـ 21")
    print()

