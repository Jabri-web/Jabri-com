وظيفته فقط: يفصل السياقات عن بعضها حتى لا يختلط:
  1) متمم  (handsa)      : C + A = 999
  2) تطبيع (tree.html)   : Z + C + A = 1  (نسب بين 0 و 1)
  3) هندسة (tree2)       : Z^2 + C^2 = A^2
  4) حروف (char-balance) : كلمة = مجموع قيم أبجد هوز
  5) منحنى موحد (lab01)  : alpha*(theta) = tan(theta)/(tan(theta)+2)
  6) 733  : ليس عدداً فريداً، بل صنف كامل mod 9
  7) 21   : عامل واحد من عوامل 999999، وليس سره
  8) Frame 5 : ادعاء منقول، والكود هنا يفحص تناقض S فقط ولا يحسمه

تشغيل:  python jabri_clarifier.py
"""

import math
from dataclasses import dataclass

# ============================================================
# 0) أدوات عامة: الجذر الرقمي ≠ باقي mod 9
# ============================================================

def digital_root(n: int) -> int:
    """الجذر الرقمي: 1..9 ، مثال: 1872 -> 9"""
    n = abs(int(n))
    if n == 0:
        return 0
    return 1 + (n - 1) % 9

def mod9(n: int) -> int:
    """باقي القسمة على 9: 0..8 ، مثال: 1872 -> 0"""
    return int(n) % 9

def check_root_vs_mod9():
    print("=" * 60)
    print("0) الجذر الرقمي ≠ باقي mod 9 — يفرقان فقط في مضاعفات 9")
    for n in [753, 262, 1015, 1872, 999, 369]:
        print(f"  {n:6d} : جذر={digital_root(n)}  mod9={mod9(n)}")
    assert digital_root(1872) == 9 and mod9(1872) == 0
    print("  ✓ تمييز صحيح: 1872 جذره 9 وباقيه 0")
    print()

# ============================================================
# 1) أبجد هوز — char-balance
# ============================================================

ABJAD = {
    'ا':1,'أ':1,'إ':1,'آ':1,'ء':1,
    'ب':2,'ج':3,'د':4,'ه':5,'و':6,'ؤ':6,'ز':7,
    'ح':8,'ط':9,'ي':10,'ى':10,'ئ':10,
    'ك':20,'ل':30,'م':40,'ن':50,
    'س':60,'ع':70,'ف':80,'ص':90,
    'ق':100,'ر':200,'ش':300,'ت':400,'ة':400,
    'ث':500,'خ':600,'ذ':700,
    'ض':800,'ظ':900,'غ':1000,
}

def abjad_value(word: str) -> int:
    return sum(ABJAD.get(ch, 0) for ch in word)

def check_char_balance():
    print("=" * 60)
    print("1) ميزان الحروف — char-balance")
    z = abjad_value("الذكاء")
    a = abjad_value("الاصطناعي")
    total = z + a
    print(f"  الذكاء = {z} (المتوقع 753)")
    print(f"  الاصطناعي = {a} (المتوقع 262)")
    print(f"  المجموع = {total} (المتوقع 1015)")
    assert z == 753 and a == 262 and total == 1015
    # الجسر: توافق mod 9 فقط، وليس مساواة
    print(f"  الجسر: 1015 mod9 = {mod9(1015)} ، 124 mod9 = {mod9(124)}  -> توافق، مش مساواة")
    assert mod9(1015) == mod9(124) == 7
    print("  ✓ الحروف أرقام، والجسر توافق mod 9 فقط")
    print()

# ============================================================
# 2) المتمم — handsa : لا تخلطه مع التطبيع ولا مع فيثاغورس
# ============================================================

def complement(n: int, k: int) -> int:
    """متمم n في طابق k: sigma_k(n) = (10^k - 1) - n"""
    unit = 10**k - 1
    return unit - n

@dataclass
class ComplementContext:
    """سياق المتمم فقط"""
    k: int
    C: int
    A: int
    @property
    def unit(self): return 10**self.k - 1
    def valid(self): return self.C + self.A == self.unit

@dataclass
class NormalizedContext:
    """سياق التطبيع فقط — tree.html : نسب بين 0 و 1"""
    Z: float; C: float; A: float
    def valid(self): return abs((self.Z + self.C + self.A) - 1.0) < 1e-9

@dataclass
class PythagorasContext:
    """سياق الهندسة فقط — tree2 : ارتفاع / أفقي / وتر"""
    Z: float; C: float; A: float
    def valid(self): return abs(self.Z**2 + self.C**2 - self.A**2) < 1e-6

def check_three_contexts():
    print("=" * 60)
    print("2) ثلاثة سياقات منفصلة لـ Z,C,A — لا تخلط بينها")
    # --- (أ) متمم ---
    comp = ComplementContext(k=3, C=124, A=875)
    print(f"  [متمم handsa]  C+A = {comp.C}+{comp.A} = {comp.C+comp.A} ، الوحدة={comp.unit}  -> {comp.valid()}")
    assert comp.valid()
    print(f"  [متمم]  369 في k=3 متممه = {complement(369,3)} ، وفي k=5 متممه = {complement(369,5)} (وليس 630)")
    assert complement(369,3) == 630 and complement(369,5) == 99630
    # --- (ب) تطبيع ---
    x = math.sqrt(2) - 1  # ≈ 0.41421356
    norm = NormalizedContext(Z=x, C=x, A=x*x)
    print(f"  [تطبيع tree.html] Z=C=x ، A=x² ، Z+C+A = {norm.Z+norm.C+norm.A:.10f} -> {norm.valid()}")
    print(f"      x = √2-1 = {x:.8f} ، وهو حل x²+2x-1=0")
    assert norm.valid()
    # --- (ج) هندسة ---
    pyth = PythagorasContext(Z=192, C=290.74, A=348.42)
    print(f"  [هندسة tree2] Z²+C² = {pyth.Z**2+pyth.C**2:.2f} ، A² = {pyth.A**2:.2f} -> {pyth.valid()}")
    assert pyth.valid()
    print("  ✓ الالتباس الأول محلول: كل سياق له قانونه، ولا يجوز نقل عدد من سياق لآخر")
    print("  ✗ الخطأ الشائع: 369+124+875 = 1368 ≠ 1 ، لأن 369/124/875 أعداد متمم، وليست نسباً مطبّعة")
    print("  ✓ الصياغة الصحيحة للمتمم: C/999 + A/999 = 1")
    print()

# ============================================================
# 3) فيثاغورس: 56.54° مثال عام، و 22.5° حالة خاصة، و 54.7356° زاوية سحرية
# ============================================================

def check_angles():
    print("=" * 60)
    print("3) الزوايا الثلاث — لا تخلط بينها")
    # 22.5°
    t22 = math.tan(math.radians(22.5))
    print(f"  tan(22.5°) = {t22:.8f}  = √2-1 = {math.sqrt(2)-1:.8f}  -> حالة ذهبية")
    assert abs(t22 - (math.sqrt(2)-1)) < 1e-9
    # 56.54° مثال عام
    theta_general = math.degrees(math.atan(290.74/192))
    print(f"  مثال tree2 العام: arctan(290.74/192) = {theta_general:.2f}°  -> مثال فقط، ليس زاوية سحرية")
    # الزاوية السحرية
    theta_m = math.degrees(math.acos(1/math.sqrt(3)))
    print(f"  الزاوية السحرية θm = arccos(1/√3) = {theta_m:.7f}°")
    print(f"  tan(θm) = {math.tan(math.radians(theta_m)):.8f} = √2")
    print(f"  العلاقة: tan(θm) = tan(22.5°) + 1 = {t22+1:.8f}")
    assert abs(theta_m - 54.7356103) < 1e-4
    assert abs(math.tan(math.radians(theta_m)) - (t22+1)) < 1e-9
    print("  ✓ 56.54° ≠ 54.7356° : الأولى مثال فيثاغورس، الثانية زاوية قطر المكعب")
    print()

# ============================================================
# 4) 733 ليس فريداً — صنف كامل mod 9
# ============================================================

def check_733():
    print("=" * 60)
    print("4) مسألة 733 — إزالة وهم الفرادة")
    # المطلوب: عدد n بحيث (1015 + n) ≡ 875 (mod 9)
    # أي: n ≡ 875 - 1015 ≡ 2 - 7 ≡ 4 (mod 9)
    candidates = [n for n in range(0, 2000) if n % 9 == 4]
    print(f"  الشرط الحقيقي: n ≡ 4 (mod 9)")
    print(f"  أمثلة توفي بالغرض: {candidates[:8]} ... و 733 واحد منها فقط")
    print(f"  هل 733 يوفي؟ {733 % 9 == 4} ، (1015+733) mod9 = {mod9(1015+733)} ، 875 mod9 = {mod9(875)}")
    assert 733 in candidates and mod9(1015+733) == mod9(875)
    print("  ✓ التوصية: أعلن 733 'ثابتاً اصطلاحياً' أو احذفه واكتفِ بجسر 1015")
    print("  ✗ لا تقل: 733 مشتق أو فريد — لأنه ليس كذلك")
    print()

# ============================================================
# 5) المنحنى الموحد — lab01
# ============================================================

def alpha_star(theta_deg: float) -> float:
    t = math.tan(math.radians(theta_deg))
    return t / (t + 2)

def check_unified_curve():
    print("=" * 60)
    print("5) المنحنى الموحد — lab01 : alpha*(θ) = tanθ / (tanθ + 2)")
    vals = [
        (22.5, 3 - 2*math.sqrt(2), "Frame 2"),
        (45.0, 1/3, "v0.4"),
        (math.degrees(math.atan(math.sqrt(2))), math.sqrt(2)-1, "الزاوية السحرية"),
    ]
    # نعيد البناء بشكل صريح لتفادي خطأ القائمة أعلاه
    for theta, expected, ctx in [(22.5, 3-2*math.sqrt(2), "Frame 2"),
                                 (45.0, 1/3, "v0.4"),
                                 (54.7356103, math.sqrt(2)-1, "الزاوية السحرية")]:
        got = alpha_star(theta)
        print(f"  θ={theta:>10.4f}° : alpha* = {got:.6f}  (المتوقع {expected:.6f})  [{ctx}]")
        assert abs(got - expected) < 1e-6
    print("  ✓ القيم الثلاث دقيقة حسابياً")
    print("  ⚠ حد الملف: المرور بالنقاط الثلاث لا يثبت أن المنحنى يشتق الإطارات — المنحنى مقترح")
    print()

# ============================================================
# 6) المانجو — tree3 : نسبة تاج، وليست ظلاً
# ============================================================

def check_mango():
    print("=" * 60)
    print("6) المانجو — tree3 : R = (H-h)/H  نسبة تاج، وليست S/H (ظل)")
    data = [(7.80,4.50),(8.50,5.00),(7.20,4.20),(9.00,5.40),(7.50,4.40)]
    Rs = [(H-h)/H for H,h in data]
    mean = sum(Rs)/len(Rs)
    target = math.sqrt(2)-1
    print(f"  R لكل شجرة: {[round(r,5) for r in Rs]}")
    print(f"  المتوسط = {mean:.5f} ، الهدف √2-1 = {target:.5f} ، الفرق = {abs(target-mean):.5f}")
    assert abs(mean - 0.41297) < 0.001
    print("  ✓ تشابه عددي، وليس قانوناً عاماً — عينة صغيرة، موقع واحد، غير مسجلة مسبقاً")
    print("  ✗ لا تقل: L/H يثبت شيئاً — L/H مستبعد لأنه يعتمد على زاوية الشمس")
    print()

