import math
import statistics
from dataclasses import dataclass

VERSION = "1.1"
FRAME5_STATUS = "NOT_PROVEN__NEEDS_INDEPENDENT_VERIFICATION"

# ============================================================
# 0) الجذر الرقمي ≠ باقي mod 9
# ============================================================

def digital_root(n: int) -> int:
    n = abs(int(n))
    if n == 0:
        return 0
    return 1 + (n - 1) % 9

def mod9(n: int) -> int:
    """باقي موحّد يعمل للأعداد السالبة أيضاً: ((n % 9) + 9) % 9"""
    return ((int(n) % 9) + 9) % 9

def check_root_vs_mod9():
    print("=" * 60)
    print("0) الجذر الرقمي ≠ باقي mod 9 — يفرقان فقط في مضاعفات 9")
    for n in [753, 262, 1015, 1872, 999, 369, -5]:
        print(f"  {n:6d} : جذر={digital_root(n)}  mod9={mod9(n)}")
    assert digital_root(1872) == 9 and mod9(1872) == 0
    assert mod9(-5) == 4  # -5 ≡ 4 (mod 9) — الباقي الموحد، لا باقي بايثون الخام
    print("  ✓ تمييز صحيح: 1872 جذره 9 وباقيه 0 · mod9(-5)=4")
    print()

# ============================================================
# 1) الثلاثة سياقات — مع فاحص وتر حقيقي للوتر المدخل
# ============================================================

def complement(n: int, k: int) -> int:
    return (10**k - 1) - n

@dataclass
class ComplementContext:
    k: int; C: int; A: int
    @property
    def unit(self): return 10**self.k - 1
    def valid(self): return self.C + self.A == self.unit

@dataclass
class NormalizedContext:
    Z: float; C: float; A: float
    def valid(self): return abs((self.Z + self.C + self.A) - 1.0) < 1e-9

def check_pythagoras(Z: float, C: float, A: float) -> bool:
    """فاحص حقيقي للوتر المدخل: يفصل حساب الوتر عن اختبار القيمة المدخلة."""
    if not all(math.isfinite(v) for v in (Z, C, A)):
        return False
    if Z <= 0 or C <= 0 or A <= 0:
        return False
    return abs(Z**2 + C**2 - A**2) < 1e-6

def check_three_contexts():
    print("=" * 60)
    print("1) ثلاثة سياقات منفصلة لـ Z,C,A — لا تخلط بينها")
    comp = ComplementContext(k=3, C=124, A=875)
    print(f"  [متمم] C+A = {comp.C}+{comp.A} = {comp.C+comp.A} ، الوحدة={comp.unit} -> {comp.valid()}")
    assert comp.valid()
    print(f"  [متمم] 369 في k=3 متممه = {complement(369,3)} ، وفي k=5 = {complement(369,5)}")
    assert complement(369,3) == 630 and complement(369,5) == 99630
    x = math.sqrt(2) - 1
    norm = NormalizedContext(Z=x, C=x, A=x*x)
    print(f"  [تطبيع] Z=C=x ، A=x² ، Z+C+A = {norm.Z+norm.C+norm.A:.10f} -> {norm.valid()}")
    assert norm.valid()
    # --- هندسة: الوتر المحسوب ينجح، والوتر المقرب يفشل ---
    A_exact = math.hypot(192, 290.74)
    print(f"  [هندسة] A_exact = hypot(192, 290.74) = {A_exact:.5f}")
    print(f"  [هندسة] check_pythagoras(192, 290.74, A_exact) = {check_pythagoras(192, 290.74, A_exact)}")
    assert check_pythagoras(192, 290.74, A_exact)
    print(f"  [هندسة] check_pythagoras(192, 290.74, 348.42) = {check_pythagoras(192, 290.74, 348.42)} — يجب أن يفشل: الباقي 2.7488 > 1e-6")
    assert not check_pythagoras(192, 290.74, 348.42)
    assert not check_pythagoras(192, 290.74, float('nan'))
    assert not check_pythagoras(-192, 290.74, A_exact)
    print("  ✓ كل سياق يُفحص بقانونه المستقل · الوتر المدخل يُختبر فعلاً، لا يُفترض صحته")
    print()

# ============================================================
# 2) حساب أبجدي وفق جدول المشروع (ليس قاعدة لغوية عامة)
# ============================================================

ABJAD_PROJECT = {
    'ا':1,'أ':1,'إ':1,'آ':1,'ء':1,
    'ب':2,'ج':3,'د':4,'ه':5,'و':6,'ؤ':6,'ز':7,
    'ح':8,'ط':9,'ي':10,'ى':10,'ئ':10,
    'ك':20,'ل':30,'م':40,'ن':50,
    'س':60,'ع':70,'ف':80,'ص':90,
    'ق':100,'ر':200,'ش':300,'ت':400,'ة':400,
    'ث':500,'خ':600,'ذ':700,
    'ض':800,'ظ':900,'غ':1000,
}

def abjad_value(word: str) -> int:
    return sum(ABJAD_PROJECT.get(ch, 0) for ch in word)

def check_char_balance():
    print("=" * 60)
    print("2) حساب أبجدي وفق جدول المشروع — char-balance")
    print("  تنبيه: القيم صحيحة وفق جدول الترميز الذي اعتمده المشروع، وليست قاعدة لغوية أو رياضية عامة.")
    z = abjad_value("الذكاء"); a = abjad_value("الاصطناعي"); total = z + a
    print(f"  الذكاء = {z} · الاصطناعي = {a} · المجموع = {total}")
    assert z == 753 and a == 262 and total == 1015
    print(f"  الجسر: 1015 mod9 = {mod9(1015)} ، 124 mod9 = {mod9(124)} -> توافق، مش مساواة")
    assert mod9(1015) == mod9(124) == 7
    print()

# ============================================================
# 3) 733 ليس فريداً — باقي موحد
# ============================================================

def check_733():
    print("=" * 60)
    print("3) مسألة 733 — إزالة وهم الفرادة")
    candidates = [n for n in range(0, 2000) if mod9(n) == 4]
    print(f"  الشرط الحقيقي: n ≡ 4 (mod 9) — بالباقي الموحد، حتى للأعداد السالبة")
    print(f"  أمثلة: {candidates[:8]} ... و 733 واحد منها فقط · mod9(-5) = {mod9(-5)}")
    assert 733 in candidates and mod9(1015+733) == mod9(875)
    print("  ✓ التوصية: أعلن 733 ثابتاً اصطلاحياً أو احذفه واكتفِ بجسر 1015")
    print()

