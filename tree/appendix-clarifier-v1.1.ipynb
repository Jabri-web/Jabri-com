# 4) الزوايا الثلاث
# ============================================================

def check_angles():
    print("=" * 60)
    print("4) الزوايا الثلاث — لا تخلط بينها")
    t22 = math.tan(math.radians(22.5))
    print(f"  tan(22.5°) = {t22:.8f} = √2-1 -> حالة ذهبية")
    assert abs(t22 - (math.sqrt(2)-1)) < 1e-9
    theta_general = math.degrees(math.atan(290.74/192))
    print(f"  مثال tree2 العام: arctan(290.74/192) = {theta_general:.2f}° -> مثال فقط، ليس زاوية سحرية")
    theta_m = math.degrees(math.acos(1/math.sqrt(3)))
    print(f"  الزاوية السحرية θm = arccos(1/√3) = {theta_m:.7f}° · tan(θm) = {math.tan(math.radians(theta_m)):.8f} = √2")
    assert abs(theta_m - 54.7356103) < 1e-4
    print("  ✓ 56.56° ≠ 54.7356°")
    print()

# ============================================================
# 5) المنحنى الموحد — فرضية مقترحة
# ============================================================

def alpha_star(theta_deg: float) -> float:
    t = math.tan(math.radians(theta_deg))
    return t / (t + 2)

def check_unified_curve():
    print("=" * 60)
    print("5) المنحنى الموحد — lab01 : alpha*(θ) = tanθ / (tanθ + 2)")
    cases = [(22.5, 3-2*math.sqrt(2), "Frame 2"),
             (45.0, 1/3, "v0.4"),
             (54.7356103, math.sqrt(2)-1, "الزاوية السحرية")]
    for theta, expected, ctx in cases:
        got = alpha_star(theta)
        print(f"  θ={theta:>10.4f}° : alpha* = {got:.6f} (المتوقع {expected:.6f}) [{ctx}]")
        assert abs(got - expected) < 1e-6
    print("  ✓ القيم الثلاث دقيقة حسابياً")
    print("  ⚠ القرار المعتمد: المنحنى فرضية رياضية مقترحة — تحقق القيم لا يثبت اشتقاقاً من نظرية هندسية موحدة.")
    print()

# ============================================================
# 6) المانجو — إعادة إنتاج إحصائي كاملة من البيانات الخام
# ============================================================

def t_cdf(t_val: float, df: int) -> float:
    """دالة توزيع t بدون اعتماد خارجي ثقيل: عبر scipy إن توفر، وإلا عبر تكامل عددي بسيط."""
    try:
        from scipy.stats import t as tdist
        return float(tdist.cdf(t_val, df))
    except Exception:
        # بديل: تكامل سيمبسون لدالة كثافة t
        import math as _m
        def pdf(x):
            c = _m.gamma((df+1)/2) / (_m.sqrt(df*_m.pi) * _m.gamma(df/2))
            return c * (1 + x*x/df) ** (-(df+1)/2)
        if t_val == 0:
            return 0.5
        n = 20000; a = 0.0; b = abs(t_val); h = (b-a)/n; s = pdf(a) + pdf(b)
        for i in range(1, n):
            s += (4 if i % 2 == 1 else 2) * pdf(a + i*h)
        area = s * h / 3
        return 0.5 + (area if t_val > 0 else -area)

def check_mango():
    print("=" * 60)
    print("6) المانجو — tree3 : R = (H-h)/H — إعادة إنتاج من البيانات الخام")
    data = [(7.80,4.50),(8.50,5.00),(7.20,4.20),(9.00,5.40),(7.50,4.40)]
    Rs = [(H-h)/H for H, h in data]
    n = len(Rs); mean = statistics.mean(Rs); sd = statistics.stdev(Rs); se = sd / math.sqrt(n)
    target = math.sqrt(2) - 1
    t_crit_90 = 2.131846  # t(0.95, df=4)
    lo, hi = mean - t_crit_90*se, mean + t_crit_90*se
    delta = 0.03  # هامش التكافؤ المعلن في الملف
    t_low = (mean - (target - delta)) / se
    t_up = ((target + delta) - mean) / se
    p_tost = max(1 - t_cdf(t_low, n-1), 1 - t_cdf(t_up, n-1))
    print(f"  البيانات الخام (H,h): {data}")
    print(f"  R لكل شجرة: {[round(r,5) for r in Rs]}")
    print(f"  n={n} · المتوسط={mean:.5f} · الانحراف المعياري={sd:.5f} · الخطأ المعياري={se:.5f}")
    print(f"  90% CI المحسوب = [{lo:.5f} , {hi:.5f}] (المعلن [0.40491 , 0.42102])")
    print(f"  TOST بهامش ±{delta}: t_low={t_low:.4f} · t_up={t_up:.4f} · p = {p_tost:.6f} (المعلن 0.000801)")
    assert abs(mean - 0.41297) < 0.001
    assert abs(lo - 0.40491) < 0.001 and abs(hi - 0.42102) < 0.001
    assert abs(p_tost - 0.000801) < 0.0002
    print("  ✓ الإحصاءات الثلاث أُعيد إنتاجها من البيانات الخام، لا نُقلت كما هي")
    print("  ⚠ القرار المعتمد: تقارب عددي مثير للاهتمام، لا يثبت علاقة هندسية عامة. تحقق مستقل ضروري.")
    print()

