#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
M1-E — النسخة المصححة النهائية (مجمّدة)
========================================
السؤال: هل الفجوة الدقيقة تحمل معلومات انتقالية إضافية
لم تستطع الفئات الثلاث التقاطها؟

التعريف التاريخي لـ M1 (من اختبار A — «الكبير يتبعه الصغير»):
  فئات الحجم الثلاث: صغيرة ≤ 6، متوسطة 8–14، كبيرة ≥ 16.
  الحدود: 6، 14. ولما كانت كل الفجوات زوجية بعد الفجوة الأولى
  (1 بين 2 و3)، فلا توجد فجوة 7 أو 15 أصلًا، والحدود تحدد
  الفئات تمامًا دون غموض. الـ 10/30 كانت افتراضًا من الكاتب،
  وهي الآن مرفوضة — والسكربت يقبل 6، 14 وحدهما.
  M1 هو Markov-1 على فئات الحجم: الحالة = فئة حجم الفجوة،
  ومصفوفة الانتقال التجريبية P_ab = Pr(S_{i+1}=b | S_i=a).
  وفي المحاكاة لا نولّد فئات فقط: نولّد تسلسل فئات من مصفوفة
  الانتقال، ثم نسحب فجوة عددية فعلية من توزيع الفجوات داخل
  الفئة المولدة، بصورة مستقلة مشروطة بالفئة.

البروتوكول مثبّت مسبقًا، ولا يُعدَّل بعد التشغيل:
  - التقسيم على الانتقالات نفسها: أول 50% من الانتقالات تدريب،
    وآخر 50% اختبار، والانتقال على الحد الفاصل لا يسقط.
  - الفجوات حتى 30: قيمة دقيقة. فوق 30: نطاقات لوغاريتمية محددة مسبقًا.
  - عتبة الدمج: 200 مشاهدة في التدريب، من بيانات التدريب فقط.
  - قاعدة الدمج: أي نطاق دون 200 يُدمج مع النطاق الأعلى التالي.
    الاستثناء: النطاق الأخير يبقى كما هو ولا يُدمج نزولًا.
  - Laplace smoothing: alpha = 1 على عدّادات الانتقال بعد الدمج.
  - Bootstrap: كتل متجاورة دائرية بطول ثابت، كتلة = 100 انتقال،
    B = 2000، فاصل 95%. كل عينة Bootstrap طولها عدد انتقالات الاختبار.
  - الحكم: تحسن Log-Loss وتفسير Pearson مقياسان منفصلان.
  - عتبة تصنيف الحكم (موجودة في الكود قبل أي تشغيل، وتُوثَّق هنا):
    تحسن واضح إذا كان الحد الأدنى لفاصل Bootstrap > 0 والكسب
    ≥ 0.005 bits/انتقال؛ تحسن محدود إذا كان الحد الأدنى > 0 دون
    بلوغ العتبة؛ غير معتبر خلاف ذلك. العتبة 0.005 لا تتغير.
  - عدم التحسن لا يثبت غياب المعلومات.
  - الفجوة الأولى (1 بين 2 و3): تدخل كحالة ابتدائية لأول انتقال
    (g0 -> g1)، وفئتها Small، ولا تُستبعد من بناء النموذج.
    لم يوجد في البروتوكول أي قاعدة استبعاد لها، وحذفها كان سيُسقط
    أول انتقال. أثرها انتقال واحد من 12,997 في التدريب.
  - سلامة البيانات صارمة: في CSV تُقبل الترويسة الأولى وحدها
    إذا كانت في السطر الأول (السطر 0) وكان اسمها بالضبط gap أو g
    أو gaps، ويُرفض أي سطر غير رقمي آخر، وتُرفض الأعمدة الإضافية
    (الملف عمود واحد)، مع الحفاظ على أرقام الأسطر الأصلية عند
    الإبلاغ. في JSON تُرفض القيم المنطقية صراحة (true ليست فجوة 1)،
    وفي القاموس غير معروف البنية تُقبل قائمة واحدة فقط، ويُرفض
    الملف إذا كانت القائمة المرشحة تالفة أو كانت هناك قوائم
    متعددة ملتبسة — لا تخمين أي قائمة تمثل الفجوات.
    أي فجوة غير صالحة توقف التشغيل بموضعها — لا حذف صامت أبدًا.
  - تحفظان مسجلان على Pearson: حرق 2000 خطوة إعداد محاكاة ثابت،
    لا شهادة استقرار رياضية. وPearson المحاكى تقدير يعتمد على
    إجراء المحاكاة، لا قيمة تحليلية دقيقة للنموذج.
  - فاصل Bootstrap يقيس عدم يقين إعادة أخذ عينات الاختبار
    مع تثبيت النماذج المدرّبة، لا عدم يقين إعادة التدريب.
  - محاكاة Pearson بحرق بداية ثابت مقداره 2000 خطوة،
    دون ادعاء إثبات الاستقرار أو التقارب.

الاستخدام (مرة واحدة على gaps.csv، دون تعديل بعد ظهور النتيجة):
  python3 m1e_tomorrow_final.py gaps.csv --classes 6,14
  python3 m1e_tomorrow_final.py --demo --classes 6,14   (تجربة فقط)
من خلية Jupyter:
  !python3 m1e_tomorrow_final.py gaps.csv --classes 6,14
أو لصق الكود في خلية وتشغيله مباشرة (وضع الخلية):
  إن لم تُمرَّر --classes، تُستخدم الحدود التاريخية 6، 14 تلقائيًا
  مع إعلان صريح — وهي الوحيدة المقبولة أصلًا، فلا يتغير البروتوكول.
  وإن لم يوجد gaps.csv بجانب الخلية، يُشغَّل الوضع التجريبي مع إعلان
  صريح أنه تجربة فقط. وإن وُجد gaps.csv، يُشغَّل عليه الاختبار الحقيقي.
"""

import sys, json, math, os
import numpy as np

ALPHA = 1.0
N_MIN = 200
LOG_EDGES = [30, 44, 62, 88, 124, 176, 248, 350, 500]
BLOCK = 100
B_BOOT = 2000
SEED = 20261120
HISTORICAL_EDGES = (6, 14)
CLASS_EDGES = None
CLASS_NAMES = ["Small", "Medium", "Large"]

def set_class_edges(a, b):
    global CLASS_EDGES
    if (int(a), int(b)) != HISTORICAL_EDGES:
        raise ValueError("يُقبل تعريف M1 التاريخي وحده: 6، 14")
    CLASS_EDGES = (int(a), int(b))

def size_class(g):
    if CLASS_EDGES is None:
        raise RuntimeError("حدود الفئات غير مثبّتة — مرّر --classes 6,14")
    a, b = CLASS_EDGES
    if g <= a:
        return 0
    if g <= b:
        return 1
    return 2

def sieve_gaps(limit):
    sieve = bytearray(b"\x01") * (limit + 1)
    sieve[0:2] = b"\x00\x00"
    for i in range(2, int(limit ** 0.5) + 1):
        if sieve[i]:
            sieve[i * i:limit + 1:i] = b"\x00" * ((limit - i * i) // i + 1)
    primes = [i for i, v in enumerate(sieve) if v]
    return [primes[i + 1] - primes[i] for i in range(len(primes) - 1)]

def bin_of(g):
    if g <= 30:
        return ("exact", int(g))
    for i, e in enumerate(LOG_EDGES[1:], start=1):
        if g <= e:
            return ("log", i)
    return ("log", len(LOG_EDGES))

def bin_label(b):
    kind, v = b
    if kind == "exact":
        return f"g={v}"
    if v == len(LOG_EDGES):
        return "g>500"
    return f"({LOG_EDGES[v-1]}, {LOG_EDGES[v]}]"

def resolve_bin(b, merge_map):
    while merge_map[b] != b:
        b = merge_map[b]
    return b

def build_merge_map(train_gaps):
    from collections import Counter
    counts = Counter(bin_of(g) for g in train_gaps if g > 30)
    log_bins = [("log", i) for i in range(1, len(LOG_EDGES) + 1)]
    merge_map = {b: b for b in log_bins}
    merges = []
    i = 0
    while i < len(log_bins) - 1:
        b = log_bins[i]
        eff = sum(counts[x] for x in log_bins if resolve_bin(merge_map[x], merge_map) == b)
        if eff < N_MIN:
            nxt = log_bins[i + 1]
            merge_map[b] = resolve_bin(nxt, merge_map)
            merges.append((bin_label(b), bin_label(merge_map[b]), eff))
        i += 1
    from collections import Counter as C
    after = C()
    for g in train_gaps:
        if g > 30:
            after[resolve_bin(bin_of(g), merge_map)] += 1
    last = log_bins[-1]
    last_raw = int(counts.get(last, 0))
    last_merged = int(after.get(last, 0))
    last_ok = last_merged >= N_MIN
    return merge_map, merges, after, last_raw, last_merged, last_ok

def feature_of(g, merge_map):
    if g <= 30:
        return ("exact", int(g))
    return resolve_bin(bin_of(g), merge_map)

def fit_transitions(feats, targets):
    from collections import defaultdict, Counter
    cnt = defaultdict(Counter)
    for f, t in zip(feats, targets):
        cnt[f][t] += 1
    probs = {}
    for f, c in cnt.items():
        tot = sum(c.values()) + ALPHA * 3
        probs[f] = np.array([(c[k] + ALPHA) / tot for k in range(3)])
    return probs, cnt

def predict(probs, cnt, feats, fallback):
    return np.array([probs[f] if f in probs else fallback for f in feats])

def logloss(probs_pred, targets):
    p = np.clip(probs_pred[np.arange(len(targets)), targets], 1e-12, 1.0)
    return float(-np.log(p).mean())

def accuracy(probs_pred, targets):
    return float((probs_pred.argmax(axis=1) == targets).mean())

def pearson_simulated(probs, cnt, feats_train, gaps_by_class, train_next_gaps,
                      n_steps=200000, seed=SEED + 1, is_m1=False, merge_map=None):
    rng = np.random.default_rng(seed)
    from collections import Counter
    marg = Counter([size_class(g) for g in train_next_gaps])
    tot = sum(marg.values())
    fallback = np.array([(marg[k] + ALPHA) / (tot + ALPHA * 3) for k in range(3)])
    BURN = 2000
    cur = feats_train[0]
    sim_gaps = np.empty(n_steps + BURN, dtype=float)
    for t in range(n_steps + BURN):
        p = probs.get(cur, fallback)
        nxt_class = int(rng.choice(3, p=p / p.sum()))
        pool = gaps_by_class.get(nxt_class)
        if pool is None or len(pool) == 0:
            pool = np.array(train_next_gaps)
        g = float(rng.choice(pool))
        sim_gaps[t] = g
        if is_m1:
            cur = ("class", nxt_class)
        else:
            cur = feature_of(int(g), merge_map)
    sim_gaps = sim_gaps[BURN:]
    if np.std(sim_gaps[:-1]) == 0 or np.std(sim_gaps[1:]) == 0:
        return 0.0
    return float(np.corrcoef(sim_gaps[:-1], sim_gaps[1:])[0, 1])

def block_bootstrap_gain(test_feats_m1, test_feats_m1e, test_targets,
                         probs_m1, probs_m1e, cnt_m1, cnt_m1e,
                         fallback_m1, fallback_m1e, rng):
    n = len(test_targets)
    pred_m1 = predict(probs_m1, cnt_m1, test_feats_m1, fallback_m1)
    pred_m1e = predict(probs_m1e, cnt_m1e, test_feats_m1e, fallback_m1e)
    ll_m1 = -np.log(np.clip(pred_m1[np.arange(n), test_targets], 1e-12, 1.0))
    ll_m1e = -np.log(np.clip(pred_m1e[np.arange(n), test_targets], 1e-12, 1.0))
    per = (ll_m1 - ll_m1e) / math.log(2)
    point = float(per.mean())
    nblocks = math.ceil(n / BLOCK)
    gains = []
    for _ in range(B_BOOT):
        idx = []
        for _ in range(nblocks):
            s0 = int(rng.integers(0, n))
            idx.extend((s0 + k) % n for k in range(BLOCK))
        idx = np.array(idx[:n])
        gains.append(float(per[idx].mean()))
    lo, hi = np.percentile(gains, [2.5, 97.5])
    return point, float(lo), float(hi)

def load_gaps(path):
    if path == "--demo":
        print("وضع تجريبي: توليد فجوات الأوليات حتى 300,000 بغربال إراتوستينس...")
        gaps = sieve_gaps(300000)
        print(f"وُلدت {len(gaps)} فجوة. هذا وضع تجريبي فقط، وليس الاختبار الفعلي.")
        return gaps
    if not os.path.exists(path):
        print("=" * 64)
        print("لم يُعثر على ملف الفجوات:", path)
        print("ضع ملف gaps.csv بجانب السكربت، أو مرّر المسار:")
        print("  python3 m1e_tomorrow_final.py /path/to/gaps.csv --classes 6,14")
        print("=" * 64)
        return None
    with open(path, encoding="utf-8") as f:
        text = f.read()
    # لا strip() عامًا هنا: أرقام الأسطر المُبلَّغ عنها يجب أن تكون الأصلية.
    gaps = []

    def _is_num(x):
        # bool مرفوض صراحة: isinstance(True, int) تعطي True في Python،
        # وtrue في JSON ليست الفجوة 1.
        return isinstance(x, (int, float)) and not isinstance(x, bool) and math.isfinite(x)

    def _to_gaps(seq, where):
        if any(isinstance(x, bool) for x in seq):
            print("=" * 64)
            print("قيم منطقية (true/false) في ملف الفجوات — مرفوضة صراحة.")
            print("true ليست الفجوة 1. أصلح الملف ثم أعد التشغيل.")
            print("=" * 64)
            return None
        if not all(_is_num(x) for x in seq):
            print("=" * 64)
            print(f"قيم غير رقمية في {where} — توقف التشغيل، لا حذف صامت.")
            print("=" * 64)
            return None
        try:
            return [float(x) for x in seq]
        except (TypeError, ValueError):
            print("=" * 64)
            print(f"تعذّر تحويل قيم في {where} إلى أرقام — توقف التشغيل.")
            print("=" * 64)
            return None

    stripped = text.strip()
    if stripped.startswith("{") or stripped.startswith("["):
        try:
            data = json.loads(stripped)
        except Exception:
            data = None
        if isinstance(data, list):
            gaps = _to_gaps(data, "قائمة JSON")
            if gaps is None:
                return None
        elif isinstance(data, dict):
            known = None
            cand = None
            for key in ("gaps", "gap", "data", "prime_gaps"):
                if key in data:
                    known = key
                    cand = data[key]
                    break
            if known is not None:
                # مفتاح معروف: هو المرشح وحده، ولا يُتجاوز إلى غيره.
                if not isinstance(cand, list):
                    print("=" * 64)
                    print(f"المفتاح '{known}' في ملف JSON ليس قائمة — توقف التشغيل.")
                    print("=" * 64)
                    return None
                gaps = _to_gaps(cand, f"قائمة JSON (المفتاح {known})")
                if gaps is None:
                    return None
            else:
                # قاموس غير معروف البنية: قائمة واحدة فقط، وإلا رفض.
                lists = [v for v in data.values() if isinstance(v, list) and v]
                if len(lists) == 0:
                    print("=" * 64)
                    print("هذا الملف ليس ملف فجوات:", path)
                    print("هل مررت m1e_report.json بالخطأ؟")
                    print("شغّل:  python3 m1e_tomorrow_final.py gaps.csv --classes 6,14")
                    print("=" * 64)
                    return None
                if len(lists) > 1:
                    print("=" * 64)
                    print("قوائم متعددة ملتبسة في ملف JSON — لا تخمين أي قائمة")
                    print("تمثل الفجوات. توقف التشغيل، لا حذف صامت.")
                    print("=" * 64)
                    return None
                gaps = _to_gaps(lists[0], "قائمة JSON الوحيدة في القاموس")
                if gaps is None:
                    return None
        else:
            print("لم أستطع قراءة الفجوات من ملف JSON:", path)
            return None
    else:
        # CSV صارمة: عمود واحد. الترويسة مقبولة فقط إذا كانت في
        # السطر الأول (السطر 0) وكان اسمها بالضبط gap أو g أو gaps؛
        # أي سطر غير رقمي آخر مرفوض، وأي سطر بأعمدة إضافية مرفوض.
        # أرقام الأسطر أصلية.
        bad_lines = []
        for li, raw_line in enumerate(text.splitlines()):
            line = raw_line.strip()
            if not line:
                continue
            is_first = (li == 0)
            parts = line.split(",")
            if len(parts) != 1:
                bad_lines.append((li + 1, line, "أعمدة إضافية — الملف عمود واحد"))
                continue
            tok = parts[0].strip().strip('"').strip("'")
            try:
                gaps.append(float(tok))
            except ValueError:
                if is_first and tok in ("gap", "g", "gaps"):
                    continue  # الترويسة وحدها، في السطر الأول، بالاسم فقط
                bad_lines.append((li + 1, line, "سطر غير رقمي"))
                if len(bad_lines) >= 10:
                    break
        if bad_lines:
            print("=" * 64)
            print("سطور تالفة في ملف الفجوات — توقف التشغيل، لا حذف صامت:")
            for li, line, why in bad_lines:
                print(f"  السطر {li}: {line[:60]} — {why}")
            print("أصلح الملف ثم أعد التشغيل.")
            print("=" * 64)
            return None
    if len(gaps) < 100:
        print("=" * 64)
        print(f"الملف {path} لا يبدو ملف فجوات: قُرئت {len(gaps)} قيمة فقط.")
        print("=" * 64)
        return None
    return gaps

def validate_gaps(gaps):
    bad = []
    for i, g in enumerate(gaps):
        if isinstance(g, bool):
            bad.append((i, g, "قيمة منطقية — true ليست الفجوة 1"))
        elif not isinstance(g, (int, float)) or math.isnan(g) or math.isinf(g):
            bad.append((i, g, "ليست عددًا"))
        elif float(g) != int(g):
            bad.append((i, g, "ليست عددًا صحيحًا"))
        elif int(g) < 1:
            bad.append((i, g, "أقل من 1"))
        elif int(g) == 1 and i != 0:
            bad.append((i, g, "فجوة 1 في غير موضعها — توجد مرة واحدة بين 2 و3"))
        elif int(g) > 1 and int(g) % 2 != 0:
            bad.append((i, g, "فردية — فجوات الأوليات بعد 3 زوجية"))
        if len(bad) >= 10:
            break
    if bad:
        print("=" * 64)
        print("بيانات غير صالحة: توقف التشغيل — لا حذف صامت للفجوات.")
        for i, g, why in bad:
            print(f"  الموضع {i}: القيمة {g} — {why}")
        print("أصلح الملف ثم أعد التشغيل. لم تُحذف أي قيمة.")
        print("=" * 64)
        return None
    return np.array([int(g) for g in gaps], dtype=int)

def main(path, class_edges):
    rng = np.random.default_rng(SEED)
    set_class_edges(*class_edges)
    raw = load_gaps(path)
    if raw is None:
        return
    gaps = validate_gaps(raw)
    if gaps is None:
        return
    n = len(gaps)
    # التقسيم على الانتقالات نفسها: انتقال i هو (gaps[i], gaps[i+1])، وعددها n-1.
    n_trans = n - 1
    m = n_trans // 2
    tr_idx = np.arange(m)
    te_idx = np.arange(m, n_trans)
    tr_feats_raw = gaps[tr_idx]
    tr_targets = np.array([size_class(int(gaps[i + 1])) for i in tr_idx])
    te_feats_raw = gaps[te_idx]
    te_targets = np.array([size_class(int(gaps[i + 1])) for i in te_idx])
    train_next_gaps = gaps[tr_idx + 1]
    test_from_gaps = gaps[te_idx]
    test_to_gaps = gaps[te_idx + 1]

    merge_map, merges, after, last_raw, last_merged, last_ok = build_merge_map(tr_feats_raw)
    tr_feats = [feature_of(g, merge_map) for g in tr_feats_raw]
    te_feats = [feature_of(g, merge_map) for g in te_feats_raw]

    m1_tr = [("class", size_class(g)) for g in tr_feats_raw]
    m1_te = [("class", size_class(g)) for g in te_feats_raw]
    probs_m1, cnt_m1 = fit_transitions(m1_tr, tr_targets)
    probs_m1e, cnt_m1e = fit_transitions(tr_feats, tr_targets)

    from collections import Counter
    marg = Counter(tr_targets.tolist())
    tot = sum(marg.values())
    fallback = np.array([(marg[k] + ALPHA) / (tot + ALPHA * 3) for k in range(3)])

    pred_m1 = predict(probs_m1, cnt_m1, m1_te, fallback)
    pred_m1e = predict(probs_m1e, cnt_m1e, te_feats, fallback)

    from collections import defaultdict
    gaps_by_class = defaultdict(list)
    for g in train_next_gaps:
        gaps_by_class[size_class(int(g))].append(int(g))
    gaps_by_class = {k: np.array(v) for k, v in gaps_by_class.items()}
    rho_m1 = pearson_simulated(probs_m1, cnt_m1, m1_tr, gaps_by_class, train_next_gaps, is_m1=True)
    rho_m1e = pearson_simulated(probs_m1e, cnt_m1e, tr_feats, gaps_by_class, train_next_gaps,
                                 is_m1=False, merge_map=merge_map)
    rho_actual = float(np.corrcoef(test_from_gaps.astype(float), test_to_gaps.astype(float))[0, 1])

    ll_m1 = logloss(pred_m1, te_targets)
    ll_m1e = logloss(pred_m1e, te_targets)
    acc_m1 = accuracy(pred_m1, te_targets)
    acc_m1e = accuracy(pred_m1e, te_targets)
    g_bits, g_lo, g_hi = block_bootstrap_gain(
        m1_te, te_feats, te_targets,
        probs_m1, probs_m1e, cnt_m1, cnt_m1e, fallback, fallback, rng)

    if g_lo > 0 and g_bits >= 0.005:
        verdict_ll = "تحسن واضح"
    elif g_lo > 0:
        verdict_ll = "تحسن محدود"
    else:
        verdict_ll = "غير معتبر"

    from collections import Counter
    before = Counter(bin_of(g) for g in tr_feats_raw if g > 30)
    a_edge, b_edge = class_edges
    print("=" * 64)
    print("M1-E — تقرير الغد (البروتوكول مثبّت مسبقًا)")
    print("=" * 64)
    print(f"حدود الفئات (M1 التاريخي): Small g<={a_edge} | Medium g<={b_edge} | Large g>{b_edge}")
    print(f"إجمالي الفجوات: {n} | انتقالات: {n_trans} | تدريب: {m} انتقالًا | اختبار: {n_trans - m} انتقالًا")
    print()
    print("--- النطاقات فوق 30: قبل الدمج وبعده (تدريب) ---")
    for b in sorted(before, key=lambda x: x[1]):
        print(f"  {bin_label(b):>12}: قبل={before[b]:>8}  بعد={after.get(b, 0):>8}")
    print(f"عدد عمليات الدمج: {len(merges)}")
    for a, b_, c in merges:
        print(f"  دمج {a} -> {b_} (مشاهدات: {c})")
    print(f"النطاق الأخير (g>500): خام={last_raw} | بعد الدمج={last_merged} | "
          f"كفاية التقدير: {'متحققة' if last_ok else 'لم تتحقق — يُسجَّل ولا يُدمج نزولًا'}")
    print()
    print("--- الأداء على الاختبار نفسه ---")
    print(f"{'المقياس':>28} | {'M1':>12} | {'M1-E':>12}")
    print(f"{'Accuracy':>28} | {acc_m1:>12.4f} | {acc_m1e:>12.4f}")
    print(f"{'Log-Loss':>28} | {ll_m1:>12.4f} | {ll_m1e:>12.4f}")
    print(f"{'Pearson (محاكاة)':>28} | {rho_m1:>12.5f} | {rho_m1e:>12.5f}")
    print(f"{'Pearson الفعلي للاختبار':>28} | {rho_actual:>12.5f} | {rho_actual:>12.5f}")
    print()
    print(f"Predictive Gain: {g_bits:.5f} bits/انتقال  |  95% CI: [{g_lo:.5f}, {g_hi:.5f}]")
    print("نطاق فاصل Bootstrap: عدم يقين إعادة أخذ عينات الاختبار مع تثبيت النماذج —")
    print("لا يقيس عدم يقين إعادة التدريب.")
    print(f"الحكم (Log-Loss فقط): {verdict_ll}")
    print(f"Pearson: تغير من {rho_m1:.5f} إلى {rho_m1e:.5f} — يُقرأ منفصلًا، ولا يُخلط بالحكم أعلاه.")
    print()
    print("الخلاصة المثبّتة سلفًا:")
    print("  عدم التحسن لا يثبت غياب المعلومات؛ بل يحدّد ما لم ينجح هذا التمثيل في استخراجه.")
    print("=" * 64)

    report = {
        "class_edges": [int(a_edge), int(b_edge)],
        "n_gaps": int(n), "n_transitions": int(n_trans),
        "n_train_transitions": int(m), "n_test_transitions": int(n_trans - m),
        "bins_before": {bin_label(b): int(c) for b, c in before.items()},
        "bins_after": {bin_label(b): int(c) for b, c in after.items()},
        "n_merges": len(merges),
        "merges": [{"from": a, "to": b_, "count": int(c)} for a, b_, c in merges],
        "last_bin_raw": int(last_raw), "last_bin_merged": int(last_merged),
        "last_bin_sufficient": bool(last_ok),
        "alpha": ALPHA, "n_min": N_MIN, "block": BLOCK, "B_boot": B_BOOT,
        "seed_bootstrap": SEED,
        "seed_pearson": SEED + 1,
        "pearson_steps": 200000,
        "pearson_burn_in": 2000,
        "pearson_method": "simulation",
        "verdict_threshold_bits": 0.005,
        "M1": {"accuracy": acc_m1, "logloss": ll_m1, "pearson_simulated": rho_m1},
        "M1-E": {"accuracy": acc_m1e, "logloss": ll_m1e, "pearson_simulated": rho_m1e},
        "pearson_actual_test": rho_actual,
        "predictive_gain_bits": g_bits, "gain_ci_95": [g_lo, g_hi],
        "bootstrap_scope": "test-resampling only; models fixed (not retraining uncertainty)",
        "verdict_logloss": verdict_ll,
    }
    with open("m1e_report.json", "w", encoding="utf-8") as f:
        json.dump(report, f, ensure_ascii=False, indent=2)
    print("حُفظ التقرير في m1e_report.json")

def parse_argv(argv):
    raw = list(argv)
    args, classes, demo = [], None, False
    i = 0
    while i < len(raw):
        a = raw[i]
        if a == "-f":
            i += 2
            continue
        if a == "--demo":
            demo = True
            i += 1
            continue
        if a == "--classes" and i + 1 < len(raw):
            classes = raw[i + 1]
            i += 2
            continue
        if a.startswith("--classes="):
            classes = a.split("=", 1)[1]
            i += 1
            continue
        if a.startswith("-"):
            i += 1
            continue
        args.append(a)
        i += 1
    return args, classes, demo

if __name__ == "__main__":
    pos, classes_raw, demo = parse_argv(sys.argv[1:])
    # وضع الخلية: الكود يُشغَّل داخل خلية Jupyter/Colab، فيكون sys.argv
    # وسائط النواة (kernel-....json) لا أمر المستخدم. يُكتشف بوجود
    # kernel- في الوسائط أو بوجود get_ipython.
    in_cell = any("kernel-" in a for a in sys.argv) or "get_ipython" in dir(__builtins__)
    if classes_raw is None:
        if in_cell:
            # الحدود التاريخية هي الوحيدة المقبولة أصلًا، فاستخدامها
            # تلقائيًا هنا لا يغيّر البروتوكول — ويُعلن صراحة.
            print("=" * 64)
            print("وضع الخلية: لم تُمرَّر --classes.")
            print("استخدام الحدود التاريخية 6، 14 — وهي الوحيدة المقبولة أصلًا.")
            print("=" * 64)
            class_edges = HISTORICAL_EDGES
        else:
            print("=" * 64)
            print("حدود الفئات الثلاث غير مثبّتة.")
            print("مرّرها كما في تعريف M1 التاريخي حرفيًا:")
            print("  python3 m1e_tomorrow_final.py gaps.csv --classes 6,14")
            print("الحدود التاريخية: 6، 14 (صغيرة ≤ 6، متوسطة 8–14، كبيرة ≥ 16).")
            print("لا تُستخدم حدود افتراضية — تعريف الهدف لا يتغير بين M1 وM1-E.")
            print("=" * 64)
            sys.exit(1)
    else:
        try:
            a_s, b_s = classes_raw.split(",")
            class_edges = (int(a_s), int(b_s))
            assert 0 < class_edges[0] < class_edges[1]
        except Exception:
            print("صيغة --classes غير صالحة. استخدم: --classes 6,14")
            sys.exit(1)
        if class_edges != HISTORICAL_EDGES:
            print("=" * 64)
            print(f"الحدود {class_edges[0]}، {class_edges[1]} مرفوضة.")
            print("يُقبل تعريف M1 التاريخي وحده: 6، 14")
            print("(صغيرة ≤ 6، متوسطة 8–14، كبيرة ≥ 16).")
            print("شغّل:  python3 m1e_tomorrow_final.py gaps.csv --classes 6,14")
            print("=" * 64)
            sys.exit(1)
    path = "--demo" if demo else None
    if path is None:
        if pos:
            if "kernel-" in pos[0] and pos[0].endswith(".json"):
                print("=" * 64)
                print("يبدو أنك تشغّل السكربت من خلية Jupyter دون تمرير ملف الفجوات،")
                print("فمرّر Jupyter ملف النواة kernel-....json كوسيط.")
                print("شغّل من خلية بهذا الشكل:")
                print("    !python3 m1e_tomorrow_final.py gaps.csv --classes 6,14")
                print("أو من التيرمينال:")
                print("    python3 m1e_tomorrow_final.py gaps.csv --classes 6,14")
                print("=" * 64)
                sys.exit(1)
            path = pos[0]
        elif os.path.exists("gaps.csv"):
            path = "gaps.csv"
        elif in_cell:
            print("=" * 64)
            print("وضع الخلية: لا يوجد gaps.csv بجانب الخلية.")
            print("تشغيل الوضع التجريبي بدلًا من ذلك — تجربة فقط، ليست الاختبار.")
            print("للاختبار الحقيقي: ارفع gaps.csv ثم أعد تشغيل الخلية.")
            print("=" * 64)
            path = "--demo"
        else:
            print("الاستخدام: python3 m1e_tomorrow_final.py gaps.csv --classes 6,14")
            print("أو للتجربة: python3 m1e_tomorrow_final.py --demo --classes 6,14")
            sys.exit(1)
    main(path, class_edges)
