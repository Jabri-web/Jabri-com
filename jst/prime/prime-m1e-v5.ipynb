#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
M1-E — اختبار الغد (المشاكس) — نسخة مصححة بعد المراجعة
========================================================
السؤال: هل الفجوة الدقيقة تحمل معلومات انتقالية إضافية
لم تستطع الفئات الثلاث التقاطها؟

البروتوكول مثبّت مسبقًا، ولا يُعدَّل بعد التشغيل:
  - التدريب: أول 50% من الانتقالات. الاختبار: آخر 50%.
  - الفجوات حتى 30: قيمة دقيقة.
  - فوق 30: نطاقات لوغاريتمية محددة مسبقًا.
  - عتبة الدمج: 200 مشاهدة في التدريب.
  - قاعدة الدمج: أي نطاق دون 200 يُدمج مع النطاق الأعلى التالي.
    الاستثناء: النطاق الأخير يبقى كما هو ولا يُدمج نزولًا؛
    فإن بقي دون العتبة، يُعلن أن شرط كفاية التقدير لم يتحقق لذلك الجزء.
  - Laplace smoothing: alpha = 1 على عدّادات الانتقال بعد الدمج.
  - Bootstrap: كتل متجاورة، كتلة = 100 انتقال، B = 2000، فاصل 95%.
  - الحكم: تحسن Log-Loss وتفسير Pearson مقياسان منفصلان.
  - عدم التحسن لا يثبت غياب المعلومات؛ بل يحدّد ما لم ينجح
    هذا التمثيل في استخراجه.

التعريف التاريخي لـ M1 (من اختبار A — «الكبير يتبعه الصغير»):
  فئات الحجم الثلاث: صغيرة ≤ 6، متوسطة 8–14، كبيرة ≥ 16.
  الحدود: 6، 14. ولما كانت كل الفجوات زوجية بعد الفجوة الأولى
  (1 بين 2 و3)، فلا توجد فجوة 7 أو 15 أصلًا، والحدود تحدد
  الفئات تمامًا دون غموض. الـ 10/30 كانت افتراضًا من الكاتب،
  وهي الآن مرفوضة — والسكربت يرفض تشغيلها.
  M1 هو Markov-1 على فئات الحجم: الحالة = فئة حجم الفجوة،
  ومصفوفة الانتقال التجريبية P_ab = Pr(S_{i+1}=b | S_i=a).
  وفي المحاكاة لا نولّد فئات فقط: نولّد تسلسل فئات من مصفوفة
  الانتقال، ثم نسحب فجوة عددية فعلية من توزيع الفجوات داخل
  الفئة المولدة، بصورة مستقلة مشروطة بالفئة — بهذا نحافظ على
  توزيع الأحجام ونزيل أي اعتماد عددي إضافي داخل الفئة.
  وهذا الفقد هو بالضبط ما نريد قياسه.

تصحيحات المراجعة (قبل أي تشغيل فعلي):
  1) حدود الفئات الثلاث تُمرَّر صراحة بـ --classes 6,14 كما في
     تعريف M1 التاريخي حرفيًا.
  2) Pearson الذي يقتضيه النموذج: محاكاة سلسلة ماركوف من مصفوفة
     انتقالاته، ثم corr للفجوات المتتالية المحاكاة — لا مقارنة
     متوسطات الفئات، ولا corr التوقع بالفعلية (موجب بالبناء).
     ويُسجَّل Pearson الفعلي للاختبار corr(g_i, g_{i+1}) كمرجع منفصل.
  3) سلامة البيانات صارمة: أي قيمة غير زوجية أو < 2 أو غير صحيحة
     توقف التشغيل مع مواضعها — لا حذف صامت، لأن حذف فجوة من
     منتصف السلسلة يغيّر الانتقالات التالية.
  4) النطاق الأخير: يُسجَّل عدده الخام وعدده بعد الدمج كلٌّ على حدة.
  5) فاصل Bootstrap يقيس عدم يقين إعادة أخذ عينات الاختبار
     مع تثبيت النماذج المدرّبة، لا عدم يقين إعادة التدريب.

الاستخدام:
  python3 m1e_tomorrow.py gaps.csv --classes 6,14
  python3 m1e_tomorrow.py /path/to/gaps.csv --classes 6,14
  python3 m1e_tomorrow.py --demo --classes 6,14   (تجربة فقط)
من خلية Jupyter:
  !python3 m1e_tomorrow.py gaps.csv --classes 6,14

المخرجات: تقرير كامل في الطرفية + ملف m1e_report.json
"""

import sys, json, math, os
import numpy as np

# ------------------------------------------------------------------
# ثوابت مثبّتة — لا تُعدَّل بعد التشغيل
# ------------------------------------------------------------------
ALPHA = 1.0            # Laplace smoothing
N_MIN = 200            # عتبة الدمج في التدريب
LOG_EDGES = [30, 44, 62, 88, 124, 176, 248, 350, 500]  # فوق 30
BLOCK = 100            # طول كتلة Bootstrap
B_BOOT = 2000          # عدد إعادات Bootstrap
SEED = 20261120

# ------------------------------------------------------------------
# الفئات الثلاث — حدودها تُمرَّر من سطر الأوامر، لا تُضمَّن هنا.
# ------------------------------------------------------------------
CLASS_EDGES = None     # (a, b): Small: g<=a, Medium: a<g<=b, Large: g>b
CLASS_NAMES = ["Small", "Medium", "Large"]

def set_class_edges(a, b):
    global CLASS_EDGES
    if not (0 < a < b):
        raise ValueError("يجب أن تكون حدود الفئات 0 < a < b")
    CLASS_EDGES = (int(a), int(b))

def size_class(g):
    if CLASS_EDGES is None:
        raise RuntimeError("حدود الفئات غير مثبّتة — مرّرها بـ --classes a,b كما في M1 التاريخي")
    a, b = CLASS_EDGES
    if g <= a:
        return 0
    if g <= b:
        return 1
    return 2

# ------------------------------------------------------------------
# الغربال التجريبي (وضع --demo فقط)
# ------------------------------------------------------------------
def sieve_gaps(limit):
    """فجوات الأوليات حتى limit — غربال إراتوستينس. للتجربة فقط."""
    sieve = bytearray(b"\x01") * (limit + 1)
    sieve[0:2] = b"\x00\x00"
    for i in range(2, int(limit ** 0.5) + 1):
        if sieve[i]:
            sieve[i * i:limit + 1:i] = b"\x00" * ((limit - i * i) // i + 1)
    primes = [i for i, v in enumerate(sieve) if v]
    return [primes[i + 1] - primes[i] for i in range(len(primes) - 1)]

# ------------------------------------------------------------------
# التمثيل (Binning)
# ------------------------------------------------------------------
def bin_of(g):
    """تمثيل الفجوة: قيمة دقيقة حتى 30، ثم نطاق لوغاريتمي."""
    if g <= 30:
        return ("exact", int(g))
    for i, e in enumerate(LOG_EDGES[1:], start=1):
        if g <= e:
            return ("log", i)
    return ("log", len(LOG_EDGES))  # النطاق الأخير: (500, ∞)

def bin_label(b):
    kind, v = b
    if kind == "exact":
        return f"g={v}"
    if v == len(LOG_EDGES):
        return "g>500"
    return f"({LOG_EDGES[v-1]}, {LOG_EDGES[v]}]"

# ------------------------------------------------------------------
# الدمج (من التدريب فقط)
# ------------------------------------------------------------------
def resolve_bin(b, merge_map):
    """اتباع سلسلة الدمج حتى النطاق النهائي (ضغط المسار)."""
    while merge_map[b] != b:
        b = merge_map[b]
    return b

def build_merge_map(train_gaps):
    """
    تعيد خريطة دمج للنطاقات اللوغاريتمية فقط.
    القاعدة: نطاق دون 200 يُدمج مع الأعلى التالي.
    الاستثناء: النطاق الأخير لا يُدمج نزولًا أبدًا.
    وتُسجَّل للنطاق الأخير: عدده الخام، وعدده بعد الدمج، كلٌّ على حدة.
    """
    from collections import Counter
    counts = Counter(bin_of(g) for g in train_gaps if g > 30)
    log_bins = [("log", i) for i in range(1, len(LOG_EDGES) + 1)]
    merge_map = {b: b for b in log_bins}
    merges = []          # (من، إلى، عدد المشاهدات قبل الدمج)
    i = 0
    while i < len(log_bins) - 1:   # الأخير خارج حلقة الدمج
        b = log_bins[i]
        eff = sum(counts[x] for x in log_bins if resolve_bin(merge_map[x], merge_map) == b)
        if eff < N_MIN:
            nxt = log_bins[i + 1]
            merge_map[b] = resolve_bin(nxt, merge_map)
            merges.append((bin_label(b), bin_label(merge_map[b]), eff))
        i += 1
    from collections import Counter as C
    after = C()
    for g in train_gaps:
        if g > 30:
            after[resolve_bin(bin_of(g), merge_map)] += 1
    last = log_bins[-1]
    last_raw = int(counts.get(last, 0))          # الخام: مشاهدات النطاق الأخير وحده
    last_merged = int(after.get(last, 0))        # بعد الدمج: ما استقبله من النطاقات الدنيا
    last_ok = last_merged >= N_MIN
    return merge_map, merges, after, last_raw, last_merged, last_ok

def feature_of(g, merge_map):
    if g <= 30:
        return ("exact", int(g))
    return resolve_bin(bin_of(g), merge_map)

# ------------------------------------------------------------------
# النماذج
# ------------------------------------------------------------------
def fit_transitions(feats, targets):
    """عدّادات انتقال + Laplace alpha=1 -> مصفوفة احتمالات."""
    from collections import defaultdict, Counter
    cnt = defaultdict(Counter)
    for f, t in zip(feats, targets):
        cnt[f][t] += 1
    probs = {}
    for f, c in cnt.items():
        tot = sum(c.values()) + ALPHA * 3
        probs[f] = np.array([(c[k] + ALPHA) / tot for k in range(3)])
    return probs, cnt

def predict(probs, cnt, feats, fallback):
    """احتمالات الانتقال لكل مشاهدة؛ إن غاب التمثيل عن التدريب، استخدم التوزيع الهامشي."""
    out = []
    for f in feats:
        out.append(probs[f] if f in probs else fallback)
    return np.array(out)

# ------------------------------------------------------------------
# المقاييس
# ------------------------------------------------------------------
def logloss(probs_pred, targets):
    p = np.clip(probs_pred[np.arange(len(targets)), targets], 1e-12, 1.0)
    return float(-np.log(p).mean())

def accuracy(probs_pred, targets):
    return float((probs_pred.argmax(axis=1) == targets).mean())

def pearson_simulated(probs, cnt, feats_train, gaps_by_class, train_gaps,
                      n_steps=200000, seed=SEED + 1, is_m1=False, merge_map=None):
    """
    Pearson الذي يقتضيه النموذج: محاكاة سلسلة ماركوف من مصفوفة
    الانتقالات المدرّبة، ثم corr للفجوات المتتالية المحاكاة.
    لماذا المحاكاة لا التوقع؟ لأن corr(E[g_{i+1}|الميزة], g_{i+1})
    موجب بالبناء: التوقع والفجوة الفعلية كلاهما ينخفض مع g_i،
    فيرتبطان إيجابًا حتى لو كان النموذج صحيحًا. أما السلسلة المحاكاة
    فتعيد إنتاج corr(g_i, g_{i+1}) الذي يقتضيه النموذج، وهو ما يقارن
    مباشرة مع Pearson التاريخي (-0.03006 لـ M1، و-0.04273 الفعلي).
    خطوات المحاكاة: من تمثيل حالي، نعيّن فئة تالية من مصفوفة الانتقال،
    ثم نعيّن فجوة ممثلة من التوزيع التجريبي لتلك الفئة في التدريب،
    ثم ننتقل إلى تمثيل الفجوة المعيّنة. البذرة ثابتة.
    """
    rng = np.random.default_rng(seed)
    # التوزيع الهامشي للفئات كبديل للتمثيلات الغائبة
    from collections import Counter
    marg = Counter([size_class(g) for g in train_gaps[1:]])
    tot = sum(marg.values())
    fallback = np.array([(marg[k] + ALPHA) / (tot + ALPHA * 3) for k in range(3)])
    # حالة البدء: أول تمثيل في التدريب
    cur = feats_train[0]
    sim_gaps = np.empty(n_steps, dtype=float)
    for t in range(n_steps):
        p = probs.get(cur, fallback)
        nxt_class = int(rng.choice(3, p=p / p.sum()))
        pool = gaps_by_class.get(nxt_class)
        if pool is None or len(pool) == 0:
            pool = train_gaps
        g = float(rng.choice(pool))
        sim_gaps[t] = g
        if is_m1:
            cur = ("class", nxt_class)
        else:
            cur = feature_of(int(g), merge_map)
    if np.std(sim_gaps[:-1]) == 0 or np.std(sim_gaps[1:]) == 0:
        return 0.0
    return float(np.corrcoef(sim_gaps[:-1], sim_gaps[1:])[0, 1])

def block_bootstrap_gain(test_feats_m1, test_feats_m1e, test_targets,
                         probs_m1, probs_m1e, cnt_m1, cnt_m1e,
                         fallback_m1, fallback_m1e, rng):
    """
    كسب Log-Loss بالـ bits لكل انتقال + فاصل ثقة 95% بكتل متجاورة.
    نطاق الفاصل: عدم يقين إعادة أخذ عينات الاختبار مع تثبيت النماذج
    المدرّبة — لا عدم يقين إعادة التدريب.
    """
    n = len(test_targets)
    pred_m1 = predict(probs_m1, cnt_m1, test_feats_m1, fallback_m1)
    pred_m1e = predict(probs_m1e, cnt_m1e, test_feats_m1e, fallback_m1e)
    ll_m1 = -np.log(np.clip(pred_m1[np.arange(n), test_targets], 1e-12, 1.0))
    ll_m1e = -np.log(np.clip(pred_m1e[np.arange(n), test_targets], 1e-12, 1.0))
    per = (ll_m1 - ll_m1e) / math.log(2)   # bits لكل انتقال
    point = float(per.mean())
    nblocks = math.ceil(n / BLOCK)
    gains = []
    for _ in range(B_BOOT):
        idx = []
        for _ in range(nblocks):
            s = rng.integers(0, max(1, n - BLOCK + 1))
            idx.extend(range(int(s), min(n, int(s) + BLOCK)))
        idx = np.array(idx[:n])
        gains.append(float(per[idx].mean()))
    lo, hi = np.percentile(gains, [2.5, 97.5])
    return point, float(lo), float(hi)

# ------------------------------------------------------------------
# تحميل الفجوات + سلامة البيانات الصارمة
# ------------------------------------------------------------------
def load_gaps(path):
    """
    تقبل CSV (عمود فجوات) أو JSON (قائمة أرقام أو dict فيه قائمة فجوات).
    تتجاهل سطورًا غير رقمية في CSV (ترويسة/تعليق)، لكنها لا تحذف
    أي قيمة فجوة غير صالحة بصمت — بل توقف التشغيل بمواضعها.
    """
    if path == "--demo":
        print("وضع تجريبي: توليد فجوات الأوليات حتى 300,000 بغربال إراتوستينس...")
        gaps = sieve_gaps(300000)
        print(f"وُلدت {len(gaps)} فجوة. هذا وضع تجريبي فقط، وليس الاختبار الفعلي.")
        return gaps
    if not os.path.exists(path):
        print("=" * 64)
        print("لم يُعثر على ملف الفجوات:", path)
        print("ضع ملف gaps.csv (عمود واحد من الفجوات بالترتيب) بجانب السكربت،")
        print("أو مرّر المسار:  python3 m1e_tomorrow.py /path/to/gaps.csv --classes a,b")
        print("أو جرّب وضع التجربة:  python3 m1e_tomorrow.py --demo --classes a,b")
        print("=" * 64)
        return None
    with open(path, encoding="utf-8") as f:
        text = f.read().strip()
    gaps = []
    if text.startswith("{") or text.startswith("["):
        try:
            data = json.loads(text)
        except Exception:
            data = None
        if isinstance(data, list) and all(isinstance(x, (int, float)) for x in data):
            gaps = [float(x) for x in data]
        elif isinstance(data, dict):
            cand = None
            for key in ("gaps", "gap", "data", "prime_gaps"):
                if key in data and isinstance(data[key], list):
                    cand = data[key]
                    break
            if cand is None:
                for v in data.values():
                    if isinstance(v, list) and v and all(isinstance(x, (int, float)) for x in v):
                        cand = v
                        break
            if cand is not None:
                gaps = [float(x) for x in cand]
            else:
                print("=" * 64)
                print("هذا الملف ليس ملف فجوات:", path)
                print("يبدو أنه ملف تقرير أو إعدادات (JSON) لا يحمل قائمة فجوات.")
                print("هل مررت m1e_report.json بالخطأ؟")
                print("شغّل:  python3 m1e_tomorrow.py gaps.csv --classes a,b")
                print("=" * 64)
                return None
        else:
            print("لم أستطع قراءة الفجوات من ملف JSON:", path)
            return None
    else:
        for line in text.splitlines():
            line = line.strip()
            if not line:
                continue
            tok = line.split(",")[0].strip().strip('"').strip("'")
            try:
                gaps.append(float(tok))
            except ValueError:
                continue  # ترويسة/تعليق/سطر غير رقمي — ليس قيمة فجوة
    if len(gaps) < 100:
        print("=" * 64)
        print(f"الملف {path} لا يبدو ملف فجوات: قُرئت {len(gaps)} قيمة فقط.")
        print("تأكد أنك تمرر gaps.csv — عمود واحد من الفجوات بالترتيب.")
        print("تحقق بـ:  head -c 500 gaps.csv")
        print("=" * 64)
        return None
    return gaps

def validate_gaps(gaps):
    """
    سلامة صارمة: كل فجوة عدد صحيح >= 1؛ والفجوة 1 مسموح بها
    في الموضع صفر فقط (بين 2 و3)، وكل فجوة أخرى زوجية.
    أي قيمة مخالفة توقف التشغيل مع مواضعها الأولى — لا حذف صامت،
    لأن حذف فجوة من منتصف السلسلة يغيّر الانتقالات التالية.
    """
    bad = []
    for i, g in enumerate(gaps):
        if not isinstance(g, (int, float)) or math.isnan(g) or math.isinf(g):
            bad.append((i, g, "ليست عددًا"))
        elif float(g) != int(g):
            bad.append((i, g, "ليست عددًا صحيحًا"))
        elif int(g) < 1:
            bad.append((i, g, "أقل من 1"))
        elif int(g) == 1 and i != 0:
            # الفجوة 1 موجودة مرة واحدة فقط: بين 2 و3، أي في الموضع صفر.
            bad.append((i, g, "فجوة 1 في غير موضعها — توجد مرة واحدة بين 2 و3"))
        elif int(g) > 1 and int(g) % 2 != 0:
            bad.append((i, g, "فردية — فجوات الأوليات بعد 3 زوجية"))
        if len(bad) >= 10:
            break
    if bad:
        print("=" * 64)
        print("بيانات غير صالحة: توقف التشغيل — لا حذف صامت للفجوات.")
        for i, g, why in bad:
            print(f"  الموضع {i}: القيمة {g} — {why}")
        print("أصلح الملف ثم أعد التشغيل. لم تُحذف أي قيمة.")
        print("=" * 64)
        return None
    return np.array([int(g) for g in gaps], dtype=int)

# ------------------------------------------------------------------
# التشغيل
# ------------------------------------------------------------------
def main(path, class_edges):
    rng = np.random.default_rng(SEED)
    set_class_edges(*class_edges)
    raw = load_gaps(path)
    if raw is None:
        return
    gaps = validate_gaps(raw)
    if gaps is None:
        return
    n = len(gaps)
    half = n // 2
    train, test = gaps[:half], gaps[half:]

    def transitions(arr):
        feats_raw = arr[:-1]
        targets = np.array([size_class(g) for g in arr[1:]])
        return feats_raw, targets

    tr_feats_raw, tr_targets = transitions(train)
    te_feats_raw, te_targets = transitions(test)

    # خريطة الدمج من التدريب فقط
    merge_map, merges, after, last_raw, last_merged, last_ok = build_merge_map(tr_feats_raw)
    tr_feats = [feature_of(g, merge_map) for g in tr_feats_raw]
    te_feats = [feature_of(g, merge_map) for g in te_feats_raw]

    # M1: الميزة = فئة g_i — M1-E: الميزة = التمثيل الدقيق/اللوغاريتمي
    m1_tr = [("class", size_class(g)) for g in tr_feats_raw]
    m1_te = [("class", size_class(g)) for g in te_feats_raw]
    probs_m1, cnt_m1 = fit_transitions(m1_tr, tr_targets)
    probs_m1e, cnt_m1e = fit_transitions(tr_feats, tr_targets)

    # التوزيع الهامشي كبديل للتمثيلات الغائبة
    from collections import Counter
    marg = Counter(tr_targets.tolist())
    tot = sum(marg.values())
    fallback = np.array([(marg[k] + ALPHA) / (tot + ALPHA * 3) for k in range(3)])

    pred_m1 = predict(probs_m1, cnt_m1, m1_te, fallback)
    pred_m1e = predict(probs_m1e, cnt_m1e, te_feats, fallback)

    # Pearson الذي يقتضيه كل نموذج: محاكاة سلسلة ماركوف من انتقالاته.
    # مرجع: Pearson الفعلي للاختبار corr(g_i, g_{i+1}).
    from collections import defaultdict
    gaps_by_class = defaultdict(list)
    for g in train[1:]:
        gaps_by_class[size_class(int(g))].append(int(g))
    gaps_by_class = {k: np.array(v) for k, v in gaps_by_class.items()}
    rho_m1 = pearson_simulated(probs_m1, cnt_m1, m1_tr, gaps_by_class, train,
                                is_m1=True)
    rho_m1e = pearson_simulated(probs_m1e, cnt_m1e, tr_feats, gaps_by_class, train,
                                 is_m1=False, merge_map=merge_map)
    rho_actual = float(np.corrcoef(test[:-1].astype(float), test[1:].astype(float))[0, 1])

    ll_m1 = logloss(pred_m1, te_targets)
    ll_m1e = logloss(pred_m1e, te_targets)
    acc_m1 = accuracy(pred_m1, te_targets)
    acc_m1e = accuracy(pred_m1e, te_targets)
    g_bits, g_lo, g_hi = block_bootstrap_gain(
        m1_te, te_feats, te_targets,
        probs_m1, probs_m1e, cnt_m1, cnt_m1e, fallback, fallback, rng)

    if g_lo > 0 and g_bits >= 0.005:
        verdict_ll = "تحسن واضح"
    elif g_lo > 0:
        verdict_ll = "تحسن محدود"
    else:
        verdict_ll = "غير معتبر"

    # تقرير
    from collections import Counter
    before = Counter(bin_of(g) for g in tr_feats_raw if g > 30)
    a_edge, b_edge = class_edges
    print("=" * 64)
    print("M1-E — تقرير الغد (البروتوكول مثبّت مسبقًا)")
    print("=" * 64)
    print(f"حدود الفئات (M1 التاريخي كما مُرّرت): Small g<={a_edge} | Medium g<={b_edge} | Large g>{b_edge}")
    print(f"إجمالي الفجوات: {n} | تدريب: {half} | اختبار: {n - half}")
    print(f"انتقالات الاختبار: {len(te_targets)}")
    print()
    print("--- النطاقات فوق 30: قبل الدمج وبعده (تدريب) ---")
    for b in sorted(before, key=lambda x: x[1]):
        print(f"  {bin_label(b):>12}: قبل={before[b]:>8}  بعد={after.get(b, 0):>8}")
    print(f"عدد عمليات الدمج: {len(merges)}")
    for a, b_, c in merges:
        print(f"  دمج {a} -> {b_} (مشاهدات: {c})")
    print(f"النطاق الأخير (g>500): خام={last_raw} | بعد الدمج={last_merged} | "
          f"كفاية التقدير: {'متحققة' if last_ok else 'لم تتحقق — يُسجَّل ولا يُدمج نزولًا'}")
    print()
    print("--- الأداء على الاختبار نفسه ---")
    print(f"{'المقياس':>28} | {'M1':>12} | {'M1-E':>12}")
    print(f"{'Accuracy':>28} | {acc_m1:>12.4f} | {acc_m1e:>12.4f}")
    print(f"{'Log-Loss':>28} | {ll_m1:>12.4f} | {ll_m1e:>12.4f}")
    print(f"{'Pearson (مستوى الفجوة)':>28} | {rho_m1:>12.5f} | {rho_m1e:>12.5f}")
    print(f"{'Pearson الفعلي للاختبار':>28} | {rho_actual:>12.5f} | {rho_actual:>12.5f}")
    print()
    print(f"Predictive Gain: {g_bits:.5f} bits/انتقال  |  95% CI: [{g_lo:.5f}, {g_hi:.5f}]")
    print("نطاق فاصل Bootstrap: عدم يقين إعادة أخذ عينات الاختبار مع تثبيت النماذج —")
    print("لا يقيس عدم يقين إعادة التدريب.")
    print(f"الحكم (Log-Loss فقط): {verdict_ll}")
    print(f"Pearson: تغير من {rho_m1:.5f} إلى {rho_m1e:.5f} — يُقرأ منفصلًا، ولا يُخلط بالحكم أعلاه.")
    print()
    print("الخلاصة المثبّتة سلفًا:")
    print("  عدم التحسن لا يثبت غياب المعلومات؛ بل يحدّد ما لم ينجح هذا التمثيل في استخراجه.")
    print("=" * 64)

    report = {
        "class_edges": [int(a_edge), int(b_edge)],
        "n_gaps": int(n), "n_train": int(half), "n_test": int(n - half),
        "n_test_transitions": int(len(te_targets)),
        "bins_before": {bin_label(b): int(c) for b, c in before.items()},
        "bins_after": {bin_label(b): int(c) for b, c in after.items()},
        "n_merges": len(merges),
        "merges": [{"from": a, "to": b_, "count": int(c)} for a, b_, c in merges],
        "last_bin_raw": int(last_raw), "last_bin_merged": int(last_merged),
        "last_bin_sufficient": bool(last_ok),
        "alpha": ALPHA, "n_min": N_MIN, "block": BLOCK, "B_boot": B_BOOT,
        "M1": {"accuracy": acc_m1, "logloss": ll_m1, "pearson_gap_level": rho_m1},
        "M1-E": {"accuracy": acc_m1e, "logloss": ll_m1e, "pearson_gap_level": rho_m1e},
        "pearson_actual_test": rho_actual,
        "predictive_gain_bits": g_bits, "gain_ci_95": [g_lo, g_hi],
        "bootstrap_scope": "test-resampling only; models fixed (not retraining uncertainty)",
        "verdict_logloss": verdict_ll,
    }
    with open("m1e_report.json", "w", encoding="utf-8") as f:
        json.dump(report, f, ensure_ascii=False, indent=2)
    print("حُفظ التقرير في m1e_report.json")

# ------------------------------------------------------------------
# تحليل وسائط التشغيل: تجاهل أعلام Jupyter وقيمها معًا.
# Jupyter يمرّر: -f /path/to/kernel-XXXX.json
# ------------------------------------------------------------------
def parse_argv(argv):
    raw = list(argv)
    args, classes, demo = [], None, False
    i = 0
    while i < len(raw):
        a = raw[i]
        if a == "-f":
            i += 2  # تخطَّ العلم وقيمته معًا
            continue
        if a == "--demo":
            demo = True
            i += 1
            continue
        if a == "--classes" and i + 1 < len(raw):
            classes = raw[i + 1]
            i += 2
            continue
        if a.startswith("--classes="):
            classes = a.split("=", 1)[1]
            i += 1
            continue
        if a.startswith("-"):
            i += 1
            continue
        args.append(a)
        i += 1
    return args, classes, demo

if __name__ == "__main__":
    pos, classes_raw, demo = parse_argv(sys.argv[1:])
    if classes_raw is None:
        print("=" * 64)
        print("حدود الفئات الثلاث غير مثبّتة.")
        print("مرّرها كما في تعريف M1 التاريخي حرفيًا:")
        print("  python3 m1e_tomorrow.py gaps.csv --classes a,b")
        print("الحدود التاريخية: 6، 14 (صغيرة ≤ 6، متوسطة 8–14، كبيرة ≥ 16):")
        print("  python3 m1e_tomorrow.py gaps.csv --classes 6,14")
        print("لا تُستخدم حدود افتراضية — تعريف الهدف لا يتغير بين M1 وM1-E.")
        print("=" * 64)
        sys.exit(1)
    try:
        a_s, b_s = classes_raw.split(",")
        class_edges = (int(a_s), int(b_s))
        assert 0 < class_edges[0] < class_edges[1]
    except Exception:
        print("صيغة --classes غير صالحة. استخدم: --classes 6,14")
        sys.exit(1)
    if class_edges == (10, 30):
        print("=" * 64)
        print("الحدود 10، 30 مرفوضة — كانت افتراضًا من الكاتب، لا تعريف M1.")
        print("الحدود التاريخية: 6، 14 (صغيرة ≤ 6، متوسطة 8–14، كبيرة ≥ 16).")
        print("شغّل:  python3 m1e_tomorrow.py gaps.csv --classes 6,14")
        print("=" * 64)
        sys.exit(1)
    path = "--demo" if demo else None
    if path is None:
        if pos:
            if "kernel-" in pos[0] and pos[0].endswith(".json"):
                print("=" * 64)
                print("يبدو أنك تشغّل السكربت من خلية Jupyter دون تمرير ملف الفجوات،")
                print("فمرّر Jupyter ملف النواة kernel-....json كوسيط.")
                print("شغّل من خلية بهذا الشكل:")
                print("    !python3 m1e_tomorrow.py gaps.csv --classes a,b")
                print("أو من التيرمينال:")
                print("    python3 m1e_tomorrow.py gaps.csv --classes a,b")
                print("=" * 64)
                sys.exit(1)
            path = pos[0]
        elif os.path.exists("gaps.csv"):
            path = "gaps.csv"
        else:
            print("الاستخدام: python3 m1e_tomorrow.py gaps.csv --classes a,b")
            print("أو للتجربة: python3 m1e_tomorrow.py --demo --classes a,b")
            sys.exit(1)
    main(path, class_edges)
