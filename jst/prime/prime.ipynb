import math
import numpy as np

# --------------------------------------------------
# 1. توليد الأعداد الأولية - غربال إراتوستينس
# العدد الأولي رقم 1,000,000 هو 15,485,863
# لذلك نغربل حتى 16,000,000
# --------------------------------------------------
def get_primes(limit: int):
    sieve = np.ones(limit + 1, dtype=bool)
    sieve[:2] = False
    for i in range(2, int(limit**0.5) + 1):
        if sieve[i]:
            sieve[i*i : limit+1 : i] = False
    return np.nonzero(sieve)[0]

primes = get_primes(16_000_000)
print(f"Total primes: {len(primes):,} | 1,000,000th = {primes[999999]}")

# --------------------------------------------------
# 2. تعريف معامل الارتباط - موثق
# rho_k = sum((g_i - mean)*(g_{i+k} - mean)) / sum((g_i - mean)^2)
# البسط يستخدم N-k-1 حد، والمقام كل الفجوات
# --------------------------------------------------
def rho(gaps: np.ndarray, lag: int = 1) -> float:
    m = gaps.mean()
    return float(
        np.sum((gaps[:-lag] - m) * (gaps[lag:] - m)) / np.sum((gaps - m) ** 2)
    )

def rho_pearson(gaps: np.ndarray, lag: int = 1) -> float:
    # التعريف البديل: Pearson على الزوجين المتداخلين
    # الفرق عن التعريف الأول < 1e-5
    return float(np.corrcoef(gaps[:-lag], gaps[lag:])[0, 1])

# --------------------------------------------------
# 3. كمية R المرشحة
# R = mean( min(g_i, g_{i+1}) / max(g_i, g_{i+1}) )
# --------------------------------------------------
def R_stat(gaps: np.ndarray) -> float:
    a = gaps[:-1]
    b = gaps[1:]
    return float(np.mean(np.minimum(a, b) / np.maximum(a, b)))

# --------------------------------------------------
# 4. الاختبار الرئيسي: N = 1k, 10k, 100k, 500k, 1M
# --------------------------------------------------
milestones = [1_000, 10_000, 100_000, 500_000, 1_000_000]
rng = np.random.default_rng(42)

print("\n--- Real primes vs Shuffle ---")
for m in milestones:
    p_sub = primes[:m+1]          # m+1 prime -> m gaps
    gaps = np.diff(p_sub).astype(float)

    r_raw = rho(gaps, 1)
    r_raw_pearson = rho_pearson(gaps, 1)
    r2 = rho(gaps, 2)

    # الفجوات المعيارية: g_n / ln(p_n)
    norm_gaps = gaps / np.log(p_sub[:-1])
    r_norm = rho_pearson(norm_gaps, 1)

    # الخلط العشوائي: 100 تبديل
    shuffled = []
    for _ in range(100):
        sh = rng.permutation(gaps)
        shuffled.append(rho_pearson(sh, 1))
    sh_mean = float(np.mean(shuffled))
    sh_std = float(np.std(shuffled))

    print(
        f"N={m:>9,} | X~{p_sub[-1]:>9,} | mean={gaps.mean():.4f} | "
        f"var={gaps.var():.2f} | rho1={r_raw:+.6f} | rho1_pearson={r_raw_pearson:+.6f} | "
        f"rho2={r2:+.6f} | R={R_stat(gaps):.4f} | "
        f"r_norm={r_norm:+.6f} | shuffled={sh_mean:+.6f} +- {sh_std:.6f} | "
        f"1/lnX={1/math.log(p_sub[-1]):.4f}"
    )

# --------------------------------------------------
# 5. الغربال الدوري Primorial Sieve
# M_k = 2*3*5*... , الفجوات الدورية بين البواقي الأولية مع M_k
# --------------------------------------------------
print("\n--- Primorial Sieve ---")
for k in range(2, 8):
    p_list = primes[:k]
    M = math.prod(p_list.tolist())
    coprimes = [x for x in range(1, M + 1) if math.gcd(x, M) == 1]
    # فجوات دورية: نغلق الدورة بإضافة coprime الأول + M
    cyc_gaps = np.diff(coprimes + [coprimes[0] + M]).astype(float)
    r_sieve = float(np.corrcoef(cyc_gaps, np.roll(cyc_gaps, -1))[0, 1])
    print(
        f"k={k} | M={M:>7,} | phi={len(coprimes):>4,} | "
        f"mean={cyc_gaps.mean():.4f} | var={cyc_gaps.var():.4f} | r_sieve={r_sieve:+.6f}"
    )

# حالة M=30 بالتفصيل - للتحقق من -17/16 و -17/39
cycle_30 = np.array([6, 4, 2, 4, 2, 4, 6, 2], dtype=float)
E = cycle_30.mean()
var_30 = float(np.var(cycle_30))
cov_30 = float(np.mean((cycle_30 - E) * (np.roll(cycle_30, -1) - E)))
print(f"\nM=30 check: E={E} Var={var_30} Cov={cov_30} rho={cov_30/var_30:.6f}")
print(f"Expected: Var=39/16=2.4375 Cov=-17/16=-1.0625 rho=-17/39=-0.435897")
print(f"Claim -85/64 = {-85/64} -> REJECTED, does not appear")

# --------------------------------------------------
# 6. النموذج المخفف Thinned M=30
# كل عدد أولي مع 30 يبقى باحتمال q
# الفجوة = مجموع K فجوات دورية، K ~ Geometric(q)
# --------------------------------------------------
print("\n--- Thinned M=30 model ---")
for q in [0.27, 0.30]:
    rng2 = np.random.default_rng(0)
    cyc = np.tile(cycle_30, 200000)
    ks = rng2.geometric(q, size=100000)
    cs = np.concatenate([[0], np.cumsum(cyc)])
    idx = np.cumsum(np.concatenate([[0], ks[:-1]]))
    sim = np.array([cs[i+k] - cs[i] for i, k in zip(idx[:99999], ks[:99999])], dtype=float)
    print(f"q={q} | mean={sim.mean():.3f} | rho1={rho(sim,1):+.5f} | R={R_stat(sim):.5f}")

# --------------------------------------------------
# 7. الارتباط الشرطي: توزيع g_{n+1} بشرط g_n
# هذا يفصل أثر القسمة المباشر
# --------------------------------------------------
print("\n--- Conditional: E[g_{n+1} | g_n] ---")
p_sub = primes[:100001]
gaps = np.diff(p_sub)
for cond in [2, 4, 6, 8, 10, 12, 14]:
    mask = gaps[:-1] == cond
    if mask.sum() > 0:
        nxt = gaps[1:][mask]
        print(
            f"g_n={cond:>2} | count={mask.sum():>6,} | "
            f"E[g_next]={nxt.mean():.3f} | P(g_next=2)={np.mean(nxt==2):.3f} | "
            f"P(g_next=6)={np.mean(nxt==6):.3f}"
        )

# --------------------------------------------------
# 8. اختبار التبديل الكامل للتحقق
# --------------------------------------------------
print("\n--- Permutation test on first 10,000 primes ---")
gaps10k = np.diff(primes[:10001]).astype(float)
print(f"Real rho1(10k) = {rho(gaps10k,1):.6f}  <- should be -0.070670")
print(f"Real R(10k) = {R_stat(gaps10k):.6f}")



