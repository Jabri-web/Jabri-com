    # === دالة Zx الأم ===
    def Zx_Core(n=0, t=13.799):
        H0_zx = 69.8
        t_now = 13.799
        C = 1.0 - np.exp(-H0_zx * t / 100 / t_now)
        A = 1.0 - C
        if n > 0:
            Z = 2*np.pi*n + np.log(n) + C
        else:
            Z = C
        Z_t = Z + C + A
        return {'Z': Z, 'C': C, 'A': A, 'Z_t': Z_t, 'H0': H0_zx}

