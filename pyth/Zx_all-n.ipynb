def make_download_button(filepath, label=None):
    try:
        if not os.path.exists(filepath):
            p(f"⚠️ ملف غير موجود: {filepath}")
            return
        with open(filepath, 'rb') as f: b64 = base64.b64encode(f.read()).decode()
        filename = os.path.basename(filepath)
        name = label if label else filename
        button = f'''<a download="{filename}" href="data:application/octet-stream;base64,{b64}"
           style="background:#4CAF50;color:white;padding:12px 24px;text-decoration:none;
                  border-radius:8px;font-weight:bold;display:inline-block;margin:8px;
                  font-size:16px;box-shadow:0 4px 8px rgba(0,0,0,0.2);">
           📱 تحميل {name}</a>'''
        display(HTML(button))
    except Exception as e:
        p(f"⚠️ خطأ في زر التحميل: {e}")

